{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LevelBlueprintPreValidator",
  "type": "object",
  "required": ["levelName", "actNumber", "echoConfig", "modules"],
  "properties": {
    "levelName": { "type": "string", "pattern": "^Level_[0-9]{2}$" },
    "actNumber": { "type": "integer", "minimum": 1, "maximum": 5 },
    "echoConfig": {
      "type": "object",
      "required": ["maxEchoes", "maxRecordSeconds"],
      "properties": {
        "maxEchoes": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxRecordSeconds": { "type": "number", "minimum": 1.0, "maximum": 20.0 }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "transform"],
        "properties": {
          "transform": {
            "type": "object",
            "required": ["position", "rotation"],
            "properties": {
              "position": {
                "type": "object",
                "required": ["x", "y", "z"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "z": { "type": "number" }
                }
              },
              "rotation": {
                "type": "object",
                "required": ["x", "y", "z"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "z": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  }
}
