{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echoes-of-you/validator-report.schema.json",
  "title": "Echoes of You validator report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "generated_at", "subject", "status", "summary", "checks"],
  "properties": {
    "report_id": {"type": "string", "pattern": "^RPT-[A-Z0-9-]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "string"},
    "validator_version": {"type": "string"},
    "status": {"enum": ["approved", "rejected", "blocked", "needs_review", "not_run"]},
    "summary": {
      "type": "object",
      "required": ["fatal", "errors", "warnings", "passed"],
      "properties": {
        "fatal": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "status", "severity", "message"],
        "properties": {
          "rule_id": {"type": "string"},
          "status": {"enum": ["passed", "failed", "skipped", "not_applicable"]},
          "severity": {"enum": ["fatal", "error", "warning", "advisory"]},
          "message": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "remediation": {"type": "string"}
        }
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string"}}
  }
}
