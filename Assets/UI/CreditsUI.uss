/* ============================================================
   CreditsUI — Rediseño Stitch (sólido, nítido, legible)
   Layout en columna: cabecera / scroll / pie con el botón volver.
   Fondo opaco: los créditos nunca dejan ver otra escena detrás.
   ============================================================ */

@import "EchoesDesignTokens.uss";

/* ===== RAIZ ===== */
.credits-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #202920;
    flex-direction: column;
    overflow: hidden;
}

/* ===== CABECERA FIJA ===== */
.credits-page { flex-grow: 1; min-height: 0; }

.credits-header {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    min-height: 88px;
    padding: 16px 48px;
    background-color: #202920;
    border-bottom-width: 2px;
    border-bottom-color: #ebcb90;
}

.credits-header-title {
    font-size: 34px;
    color: #ebcb90;
    letter-spacing: 3px;
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 1;
}

.credits-header-subtitle {
    font-size: 15px;
    color: #ccc6bc;
    letter-spacing: 1px;
    margin-left: 24px;
    white-space: normal;
    flex-shrink: 1;
    opacity: 1;
}

/* ===== ZONA DE SCROLL ===== */
.credits-container {
    flex-grow: 1;
    min-height: 0;
    align-items: center;
    background-color: #202920;
}

.credits-scroll {
    width: 88%;
    max-width: 920px;
    min-height: 0;
    flex-grow: 1;
    padding: 40px 0 0 0;
    background-color: transparent;
}

/* ===== SECCIONES (tarjetas) ===== */
.credits-section {
    background-color: #303c32;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #ebcb90;
    padding: 24px 28px;
    margin-bottom: 18px;
    align-items: flex-start;
    flex-shrink: 0;
}

.credits-section--title {
    background-color: #303c32;
    border-left-color: #fffeff;
    border-left-width: 6px;
    padding: 36px 32px;
    margin-bottom: 28px;
    align-items: center;
}

.credits-section--close {
    background-color: #303c32;
    border-left-color: #ebcb90;
    border-left-width: 6px;
    padding: 36px 32px;
    margin-bottom: 28px;
    align-items: center;
}

/* ===== TITULO PRINCIPAL ===== */
.credits-title-main {
    font-size: 50px;
    color: #ebcb90;
    -unity-text-align: middle-center;
    letter-spacing: 5px;
    margin-bottom: 14px;
    white-space: normal;
    opacity: 1;
}

.credits-subtitle {
    font-size: 21px;
    color: #e4e2dc;
    -unity-text-align: middle-center;
    margin-top: 6px;
    letter-spacing: 1px;
    white-space: normal;
    opacity: 1;
}

/* ===== SEPARADOR ===== */
.credits-separator {
    height: 2px;
    width: 240px;
    max-width: 80%;
    background-color: #ebcb90;
    margin: 14px 0;
    flex-shrink: 0;
}

/* ===== HEADING DE SECCION ===== */
.credits-heading {
    font-size: 17px;
    color: #ebcb90;
    letter-spacing: 3px;
    margin-bottom: 14px;
    white-space: normal;
    opacity: 1;
}

.credits-heading--close {
    font-size: 30px;
    color: #ebcb90;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    letter-spacing: 2px;
}

/* ===== NOMBRES ===== */
.credits-name {
    font-size: 18px;
    color: #e4e2dc;
    letter-spacing: 1px;
    margin-bottom: 6px;
    white-space: normal;
    opacity: 1;
}

/* ===== TEXTO BODY ===== */
.credits-text {
    font-size: 15px;
    color: #ccc6bc;
    margin-bottom: 10px;
    letter-spacing: 1px;
    white-space: normal;
    opacity: 1;
}

/* ===== PIE CON BOTON VOLVER ===== */
.credits-footer {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 16px 24px 20px 24px;
    background-color: #202920;
    border-top-width: 1px;
    border-top-color: #4a463f;
}

.credit-back-btn {
    min-width: 180px;
    max-width: 90%;
    font-size: 17px;
    color: #e4e2dc;
    background-color: #303c32;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #ebcb90;
    padding: 14px 32px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: normal;
    opacity: 1;
    transition-property: color, border-color, background-color, scale;
    transition-duration: 150ms;
    transition-timing-function: linear;
}

.credit-back-btn:hover {
    color: #fffeff;
    background-color: #2a2a26;
    border-color: #ebcb90;
    scale: 1.02 1.02;
}

.credit-back-btn:active {
    color: #ebcb90;
    border-color: #ebcb90;
    scale: 0.98 0.98;
}

/* ===== RESPIRO FINAL DEL SCROLL ===== */
.credits-end-padding {
    height: 32px;
    flex-shrink: 0;
}

/* ===== EPILOGO ===== */
.epilogue-panel {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: #202920;
    flex-direction: column;
    align-items: center;
    padding: 40px 8% 28px 8%;
}

.epilogue-tag {
    font-size: 15px;
    color: #ebcb90;
    letter-spacing: 4px;
    margin-bottom: 24px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
    opacity: 1;
}

.epilogue-voice {
    font-size: 40px;
    color: #fffeff;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 20px;
    white-space: normal;
    flex-shrink: 0;
    opacity: 1;
}

.epilogue-narration {
    font-size: 21px;
    color: #ccc6bc;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 24px;
    white-space: normal;
    opacity: 1;
}

.epilogue-continue {
    min-width: 180px;
    max-width: 90%;
    font-size: 17px;
    color: #e4e2dc;
    background-color: #303c32;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #ebcb90;
    padding: 14px 32px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 20px;
    flex-shrink: 0;
    opacity: 1;
    transition-property: color, border-color, background-color, scale;
    transition-duration: 150ms;
    transition-timing-function: linear;
}

.epilogue-continue:hover {
    color: #fffeff;
    background-color: #2a2a26;
    border-color: #ebcb90;
    scale: 1.02 1.02;
}

.epilogue-continue:active {
    color: #ebcb90;
    border-color: #ebcb90;
    scale: 0.98 0.98;
}

/* El epilogo largo necesita scroll: crece con el panel, nunca se desborda. */
.epilogue-scroll {
    width: 100%;
    max-width: 920px;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 8px;
}

/* Por que este final y no otro. En ambar, el color de "memoria" del juego,
   porque habla de lo que el jugador hizo, no de lo que Aiden siente. */
.epilogue-why {
    font-size: 18px;
    color: #ebcb90;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
    opacity: 1;
}

/* El cuerpo de la historia. Alineado a la izquierda: son varios parrafos y
   centrarlos los vuelve ilegibles. */
.epilogue-reflection {
    font-size: 19px;
    color: #ccc6bc;
    -unity-text-align: upper-left;
    -unity-paragraph-spacing: 16px;
    white-space: normal;
    margin-bottom: 28px;
    padding: 0 4%;
    opacity: 1;
}

.epilogue-closing {
    font-size: 25px;
    color: #fffeff;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 12px;
    opacity: 1;
}

.credit-back-btn:focus, .epilogue-continue:focus {
    border-color: #f6e6b8;
    background-color: #405242;
}

.credits-section .unity-label { max-width: 100%; }
