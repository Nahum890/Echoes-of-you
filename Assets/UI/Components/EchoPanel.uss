/* ============================================================
   EchoPanel — contenedor colapsable animado
   Estados: default / collapsed (animado)
   Solo tokens. RULE-UI-001/002.
   ============================================================ */

@import "../EchoesDesignTokens.uss";

.echo-panel {
    overflow: hidden;
    opacity: 1;
    padding: var(--space-md) var(--space-lg);
    border-width: 1px;
    border-color: var(--color-glass-border);
    background-color: var(--color-glass-bg);
    min-height: 0;
    transition-property: opacity, border-color, max-height;
    transition-duration: var(--duration-slow);
    transition-timing-function: linear;
    margin: var(--space-xs) 0;
    border-radius: 0;
}

/* HOVER / FOCUS en el panel mismo */
.echo-panel:hover {
    border-color: var(--color-stich-on-surface);
}

.echo-panel:focus {
    border-color: var(--color-stich-amber);
    border-width: 2px;
    transition-duration: var(--duration-hover-controller);
}

/* ── COLLAPSED ─────────────────────────────────────────────── */

.echo-panel--collapsed {
    opacity: 0;
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 0;
    overflow: hidden;
    transition-duration: var(--duration-fast);
}

/* Header */
.echo-panel__header {
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface);
    padding: var(--space-sm) 0;
    -unity-text-align: middle-left;
}

.echo-panel__header:hover {
    color: var(--color-stich-amber);
}
