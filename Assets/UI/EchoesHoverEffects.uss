/* ============================================================
   ECHOES OF YOU — SISTEMA DE HOVER ICÓNICO (FASE 6 CANÓN)
   PS2 / VHS / CRT / Memoria Analógica — SOLO 4 CAPAS
   
   CAPAS PERMITIDAS:
   1. BASE — .nav-item-v2
   2. HOVER/FOCUS — .nav-item-v2:hover, .nav-item-v2:focus
   3. ACTIVE — .nav-item-v2:active
   4. GHOST (1 SOLO) — .nav-item-ghost
   
   FOCUS PIP (controller) — .nav-item-focus-pip--visible
   
   ELIMINADOS COMPLETAMENTE:
   - .nav-item-chroma-r / .nav-item-chroma-b (aberración cromática)
   - .nav-item-noise (capa de ruido)
   - .nav-item-scanline (scanline)
   - .nav-item-echo (eco visual)
   - .nav-item-confirm-flash (flash confirmación)
   - .nav-item-ghost-a / .nav-item-ghost-b (2 ghosts → 1 solo)
   - .panel-tint-* (tints panel derecho)
   - .side-nav-gradient-* (gradientes)
   - .ui-particle / .ui-particle--* (partículas)
   - .right-panel-crt-blink (CRT blink)
   
   TIMING VARIABLES (desde EchoesDesignTokens.uss):
   --duration-hover-mouse: 150ms
   --duration-hover-controller: 200ms
   --duration-active: 80ms
   ============================================================ */

@import "EchoesDesignTokens.uss";

/* ============================================================
   WRAPPER — Contenedor relativo para posicionar ghost layer
   ============================================================ */

.nav-item-wrapper {
    position: relative;
    overflow: visible;
    margin-bottom: 8px;
}

/* ============================================================
   1. ESTADO BASE — .nav-item-v2
   ============================================================ */

.nav-item-v2 {
    /* Layout */
    position: relative;
    padding: 18px 24px;
    overflow: visible;

    /* Apariencia base */
    background-color: #1b1c18;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 5px;
    border-left-color: #E8B262;

    /* Tipografía */
    -unity-text-align: middle-left;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    color: #e4e2dc;

    /* Transform */
    transform-origin: left center;
    translate: 0px 0px;
    scale: 1.0 1.0;

    /* Transiciones base */
    transition-property: color, translate, scale, border-left-width, border-left-color, background-color, border-color;
    transition-duration: 150ms;
    transition-timing-function: linear;
    transition-delay: 0ms;
}

/* ============================================================
   2. ESTADO HOVER/FOCUS
   Mouse: 150ms | Controller: 200ms (variables CSS)
   ============================================================ */

.nav-item-v2:hover,
.nav-item-v2:focus {
    color: #fffeff;

    /* Movimiento: desliza 6px a la derecha */
    translate: 6px 0px;

    /* Escala con overshoot */
    scale: 1.035 1.035;

    /* Linea de profundidad izquierda */
    border-left-width: 5px;
    border-left-color: #fffeff;

    /* Fondo hover Stich */
    background-color: #2a2a26;
    border-color: #E8B262;
}

/* Focus pip (controller) — indicador ▸ a la izquierda */
.nav-item-focus-pip {
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 8px;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: rgba(255, 191, 0, 0.0);
    pointer-events: none;
    transition-property: color, translate;
    transition-duration: var(--duration-hover-controller), var(--duration-hover-controller);
    transition-timing-function: ease-out, ease-out;
}

.nav-item-focus-pip--visible {
    color: rgba(255, 191, 0, 0.85);
}

/* ============================================================
   3. ESTADO ACTIVE (PRESSED)
   Duración 80ms
   ============================================================ */

.nav-item-v2:active {
    scale: 0.97 0.97;
    translate: 2px 0px;
    color: #E8B262;
    background-color: #353530;
    border-left-color: #E8B262;
    border-left-width: 5px;
}

/* ============================================================
   4. ESTADO ACTIVO / SELECCIONADO (nav-item--active)
   ============================================================ */

.nav-item-v2.nav-item--active {
    color: #E8B262;
    border-left-width: 5px;
    border-left-color: #E8B262;
    background-color: #2a2a26;
    translate: 4px 0px;
    scale: 1.02 1.02;
}

/* ============================================================
   GHOST LAYER (1 SOLO) — offset 4px, opacity 0.12, delay 50ms
   Representa la señal que "llegó antes" — una memoria anterior
   ============================================================ */

.nav-item-ghost {
    position: absolute;
    left: -4px;
    top: 0px;
    right: -4px;
    bottom: 0px;

    /* Misma tipografía que el botón pero transparente en idle */
    -unity-text-align: middle-left;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    color: rgba(232, 178, 98, 0.0);
    padding: 18px 24px;

    /* No debe capturar eventos */
    pointer-events: none;

    /* Transición con delay para aparecer después del botón */
    transition-property: color, opacity;
    transition-duration: 180ms, 180ms;
    transition-timing-function: ease-out, ease-out;
    transition-delay: 50ms, 50ms;
}

/* Ghost activado por clase CSS aplicada via C# */
.nav-item-ghost--visible {
    color: rgba(59, 90, 110, 0.12);
}

/* ============================================================
   TIMING VARIABLES (definidas en EchoesDesignTokens.uss, replicadas aquí para reference)
   ============================================================ */

:root {
    --duration-hover-mouse: 150ms;
    --duration-hover-controller: 200ms;
    --duration-active: 80ms;
}