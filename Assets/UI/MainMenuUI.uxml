<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />
    <Style src="project://database/Assets/UI/EchoesHoverEffects.uss" />
    <Style src="project://database/Assets/UI/MainMenuUI.uss" />

    <ui:VisualElement name="root" class="root-fullscreen menu-stitch-root" style="width: 1920px; height: 1080px; position: absolute; left: 0; top: 0;">

        <!-- BACKGROUND IMAGE LAYER -->
        <ui:VisualElement name="menu-bg-image" class="menu-bg-image" />

        <!-- DARK OVERLAY GRADIENT -->
        <ui:VisualElement name="menu-bg-gradient" class="menu-bg-gradient" />

        <!-- SCANLINES OVERLAY -->
        <ui:VisualElement name="menu-scanlines" class="menu-scanlines" picking-mode="Ignore" />

        <!-- NOISE OVERLAY -->
        <ui:VisualElement name="menu-noise" class="menu-noise" picking-mode="Ignore" />

        <!-- VOID INTRO (hidden, only exists for controller compatibility) -->
        <ui:VisualElement name="void-intro" class="hidden" style="display: none;" />

        <!-- MAIN CONTENT -->
        <ui:VisualElement name="main-content" class="main-menu-content">

            <!-- LEFT SIDEBAR -->
            <ui:VisualElement name="side-nav" class="menu-sidebar">

                <!-- LOGO -->
                <ui:VisualElement class="menu-logo-area">
                    <ui:VisualElement name="menu-logo-img" class="menu-logo-image" />
                    <ui:Label text="Archivo de Memoria" class="menu-logo-subtitle" />
                </ui:VisualElement>

                <!-- NAVIGATION -->
                <ui:VisualElement class="menu-nav-list">

                    <!-- Continuar (active state with progress) -->
                    <ui:VisualElement class="nav-item-wrapper">
                        <ui:Button name="nav-newgame" text="Continuar" class="nav-item-v2 menu-nav-btn menu-nav-btn--continue" />
                        <ui:VisualElement name="nav-ghost-newgame" class="menu-nav-ghost" picking-mode="Ignore">
                            <ui:Label text="Continuar" class="menu-nav-ghost-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Progress info under Continuar -->
                    <ui:VisualElement class="menu-ctn-progress">
                        <ui:VisualElement class="menu-ctn-progress-row">
                            <ui:Label text="Último guardado:" class="menu-ctn-progress-label" />
                        </ui:VisualElement>
                        <ui:Label name="lbl-user-rank" text="Aula 204 | 04:12:15" class="menu-ctn-progress-value" />
                        <ui:Label name="lbl-user-integrity" text="Integridad: 12%" class="menu-ctn-progress-integrity" />
                    </ui:VisualElement>

                    <!-- Nuevo expediente -->
                    <ui:VisualElement class="nav-item-wrapper">
                        <ui:Button name="nav-levels" text="Nuevo expediente" class="menu-nav-btn nav-item-v2" />
                        <ui:VisualElement class="menu-nav-ghost" picking-mode="Ignore">
                            <ui:Label text="Nuevo expediente" class="menu-nav-ghost-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Selección de capítulos -->
                    <ui:VisualElement class="nav-item-wrapper">
                        <ui:Button name="nav-chapters" text="Selección de capítulos" class="menu-nav-btn nav-item-v2" />
                        <ui:VisualElement class="menu-nav-ghost" picking-mode="Ignore">
                            <ui:Label text="Selección de capítulos" class="menu-nav-ghost-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Ajustes -->
                    <ui:VisualElement class="nav-item-wrapper">
                        <ui:Button name="nav-settings" text="Ajustes" class="menu-nav-btn nav-item-v2" />
                        <ui:VisualElement class="menu-nav-ghost" picking-mode="Ignore">
                            <ui:Label text="Ajustes" class="menu-nav-ghost-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Créditos -->
                    <ui:VisualElement class="nav-item-wrapper">
                        <ui:Button name="nav-credits" text="Créditos" class="menu-nav-btn nav-item-v2" />
                        <ui:VisualElement class="menu-nav-ghost" picking-mode="Ignore">
                            <ui:Label text="Créditos" class="menu-nav-ghost-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Salir -->
                    <ui:VisualElement class="nav-item-wrapper" style="margin-top: 32px;">
                        <ui:Button name="nav-exit" text="Salir" class="menu-nav-btn menu-nav-btn--exit nav-item-v2" />
                        <ui:VisualElement class="menu-nav-ghost" picking-mode="Ignore">
                            <ui:Label text="Salir" class="menu-nav-ghost-text menu-nav-ghost-text--exit" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- FOOTER -->
                <ui:VisualElement class="menu-sidebar-footer">
                    <ui:Label text="SYS.VER 1.04_b" class="menu-footer-text" />
                    <ui:Label text="© 199X-202X SYSTEM CORRUPTION." class="menu-footer-text" />
                </ui:VisualElement>

            </ui:VisualElement>


            <!-- ==========================================
                 PANELS (hidden by default, shown on click)
                 ========================================== -->
            <ui:VisualElement name="right-content-container" class="menu-panels-container">

                <!-- Panel 1: Continuar / Expediente -->
                <ui:VisualElement name="panel-neural-archives" class="menu-panel">
                    <ui:Label text="Expediente de Ausencia" class="menu-panel-title" />
                    <ui:Label text="registro y telemetría residual del eco" class="menu-panel-subtitle" />
                    <ui:VisualElement class="menu-panel-separator" />

                    <ui:VisualElement style="flex-direction: row; flex-grow: 1; min-height: 0;">
                        <ui:VisualElement style="width: 55%; padding-right: 24px;">
                            <ui:Label text="Registro de Actividad" class="menu-section-label" />
                            <ui:VisualElement class="menu-terminal-box">
                                <ui:Label text="[OK] Receptor analógico sintonizado." class="menu-terminal-line" />
                                <ui:Label name="lbl-archive-log-1" text="[OK] Fragmentos escolares mapeados." class="menu-terminal-line" />
                                <ui:Label name="lbl-archive-log-2" text="[OK] Frecuencia de eco establecida (15 FPS)." class="menu-terminal-line" />
                                <ui:Label name="lbl-archive-log-3" text="Esperando entrada del observador..." class="menu-terminal-line" style="color: #E8B262;" />
                            </ui:VisualElement>

                            <ui:Label text="Datos Acumulados" class="menu-section-label" />
                            <ui:VisualElement class="menu-chips-row">
                                <ui:VisualElement class="menu-chip">
                                    <ui:Label text="Objetos" class="menu-chip-label" />
                                    <ui:Label name="lbl-archive-fragments" text="0/15" class="menu-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-chip">
                                    <ui:Label text="Ecos" class="menu-chip-label" />
                                    <ui:Label name="lbl-archive-echoes" text="0" class="menu-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-chip">
                                    <ui:Label text="Colapsos" class="menu-chip-label" />
                                    <ui:Label name="lbl-archive-deaths" text="0" class="menu-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-chip">
                                    <ui:Label text="Tiempo" class="menu-chip-label" />
                                    <ui:Label name="lbl-archive-time" text="00:00" class="menu-chip-value" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement style="width: 40%; margin-left: 5%; align-items: center;">
                            <ui:VisualElement class="menu-polaroid">
                                <ui:VisualElement class="menu-polaroid-photo" />
                                <ui:Label text="Entrada Principal (Vacío)" class="menu-polaroid-caption" />
                            </ui:VisualElement>

                            <ui:VisualElement class="menu-memory-meter">
                                <ui:Label text="RETENCIÓN DE MEMORIA" class="menu-meter-title" />
                                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                                    <ui:Label name="lbl-archive-stability-pct" text="0%" class="menu-meter-value" />
                                    <ui:VisualElement class="menu-meter-bar-bg">
                                        <ui:VisualElement name="bar-archive-stability" class="menu-meter-bar-fill" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Panel 2: Niveles / Archivo -->
                <ui:VisualElement name="panel-stability-map" class="menu-panel">
                    <ui:Label text="Archivo de Memorias" class="menu-panel-title" />
                    <ui:Label text="seleccionar un recuerdo registrado" class="menu-panel-subtitle" />
                    <ui:VisualElement class="menu-panel-separator" />

                    <ui:VisualElement style="flex-direction: row; flex-grow: 1; min-height: 0;">
                        <ui:ScrollView style="flex: 1; padding-right: 24px;">
                            <ui:Button name="btn-level-01" text="01  Entrada Escolar — Primer eco" class="menu-level-btn" />
                            <ui:Button name="btn-level-02" text="02  Pasillo de Aulas — Espacio dinámico" class="menu-level-btn" />
                            <ui:Button name="btn-level-03" text="03  Escalera — Galería del eco" class="menu-level-btn" />
                            <ui:Button name="btn-level-04" text="04  Biblioteca — Cruce doble" class="menu-level-btn" />
                            <ui:Button name="btn-level-05" text="05  Aula de Lyra — Caos controlado" class="menu-level-btn" />
                            <ui:Button name="btn-level-06" text="06  Escalera Central — Dominio" class="menu-level-btn" />
                            <ui:Button name="btn-level-07" text="07  Sala de Profesores — Enlace" class="menu-level-btn" />
                            <ui:Button name="btn-level-08" text="08  Laboratorio — Puente del vacío" class="menu-level-btn" />
                            <ui:Button name="btn-level-09" text="09  Gimnasio — Muro de energía" class="menu-level-btn" />
                            <ui:Button name="btn-level-10" text="10  Aceptación — Archivo dual" class="menu-level-btn" />
                            <ui:Button name="btn-level-11" text="11  Depresión — Puente fantasma" class="menu-level-btn" />
                            <ui:Button name="btn-level-12" text="12  Aceptación — Ascenso roto" class="menu-level-btn" />
                            <ui:Button name="btn-level-13" text="13  Verdad — Memoria viva" class="menu-level-btn" />
                            <ui:Button name="btn-level-14" text="14  Liberación — Umbral" class="menu-level-btn" />
                            <ui:Button name="btn-level-15" text="15  Integración — Final" class="menu-level-btn" />
                        </ui:ScrollView>

                        <ui:VisualElement style="width: 260px; flex-shrink: 0; margin-left: 24px; justify-content: space-between;">
                            <ui:VisualElement class="menu-stats-box">
                                <ui:Label text="ESTADÍSTICAS" class="menu-stats-box-title" />
                                <ui:VisualElement class="menu-stat-row">
                                    <ui:Label text="Objetos" class="menu-stat-label" />
                                    <ui:Label name="lbl-telemetry-fragments" text="0/0" class="menu-stat-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-stat-row">
                                    <ui:Label text="Ecos" class="menu-stat-label" />
                                    <ui:Label name="lbl-telemetry-echoes" text="0" class="menu-stat-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-stat-row">
                                    <ui:Label text="Colapsos" class="menu-stat-label" />
                                    <ui:Label name="lbl-telemetry-deaths" text="0" class="menu-stat-value menu-stat-value--danger" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-stat-separator" />
                                <ui:VisualElement class="menu-stat-row">
                                    <ui:Label text="Tiempo total" class="menu-stat-label" />
                                    <ui:Label name="lbl-telemetry-time" text="0s" class="menu-stat-value" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement style="width: 100%;">
                                <ui:Button name="btn-levels-back" text="←  Volver al inicio" class="menu-action-btn" />
                                <ui:Button name="btn-reset-progress" text="Borrar Historial" class="menu-action-btn menu-action-btn--danger" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Panel 3: Ajustes -->
                <ui:VisualElement name="panel-calibration-preview" class="menu-panel">
                    <ui:Label text="Ajustes de Sintonía" class="menu-panel-title" />
                    <ui:Label text="calibrar la recepción de la memoria" class="menu-panel-subtitle" />
                    <ui:VisualElement class="menu-panel-separator" />

                    <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                        <ui:ScrollView style="width: 52%; max-height: 380px; padding-right: 24px;">
                            <ui:Label text="Audio" class="menu-section-label" />
                            <ui:VisualElement class="menu-slider-row">
                                <ui:Slider name="sld-master" label="Volumen General" low-value="0" high-value="1" style="flex-grow: 1;" />
                                <ui:Label name="lbl-master-val" text="100%" class="menu-slider-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="menu-slider-row">
                                <ui:Slider name="sld-music" label="Música" low-value="0" high-value="1" style="flex-grow: 1;" />
                                <ui:Label name="lbl-music-val" text="100%" class="menu-slider-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="menu-slider-row">
                                <ui:Slider name="sld-sfx" label="Efectos" low-value="0" high-value="1" style="flex-grow: 1;" />
                                <ui:Label name="lbl-sfx-val" text="100%" class="menu-slider-value" />
                            </ui:VisualElement>

                            <ui:Label text="Pantalla" class="menu-section-label" style="margin-top: 12px;" />
                            <ui:DropdownField name="ResolutionDropdown" label="Resolución" />
                            <ui:Toggle name="FullscreenToggle" label="Pantalla Completa" />
                            <ui:Toggle name="VsyncToggle" label="Sincronización Vertical" />
                            <ui:DropdownField name="ScaleDropdown" label="Escala Interfaz" style="display: none;" />
                        </ui:ScrollView>

                        <ui:VisualElement style="width: 43%; margin-left: 5%; justify-content: space-between; height: 380px;">
                            <ui:ScrollView style="width: 100%; max-height: 280px;">
                                <ui:Label text="Controles" class="menu-section-label" />
                                <ui:VisualElement class="menu-slider-row">
                                    <ui:Slider name="SensitivitySlider" label="Sensibilidad Ratón" low-value="0.1" high-value="4" style="flex-grow: 1;" />
                                    <ui:Label name="lbl-cam-sens-val" text="1.0" class="menu-slider-value" />
                                </ui:VisualElement>
                                <ui:VisualElement style="display: none;">
                                    <ui:Button name="btn-sens-low" />
                                    <ui:Button name="btn-sens-med" />
                                    <ui:Button name="btn-sens-high" />
                                    <ui:Label name="lbl-sens-val" />
                                </ui:VisualElement>

                                <ui:Label text="Iluminación" class="menu-section-label" style="margin-top: 12px;" />
                                <ui:VisualElement class="menu-light-presets">
                                    <ui:Button name="btn-light-liminal" text="Liminal" class="menu-light-btn" />
                                    <ui:Button name="btn-light-bruma" text="Bruma" class="menu-light-btn" />
                                    <ui:Button name="btn-light-claridad" text="Claridad" class="menu-light-btn" />
                                    <ui:Button name="btn-light-penumbra" text="Penumbra" class="menu-light-btn" />
                                </ui:VisualElement>

                                <ui:VisualElement style="display: none;">
                                    <ui:Slider name="sld-fog" /><ui:Label name="lbl-fog-val" />
                                    <ui:Slider name="sld-echo" /><ui:Label name="lbl-echo-val" />
                                    <ui:Slider name="sld-game-fog" /><ui:Label name="lbl-game-fog-val" />
                                    <ui:Slider name="sld-game-sun" /><ui:Label name="lbl-game-sun-val" />
                                    <ui:Slider name="sld-game-lights" /><ui:Label name="lbl-game-lights-val" />
                                    <ui:Slider name="sld-game-ambient" /><ui:Label name="lbl-game-ambient-val" />
                                    <ui:Slider name="sld-menu-text" /><ui:Label name="lbl-menu-text-val" />
                                </ui:VisualElement>
                            </ui:ScrollView>

                            <ui:VisualElement class="menu-settings-actions">
                                <ui:Button name="btn-restore-defaults" text="Por Defecto" class="menu-action-btn" />
                                <ui:Button name="btn-settings-back" text="Cancelar" class="menu-action-btn" />
                                <ui:Button name="btn-settings-apply" text="Guardar" class="menu-action-btn menu-action-btn--primary" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Panel 4: Exit confirm -->
                <ui:VisualElement name="panel-disconnect-offline" class="menu-panel menu-panel--centered">
                    <ui:Label text="CLAUSURAR EXPEDIENTE" class="menu-panel-title" style="color: #B23A3A;" />
                    <ui:Label text="¿Deseas cerrar el expediente y abandonar la sintonía?" class="menu-panel-subtitle" style="max-width: 400px; -unity-text-align: middle-center;" />
                    <ui:VisualElement style="flex-direction: row; justify-content: center; margin-top: 32px;">
                        <ui:Button name="btn-exit-cancel" text="Permanecer" class="menu-action-btn" style="margin-right: 16px;" />
                        <ui:Button name="btn-exit-confirm" text="Abandonar" class="menu-action-btn menu-action-btn--danger" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Reset progress confirmation overlay -->
        <ui:VisualElement name="reset-progress-panel" class="hidden menu-reset-overlay">
            <ui:VisualElement class="menu-reset-dialog">
                <ui:Label text="BORRAR HISTORIAL" class="menu-reset-dialog-title" />
                <ui:Label text="Esta acción borrará todas las memorias sintonizadas de forma permanente. No se puede deshacer." class="menu-reset-dialog-text" />
                <ui:VisualElement style="flex-direction: row; justify-content: flex-end;">
                    <ui:Button name="btn-reset-progress-cancel" text="Cancelar" class="menu-action-btn" style="margin-right: 12px;" />
                    <ui:Button name="btn-reset-progress-confirm" text="BORRAR TODO" class="menu-action-btn menu-action-btn--danger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Hidden stat labels for C# bindings -->
        <ui:VisualElement style="display: none;">
            <ui:Label name="lbl-stat-stability-val" />
            <ui:VisualElement name="bar-stat-stability-fill" />
            <ui:Label name="lbl-stat-recall-val" />
            <ui:VisualElement name="bar-stat-recall-fill" />
            <ui:Label name="lbl-stat-errors-val" />
            <ui:VisualElement name="bar-stat-errors-fill" />
            <ui:VisualElement name="settings-panel" />
            <ui:VisualElement name="level-select-panel" />
            <ui:Label name="lbl-user-sessions" />
            <ui:VisualElement name="menu-bg" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>