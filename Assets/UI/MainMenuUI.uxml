<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />
    <Style src="project://database/Assets/UI/EchoesHoverEffects.uss" />
    
    <ui:VisualElement name="root" class="root-fullscreen crt-vignette crt-scanlines">
        <ui:VisualElement name="menu-bg" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #0A0A0D; opacity: 0;" />

        <!-- ==========================================
             SPLASH SCREEN (VOID INTRO)
             ========================================== -->
        <ui:VisualElement name="void-intro" class="root-fullscreen" style="background-color: #0A0A0D; justify-content: center; align-items: center; padding: 48px;">
            <!-- Title -->
            <ui:Label text="E C H O E S   O F   Y O U" class="font-serif-bold text-headline-xl" style="color: #E8B262; font-size: 42px; margin-bottom: 8px;" />
            <ui:Label text="registro de una ausencia" class="font-mono text-body-sm" style="color: #C9D4B0; margin-bottom: 96px; -unity-text-transform: uppercase;" />
            
            <!-- School clock icon mock -->
            <ui:VisualElement style="width: 80px; height: 80px; border-radius: 40px; border-width: 2px; border-color: #2B4A4A; align-items: center; justify-content: center; margin-bottom: 96px; opacity: 0.5;">
                <ui:VisualElement style="width: 2px; height: 32px; background-color: #C9D4B0; transform-origin: bottom center; rotate: 45deg;" />
                <ui:VisualElement style="width: 2px; height: 20px; background-color: #C9D4B0; transform-origin: bottom center; rotate: 180deg; position: absolute;" />
            </ui:VisualElement>

            <!-- Blinking prompt -->
            <ui:Label text="[ PRESIONAR CUALQUIER TECLA PARA SINTONIZAR ]" class="font-mono text-body-sm blink-animation" style="color: #E8B262; letter-spacing: 2px;" />
        </ui:VisualElement>

        <!-- ==========================================
             MAIN MENU: FOLDER CONTAINER
             ========================================== -->
        <ui:VisualElement name="main-content" class="main-menu-folder hidden">
            <!-- Left tabs (Side Nav) -->
            <ui:VisualElement name="side-nav" class="side-nav" style="overflow: visible; position: relative;">
                <!-- Gradient overlay del side-nav — temperatura de color por botón activo -->
                <ui:VisualElement name="side-nav-gradient-overlay" class="side-nav-gradient-overlay side-nav-gradient-newgame" />

                <ui:VisualElement class="folder-tabs-group">
                    <!-- Title info -->
                    <ui:VisualElement style="margin-bottom: 48px; border-bottom-width: 1px; border-bottom-color: #1C2430; padding-bottom: 12px;">
                        <ui:Label text="EXPEDIENTE NO. 9811" class="font-mono-bold text-headline-md" style="font-size: 14px; color: #E8B262;" />
                        <ui:Label text="Identidad: Aiden" class="font-serif text-body-sm" style="color: #6C788A; margin-top: 4px;" />
                        <ui:Label name="hero-title" text="" class="font-serif text-body-sm" style="color: #C9D4B0; margin-top: 6px; -unity-font-style: italic; min-height: 14px;" />
                    </ui:VisualElement>

                    <!-- Navigation Tab Buttons — sistema de hover v2 -->
                    <!-- Los ghost layers y capas de efecto son inyectados dinámicamente por MenuHoverSystem.cs -->
                    <ui:VisualElement class="nav-item-wrapper">
                        <ui:Button name="nav-newgame" text="I. Acceder a Memoria" class="nav-item nav-item-v2" />
                    </ui:VisualElement>
                    <ui:VisualElement class="nav-item-wrapper">
                        <ui:Button name="nav-levels" text="II. Archivo de Memorias" class="nav-item nav-item-v2" />
                    </ui:VisualElement>
                    <ui:VisualElement class="nav-item-wrapper">
                        <ui:Button name="nav-settings" text="III. Configurar Receptor" class="nav-item nav-item-v2" />
                    </ui:VisualElement>
                    <ui:VisualElement class="nav-item-wrapper" style="margin-top: 16px;">
                        <ui:Button name="nav-exit" text="IV. Clausurar" class="nav-item nav-item-v2" style="color: rgba(178,58,58,0.55);" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- File metadata bottom label -->
                <ui:VisualElement style="border-top-width: 1px; border-top-color: #1C2430; padding-top: 12px;">
                    <ui:Label name="lbl-user-rank" text="ESTADO: INCOMPLETO" class="font-mono-bold text-label-caps" style="color: #B23A3A;" />
                    <ui:Label name="lbl-user-integrity" text="Integridad: 12%" class="font-mono text-body-sm" style="font-size: 9px; color: #6C788A; margin-top: 2px;" />
                    <ui:Label name="lbl-user-sessions" text="Sintonizaciones: 1" class="font-mono text-body-sm" style="font-size: 9px; color: #6C788A;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Right panels container -->
            <ui:VisualElement name="right-content-container" style="position: relative; overflow: hidden;">
                <!-- Panel tint overlay — temperatura de color, animado por MenuHoverSystem -->
                <ui:VisualElement name="panel-tint-overlay" class="panel-tint-warm" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none;" />
                <!-- CRT blink overlay — parpadeo al cambiar de ambience -->
                <ui:VisualElement name="right-panel-crt-blink" class="right-panel-crt-blink" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none;" />
                
                <!-- ==========================================
                     PANEL 1: NEURAL ARCHIVES (EXPEDIENTE INFO)
                     ========================================== -->
                <ui:VisualElement name="panel-neural-archives" class="preview-panel preview-panel--visible">
                    <ui:Label text="Expediente de Ausencia" class="font-serif-bold text-headline-xl" style="-unity-text-align: middle-left; margin-bottom: 4px;" />
                    <ui:Label text="registro y telemetria residual del eco" class="font-mono text-label-caps" style="color: #6C788A; margin-bottom: 20px;" />
                    <ui:VisualElement class="accent-line" />

                    <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                        <!-- Left col: log & telemetria -->
                        <ui:VisualElement style="width: 55%; padding-right: 24px;">
                            <ui:Label text="Registro de Actividad" class="font-mono-bold text-label-caps" style="color: #E8B262; margin-bottom: 8px;" />
                            <ui:VisualElement class="terminal-log-box" style="margin-bottom: 24px;">
                                <ui:Label text="[OK] Receptor analÃ³gico sintonizado." class="terminal-log-line" />
                                <ui:Label name="lbl-archive-log-1" text="[OK] Fragmentos escolares mapeados." class="terminal-log-line" />
                                <ui:Label name="lbl-archive-log-2" text="[OK] Frecuencia de eco establecida (15 FPS)." class="terminal-log-line" />
                                <ui:Label name="lbl-archive-log-3" text="Esperando entrada del observador..." class="terminal-log-line" style="color: #E8B262;" />
                            </ui:VisualElement>

                            <ui:Label text="Datos Acumulados" class="font-mono-bold text-label-caps" style="color: #E8B262; margin-bottom: 8px;" />
                            <ui:VisualElement class="telemetry-row">
                                <ui:VisualElement class="telemetry-chip">
                                    <ui:Label text="Objetos" class="telemetry-chip-label" />
                                    <ui:Label name="lbl-archive-fragments" text="0/15" class="telemetry-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="telemetry-chip">
                                    <ui:Label text="Ecos" class="telemetry-chip-label" />
                                    <ui:Label name="lbl-archive-echoes" text="0" class="telemetry-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="telemetry-chip">
                                    <ui:Label text="Colapsos" class="telemetry-chip-label" />
                                    <ui:Label name="lbl-archive-deaths" text="0" class="telemetry-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="telemetry-chip">
                                    <ui:Label text="Tiempo" class="telemetry-chip-label" />
                                    <ui:Label name="lbl-archive-time" text="00:00" class="telemetry-chip-value" style="font-size: 14px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Right col: polaroid preview & stability -->
                        <ui:VisualElement style="width: 40%; margin-left: 5%; align-items: center;">
                            <ui:VisualElement class="polaroid-frame">
                                <ui:VisualElement class="polaroid-photo" />
                                <ui:Label text="Entrada Principal (Vacio)" class="polaroid-label" />
                            </ui:VisualElement>

                            <ui:VisualElement style="margin-top: 20px; width: 100%; padding: 12px; background-color: #0A0A0D; border-width: 1px; border-color: #2B4A4A;">
                                <ui:Label text="RETENCIÃ“N DE MEMORIA" class="font-mono-bold text-label-caps" style="font-size: 9px; color: #6C788A; margin-bottom: 6px;" />
                                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                                    <ui:Label name="lbl-archive-stability-pct" text="0%" class="font-mono-bold" style="font-size: 16px; color: #C9D4B0;" />
                                    <ui:VisualElement style="width: 120px; height: 6px; background-color: #1C2430; border-width: 1px; border-color: #2B4A4A;">
                                        <ui:VisualElement name="bar-archive-stability" style="width: 0%; height: 100%; background-color: #C9D4B0;" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ==========================================
                     PANEL 2: STABILITY MAP (TAPE ARCHIVE)
                     ========================================== -->
                <ui:VisualElement name="panel-stability-map" class="preview-panel">
                    <ui:Label text="Archivo de Memorias" class="font-serif-bold text-headline-xl" style="-unity-text-align: middle-left; margin-bottom: 4px;" />
                    <ui:Label text="seleccionar un recuerdo registrado" class="font-mono text-label-caps" style="color: #6C788A; margin-bottom: 20px;" />
                    <ui:VisualElement class="accent-line" />

                    <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                        <!-- Left: List of tapes -->
                        <ui:ScrollView style="width: 60%; max-height: 380px; padding-right: 12px;">
                            <ui:Button name="btn-level-01" text="1. Entrada Escolar â€” Primer eco" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-02" text="2. Pasillo de Aulas â€” Espacio dinÃ¡mico" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-03" text="3. Escalera â€” GalerÃ­a del eco" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-04" text="4. Biblioteca â€” Cruce doble" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-05" text="5. Aula de Lyra â€” Caos controlado" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-06" text="6. Escalera Central â€” Dominio" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-07" text="7. Sala de Profesores â€” Sala de enlace" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-08" text="8. Laboratorio â€” Puente del vacÃ­o" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-09" text="9. Gimnasio â€” Muro de energÃ­a" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-10" text="10. Aceptacion â€” Archivo dual" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-11" text="11. Depresión — Puente fantasma" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-12" text="12. Aceptación — Ascenso roto" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-13" text="13. Verdad — Memoria viva" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-14" text="14. Liberación — Umbral" class="btn-classic level-card" style="margin-bottom: 8px;" />
                            <ui:Button name="btn-level-15" text="15. Integración — Final" class="btn-classic level-card" style="margin-bottom: 8px;" />
                        </ui:ScrollView>

                        <!-- Right: Selected tape stats -->
                        <ui:VisualElement style="width: 35%; margin-left: 5%; align-items: center; justify-content: space-between; height: 380px;">
                            <ui:VisualElement style="width: 100%; padding: 12px; background-color: #0A0A0D; border-width: 1px; border-color: #2B4A4A; margin-bottom: 16px;">
                                <ui:Label text="ESTADÃSTICAS DEL RECUERDO" class="font-mono-bold text-label-caps" style="color: #E8B262; margin-bottom: 12px;" />
                                
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                                    <ui:Label text="Objetos:" class="font-mono text-body-sm" />
                                    <ui:Label name="lbl-telemetry-fragments" text="0/0" class="font-mono-bold" style="color: #C9D4B0;" />
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                                    <ui:Label text="Ecos:" class="font-mono text-body-sm" />
                                    <ui:Label name="lbl-telemetry-echoes" text="0" class="font-mono-bold" style="color: #C9D4B0;" />
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                                    <ui:Label text="Colapsos:" class="font-mono text-body-sm" />
                                    <ui:Label name="lbl-telemetry-deaths" text="0" class="font-mono-bold" style="color: #B23A3A;" />
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                    <ui:Label text="Tiempo:" class="font-mono text-body-sm" />
                                    <ui:Label name="lbl-telemetry-time" text="0s" class="font-mono-bold" style="color: #C9D4B0;" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Hidden stats fields for C# script binding -->
                            <ui:VisualElement style="display: none; height: 0px; width: 0px;">
                                <ui:Label name="lbl-stat-stability-val" text="0" />
                                <ui:VisualElement name="bar-stat-stability-fill" />
                                <ui:Label name="lbl-stat-recall-val" text="0" />
                                <ui:VisualElement name="bar-stat-recall-fill" />
                                <ui:Label name="lbl-stat-errors-val" text="0" />
                                <ui:VisualElement name="bar-stat-errors-fill" />
                            </ui:VisualElement>

                            <!-- Level control back & reset -->
                            <ui:VisualElement style="width: 100%;">
                                <ui:Button name="btn-levels-back" text="&lt;- Volver" class="btn-classic" style="margin-bottom: 8px; width: 100%;" />
                                <ui:Button name="btn-reset-progress" text="Borrar Historial" class="btn-classic btn-classic-accent" style="width: 100%;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ==========================================
                     PANEL 3: CALIBRATION PREVIEW (SETTINGS)
                     ========================================== -->
                <ui:VisualElement name="panel-calibration-preview" class="preview-panel">
                    <ui:Label text="Ajustes de SintonÃ­a" class="font-serif-bold text-headline-xl" style="-unity-text-align: middle-left; margin-bottom: 4px;" />
                    <ui:Label text="calibrar la recepcion de la memoria" class="font-mono text-label-caps" style="color: #6C788A; margin-bottom: 20px;" />
                    <ui:VisualElement class="accent-line" />

                    <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                        <!-- Left: Volume, Video settings -->
                        <ui:ScrollView style="width: 50%; max-height: 380px; padding-right: 24px;">
                            <ui:Label text="Audio" class="settings-group-title" />
                            <ui:Slider name="sld-master" label="Volumen General" low-value="0" high-value="1" />
                            <ui:Label name="lbl-master-val" text="100%" class="font-mono text-body-sm" style="display: none;" />
                            <ui:Slider name="sld-music" label="MÃºsica" low-value="0" high-value="1" />
                            <ui:Label name="lbl-music-val" text="100%" class="font-mono text-body-sm" style="display: none;" />
                            <ui:Slider name="sld-sfx" label="Efectos" low-value="0" high-value="1" />
                            <ui:Label name="lbl-sfx-val" text="100%" class="font-mono text-body-sm" style="display: none;" />

                            <ui:Label text="Pantalla" class="settings-group-title" style="margin-top: 16px;" />
                            <ui:DropdownField name="ResolutionDropdown" label="ResoluciÃ³n" />
                            <ui:Toggle name="FullscreenToggle" label="Pantalla Completa" />
                            <ui:Toggle name="VsyncToggle" label="SincronizaciÃ³n Vertical" />
                            <ui:DropdownField name="ScaleDropdown" label="Escala Interfaz" style="display: none;" />
                        </ui:ScrollView>

                        <!-- Right: Gameplay, Lighting presets & Actions -->
                        <ui:VisualElement style="width: 45%; margin-left: 5%; justify-content: space-between; height: 380px;">
                            <ui:ScrollView style="width: 100%; max-height: 280px;">
                                <ui:Label text="Controles" class="settings-group-title" />
                                <ui:Slider name="SensitivitySlider" label="Sensibilidad RatÃ³n" low-value="0.1" high-value="4" />
                                <ui:Label name="lbl-cam-sens-val" text="1.0" class="font-mono text-body-sm" style="display: none;" />
                                
                                <ui:VisualElement style="display: none;">
                                    <ui:Button name="btn-sens-low" />
                                    <ui:Button name="btn-sens-med" />
                                    <ui:Button name="btn-sens-high" />
                                    <ui:Label name="lbl-sens-val" />
                                </ui:VisualElement>

                                <ui:Label text="IluminaciÃ³n" class="settings-group-title" style="margin-top: 16px;" />
                                <ui:VisualElement style="flex-direction: row; flex-wrap: wrap;">
                                    <ui:Button name="btn-light-liminal" text="Liminal" class="btn-classic" style="margin-right: 8px; margin-bottom: 8px; width: 45%;" />
                                    <ui:Button name="btn-light-bruma" text="Bruma" class="btn-classic" style="margin-right: 8px; margin-bottom: 8px; width: 45%;" />
                                    <ui:Button name="btn-light-claridad" text="Claridad" class="btn-classic" style="margin-right: 8px; margin-bottom: 8px; width: 45%;" />
                                    <ui:Button name="btn-light-penumbra" text="Penumbra" class="btn-classic" style="margin-right: 8px; margin-bottom: 8px; width: 45%;" />
                                </ui:VisualElement>

                                <!-- Developer variables dummy mapping to satisfy script links -->
                                <ui:VisualElement style="display: none;">
                                    <ui:Slider name="sld-fog" /><ui:Label name="lbl-fog-val" />
                                    <ui:Slider name="sld-echo" /><ui:Label name="lbl-echo-val" />
                                    <ui:Slider name="sld-game-fog" /><ui:Label name="lbl-game-fog-val" />
                                    <ui:Slider name="sld-game-sun" /><ui:Label name="lbl-game-sun-val" />
                                    <ui:Slider name="sld-game-lights" /><ui:Label name="lbl-game-lights-val" />
                                    <ui:Slider name="sld-game-ambient" /><ui:Label name="lbl-game-ambient-val" />
                                    <ui:Slider name="sld-menu-text" /><ui:Label name="lbl-menu-text-val" />
                                </ui:VisualElement>
                            </ui:ScrollView>

                            <!-- Actions -->
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Button name="btn-restore-defaults" text="Por Defecto" class="btn-classic" style="width: 30%;" />
                                <ui:Button name="btn-settings-back" text="Cancelar" class="btn-classic" style="width: 30%;" />
                                <ui:Button name="btn-settings-apply" text="Guardar" class="btn-classic btn-classic-accent" style="width: 35%;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ==========================================
                     PANEL 4: DISCONNECT OFFLINE (EXIT CONFIRM)
                     ========================================== -->
                <ui:VisualElement name="panel-disconnect-offline" class="preview-panel" style="justify-content: center; align-items: center; background-color: #0A0A0D;">
                    <ui:Label text="CLAUSURAR EXPEDIENTE" class="font-serif-bold text-headline-xl" style="color: #B23A3A; margin-bottom: 12px;" />
                    <ui:Label text="Â¿Deseas cerrar el expediente y abandonar la sintonÃ­a?" class="font-serif text-body-lg" style="margin-bottom: 32px; -unity-text-align: middle-center; max-width: 400px;" />
                    
                    <ui:VisualElement style="flex-direction: row; justify-content: center; width: 100%;">
                        <ui:Button name="btn-exit-cancel" text="Permanecer" class="btn-classic" style="margin-right: 16px; padding: 12px 24px;" />
                        <ui:Button name="btn-exit-confirm" text="Abandonar" class="btn-classic btn-classic-accent" style="padding: 12px 24px;" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Dummy parent setting panel so script bindings don't crash -->
        <ui:VisualElement name="settings-panel" class="hidden" style="display: none;" />

        <!-- Reset progress confirmation overlay popup -->
        <ui:VisualElement name="reset-progress-panel" class="hidden" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(10,10,13,0.95); justify-content: center; align-items: center;">
            <ui:VisualElement style="background-color: #0A0A0D; border-width: 2px; border-color: #B23A3A; padding: 32px; width: 400px;">
                <ui:Label text="BORRAR HISTORIAL" class="font-mono-bold text-headline-md" style="color: #B23A3A; margin-bottom: 12px;" />
                <ui:Label text="Esta acciÃ³n borrarÃ¡ todas las memorias sintonizadas de forma permanente. No se puede deshacer." class="font-serif text-body-lg" style="color: #E2E4E8; margin-bottom: 24px;" />
                
                <ui:VisualElement style="flex-direction: row; justify-content: flex-end;">
                    <ui:Button name="btn-reset-progress-cancel" text="Cancelar" class="btn-classic" style="margin-right: 12px;" />
                    <ui:Button name="btn-reset-progress-confirm" text="BORRAR TODO" class="btn-classic btn-classic-accent" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Dynamic level select panel dummy (to avoid null checks in C#) -->
        <ui:VisualElement name="level-select-panel" class="hidden" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>

