<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />
    <Style src="project://database/Assets/UI/MainMenuUI.uss" />

    <ui:VisualElement name="root" class="root-fullscreen menu-stitch-root" style="width: 1920px; height: 1080px; position: absolute; left: 0; top: 0;">

        <!-- BACKGROUND IMAGE LAYER -->
        <ui:VisualElement name="menu-bg-image" class="menu-bg-image" />

        <!-- DARK OVERLAY GRADIENT -->
        <ui:VisualElement name="menu-bg-gradient" class="menu-bg-gradient" />

        <!-- SCANLINES OVERLAY -->
        <ui:VisualElement name="menu-scanlines" class="menu-scanlines" picking-mode="Ignore" />

        <!-- NOISE OVERLAY -->
        <ui:VisualElement name="menu-noise" class="menu-noise" picking-mode="Ignore" />

        <!-- VOID INTRO (hidden, only exists for controller compatibility) -->
        <ui:VisualElement name="void-intro" class="hidden" style="display: none;" />

        <!-- MAIN CONTENT -->
        <ui:VisualElement name="main-content" class="main-menu-content">

            <!-- LEFT SIDEBAR -->
            <ui:VisualElement name="side-nav" class="menu-sidebar">

                <!-- LOGO & TITLE AREA (Official Logo Image) -->
                <ui:VisualElement class="menu-logo-area">
                    <ui:VisualElement name="menu-logo-img" class="menu-logo-image" />
                    <ui:Label text="ARCHIVO DE MEMORIA" class="menu-logo-subtitle" />
                </ui:VisualElement>

                <!-- NAVIGATION LIST (Asymmetrical Left-Aligned with Vertical Guide Line) -->
                <ui:VisualElement class="menu-nav-container">
                    <!-- Vertical connecting guide line -->
                    <ui:VisualElement class="menu-nav-guide-line" picking-mode="Ignore" />

                    <!-- 1. Continuar (Active State with Progress Info) -->
                    <ui:VisualElement class="nav-item-block">
                        <ui:VisualElement class="menu-active-dot" picking-mode="Ignore" />
                        <ui:VisualElement class="nav-btn-row">
                            <ui:Button name="nav-continue" text="Continuar" class="menu-nav-btn menu-nav-btn--continue" />
                            <ui:Label text="→" class="menu-nav-arrow" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <!-- Progress info under Continuar -->
                        <ui:VisualElement class="menu-ctn-progress">
                            <ui:VisualElement class="menu-ctn-progress-row">
                                <ui:Label text="■" class="menu-save-icon" />
                                <ui:Label text="Último guardado:" class="menu-ctn-progress-label" />
                            </ui:VisualElement>
                            <ui:Label name="lbl-user-rank" text="Aula 204 | 04:12:15" class="menu-ctn-progress-value" />
                            <ui:Label name="lbl-user-integrity" text="Integridad: 12%" class="menu-ctn-progress-integrity" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 2. Nuevo expediente -->
                    <ui:VisualElement class="nav-item-block">
                        <ui:VisualElement class="nav-btn-row">
                            <ui:Button name="nav-newgame" text="Nuevo expediente" class="menu-nav-btn" />
                            <ui:Label text="→" class="menu-nav-arrow" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 3. Selección de capítulos -->
                    <ui:VisualElement class="nav-item-block">
                        <ui:VisualElement class="nav-btn-row">
                            <ui:Button name="nav-chapters" text="Selección de capítulos" class="menu-nav-btn" />
                            <ui:Label text="→" class="menu-nav-arrow" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 4. Ajustes -->
                    <ui:VisualElement class="nav-item-block">
                        <ui:VisualElement class="nav-btn-row">
                            <ui:Button name="nav-settings" text="Ajustes" class="menu-nav-btn" />
                            <ui:Label text="→" class="menu-nav-arrow" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 5. Créditos -->
                    <ui:VisualElement class="nav-item-block">
                        <ui:VisualElement class="nav-btn-row">
                            <ui:Button name="nav-credits" text="Créditos" class="menu-nav-btn" />
                            <ui:Label text="→" class="menu-nav-arrow" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 6. Galería -->
                    <ui:VisualElement class="nav-item-block">
                        <ui:VisualElement class="nav-btn-row">
                            <ui:Button name="nav-gallery" text="Galería" class="menu-nav-btn" />
                            <ui:Label text="→" class="menu-nav-arrow" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 7. Salir -->
                    <ui:VisualElement class="nav-item-block nav-item-block--exit">
                        <ui:VisualElement class="nav-btn-row">
                            <ui:Button name="nav-exit" text="Salir" class="menu-nav-btn menu-nav-btn--exit" />
                            <ui:Label text="→" class="menu-nav-arrow menu-nav-arrow--exit" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- FOOTER / VERSION INFO -->
                <ui:VisualElement class="menu-sidebar-footer">
                    <ui:Label text="SYS.VER 1.04_b" class="menu-footer-ver" />
                    <ui:Label text="© 199X-202X SYSTEM CORRUPTION.&#10;ALL RIGHTS RESERVED." class="menu-footer-copy" />
                </ui:VisualElement>

            </ui:VisualElement>


            <!-- ==========================================
                 PANELS (hidden by default, shown on click)
                 ========================================== -->
            <ui:VisualElement name="right-content-container" class="menu-panels-container">

                <!-- Panel 1: Continuar / Expediente -->
                <ui:VisualElement name="panel-neural-archives" class="menu-panel">
                    <ui:Label text="Expediente de Ausencia" class="menu-panel-title" />
                    <ui:Label text="registro y telemetría residual del eco" class="menu-panel-subtitle" />
                    <ui:VisualElement class="menu-panel-separator" />

                    <ui:VisualElement style="flex-direction: row; flex-grow: 1; min-height: 0;">
                        <ui:VisualElement style="width: 55%; padding-right: 24px;">
                            <ui:Label text="Registro de Actividad" class="menu-section-label" />
                            <ui:VisualElement class="menu-terminal-box">
                                <ui:Label text="[OK] Receptor analógico sintonizado." class="menu-terminal-line" />
                                <ui:Label name="lbl-archive-log-1" text="[OK] Fragmentos escolares mapeados." class="menu-terminal-line" />
                                <ui:Label name="lbl-archive-log-2" text="[OK] Frecuencia de eco establecida (15 FPS)." class="menu-terminal-line" />
                                <ui:Label name="lbl-archive-log-3" text="Esperando entrada del observador..." class="menu-terminal-line" style="color: #E8B262;" />
                            </ui:VisualElement>

                            <ui:Label text="Datos Acumulados" class="menu-section-label" />
                            <ui:VisualElement class="menu-chips-row">
                                <ui:VisualElement class="menu-chip">
                                    <ui:Label text="Objetos" class="menu-chip-label" />
                                    <ui:Label name="lbl-archive-fragments" text="0/15" class="menu-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-chip">
                                    <ui:Label text="Ecos" class="menu-chip-label" />
                                    <ui:Label name="lbl-archive-echoes" text="0" class="menu-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-chip">
                                    <ui:Label text="Colapsos" class="menu-chip-label" />
                                    <ui:Label name="lbl-archive-deaths" text="0" class="menu-chip-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="menu-chip">
                                    <ui:Label text="Tiempo" class="menu-chip-label" />
                                    <ui:Label name="lbl-archive-time" text="00:00" class="menu-chip-value" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement style="width: 40%; margin-left: 5%; align-items: center;">
                            <ui:VisualElement class="menu-polaroid">
                                <ui:VisualElement class="menu-polaroid-photo" />
                                <ui:Label text="Entrada Principal (Vacío)" class="menu-polaroid-caption" />
                            </ui:VisualElement>

                            <ui:VisualElement class="menu-memory-meter">
                                <ui:Label text="RETENCIÓN DE MEMORIA" class="menu-meter-title" />
                                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                                    <ui:Label name="lbl-archive-stability-pct" text="0%" class="menu-meter-value" />
                                    <ui:VisualElement class="menu-meter-bar-bg">
                                        <ui:VisualElement name="bar-archive-stability" class="menu-meter-bar-fill" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Panel 2: Niveles / Archivo (Índice de Recuerdos) -->
                <ui:VisualElement name="panel-stability-map" class="menu-panel">
                    <!-- Header with title and close button -->
                    <ui:VisualElement class="menu-panel-header-row">
                        <ui:VisualElement style="flex-grow: 1;">
                            <ui:Label text="DIRECTORIO_PRINCIPAL // 001" class="menu-header-tag" />
                            <ui:Label text="Índice de Recuerdos" class="menu-panel-title" />
                        </ui:VisualElement>
                        <ui:Button name="btn-levels-back" text="✕  CERRAR" class="menu-panel-close-btn" />
                    </ui:VisualElement>
                    <ui:VisualElement class="menu-panel-separator" />

                    <!-- Full-width Chapter ScrollView -->
                    <ui:ScrollView class="lvl-chapter-list" style="flex-grow: 1;">

                        <!-- Chapter 01 -->
                        <ui:VisualElement class="lvl-chapter">
                            <ui:VisualElement class="lvl-chapter-main">
                                <ui:VisualElement class="lvl-chapter-thumb">
                                    <ui:Label text="01" class="lvl-chapter-thumb-num" />
                                </ui:VisualElement>
                                <ui:VisualElement class="lvl-chapter-meta">
                                    <ui:VisualElement class="lvl-chapter-meta-row">
                                        <ui:Label text="REC: I" class="lvl-chapter-rec" />
                                        <ui:Label text="•" class="lvl-meta-bullet" />
                                        <ui:Label text="Pasillo Norte" class="lvl-chapter-location" />
                                        <ui:Label text="75% ECHOES" class="lvl-chapter-progress" />
                                    </ui:VisualElement>
                                    <ui:Button name="btn-level-01" text="El Susurro del Aula" class="lvl-chapter-btn-title" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Chapter 02 -->
                        <ui:VisualElement class="lvl-chapter">
                            <ui:VisualElement class="lvl-chapter-main">
                                <ui:VisualElement class="lvl-chapter-thumb">
                                    <ui:Label text="02" class="lvl-chapter-thumb-num" />
                                </ui:VisualElement>
                                <ui:VisualElement class="lvl-chapter-meta">
                                    <ui:VisualElement class="lvl-chapter-meta-row">
                                        <ui:Label text="REC: II" class="lvl-chapter-rec" />
                                        <ui:Label text="•" class="lvl-meta-bullet" />
                                        <ui:Label text="Patio Interior" class="lvl-chapter-location" />
                                        <ui:Label text="42% ECHOES" class="lvl-chapter-progress lvl-chapter-progress--dim" />
                                    </ui:VisualElement>
                                    <ui:Button name="btn-level-02" text="Lluvia Estática" class="lvl-chapter-btn-title" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Chapter 03 -->
                        <ui:VisualElement class="lvl-chapter lvl-chapter--locked">
