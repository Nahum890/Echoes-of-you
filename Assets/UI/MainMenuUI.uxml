<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements">
    <!-- MainMenuUI — Rediseño canónico Fase 2.
         Esquema: void-intro (splash) → main-content (sidebar + right panels).
         0 opacidades bajas. Contraste ≥ 4.5:1 en todo texto.
         Vocabulario canónico: "Cuaderno", "Eco", "Recuerdo", "Capítulo", "Grabar", "Proyectar". -->

    <ui:Style src="{7bfe726ffbde81b498cde69fa47cbc36}" /> <!-- MainMenuUI.uss -->
    <ui:Style src="{c445fc50e42772d4e8fa39b455aa5aa7}" /> <!-- EchoButton.uss -->
    <ui:Style src="{86f29f1740a5ef74d95d57757b401e48}" /> <!-- EchoPanel.uss -->
    <ui:Style src="{588a84fa0168dae46aa4b9b15a1fd0e2}" /> <!-- EchoCard.uss -->
    <ui:Style src="{7b364f417a72ce24db38b864f6d98d3b}" /> <!-- EchoTabs.uss -->
    <ui:Style src="{c9b5b8dc0da5e504fb2756bf4e215ba6}" /> <!-- EchoModal.uss -->
    <ui:Style src="{d3dc04a912fa73741969b2321bb940b9}" /> <!-- EchoToast.uss -->
    <ui:Style src="{76567b3454471974591202038b6ae72a}" /> <!-- EchoLoading.uss -->

    <ui:VisualElement class="root-fullscreen" name="root">

        <!-- SPLASH / VOID INTRO -->
        <ui:VisualElement class="void-intro" name="void-intro">
            <ui:Label class="void-intro__text" text="Pulsa [ESPACIO] para abrir el Cuaderno" />
        </ui:VisualElement>

        <!-- MAIN CONTENT — oculto hasta dismiss -->
        <ui:VisualElement class="main-menu-folder hidden" name="main-content">
            <!-- BACKGROUND LAYER — for hover interaction -->
            <ui:VisualElement class="menu-background" name="menuBackground" />

            <!-- SIDE NAV — manila paper -->
            <ui:VisualElement class="side-nav" name="side-nav">
                <ui:VisualElement class="side-nav__header">
                    <ui:VisualElement class="logo" name="logo" />
                    <ui:Label class="side-nav__title" text="ECHOES OF YOU" />
                    <ui:Label class="side-nav__subtitle" text="un eco que no se puede borrar" />
                </ui:VisualElement>

                <ui:VisualElement class="side-nav__hero">
                    <ui:Label class="hero-title" name="heroTitle" text="Aula 104" />
                </ui:VisualElement>

                <ui:VisualElement class="folder-tabs-group" name="folderTabs">
                    <ui:Button class="echo-button echo-button--primary nav-item-v2" name="nav-continuar" text="I. Continuar / Acceder a Memoria" />
                    <ui:Button class="echo-button echo-button--primary nav-item-v2" name="nav-capitulos" text="II. Capítulos del Cuaderno" />
                    <ui:Button class="echo-button echo-button--primary nav-item-v2" name="nav-configurar" text="III. Configurar Cuaderno" />
                    <ui:Button class="echo-button echo-button--primary nav-item-v2" name="nav-creditos" text="IV. Créditos" />
                    <ui:Button class="echo-button echo-button--destructive nav-item-v2" name="nav-cerrar" text="V. Cerrar Cuaderno" />
                </ui:VisualElement>

                <ui:VisualElement class="side-nav__footer">
                    <ui:Label name="lblEcosAnclados" text="Ecos anclados: 0/15" />
                    <ui:Label name="lblRecuerdos" text="Recuerdos completados: 0" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- RIGHT CONTENT CONTAINER — paper background -->
            <ui:VisualElement name="right-content-container" class="right-content-container hidden">
                <ui:VisualElement class="preview-panel" name="panel-cuaderno-recorrido">
                    <ui:Label class="panel-title" text="Cuaderno del Recorrido" />
                    <ui:VisualElement class="terminal-log-box">
                        <ui:Label class="terminal-log-line" name="lbl-archive-log-1" text="[RECORRIDO] Cuaderno de Aiden abierto." />
                        <ui:Label class="terminal-log-line" name="lbl-archive-log-2" text="[OK] Vínculos de recuerdo establecidos." />
                        <ui:Label class="terminal-log-line" name="lbl-archive-log-3" text="[OK] Aula sincronizada." />
                    </ui:VisualElement>
                    <ui:VisualElement class="telemetry-row">
                        <ui:VisualElement class="telemetry-chip">
                            <ui:Label class="telemetry-chip-label" text="FRAGMENTOS" />
                            <ui:Label class="telemetry-chip-value" name="lbl-archive-fragments" text="0/15" />
                        </ui:VisualElement>
                        <ui:VisualElement class="telemetry-chip">
                            <ui:Label class="telemetry-chip-label" text="ECOS" />
                            <ui:Label class="telemetry-chip-value" name="lbl-archive-echoes" text="0" />
                        </ui:VisualElement>
                        <ui:VisualElement class="telemetry-chip">
                            <ui:Label class="telemetry-chip-label" text="COLAPSOS" />
                            <ui:Label class="telemetry-chip-value" name="lbl-archive-deaths" text="0" />
                        </ui:VisualElement>
                        <ui:VisualElement class="telemetry-chip">
                            <ui:Label class="telemetry-chip-label" text="TIEMPO" />
                            <ui:Label class="telemetry-chip-value" name="lbl-archive-time" text="00:00:00" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="accent-line" />
                    <ui:Label class="text-body-lg" text="Estabilidad del recorrido:" />
                    <ui:VisualElement class="terminal-log-box" style="height: 12px;">
                        <ui:VisualElement class="accent-line" name="bar-archive-stability" style="height: 100%; width: 0%;" />
                    </ui:VisualElement>
                    <ui:Label class="text-label-caps" name="lbl-archive-stability-pct" text="20%" />
                </ui:VisualElement>

                <ui:VisualElement class="preview-panel hidden" name="panel-capitulos-cuaderno">
                    <ui:Label class="panel-title" text="Capítulos del Cuaderno" />
                    <ui:VisualElement class="level-card-grid" name="levelCardGrid" />
                </ui:VisualElement>

                <ui:VisualElement class="preview-panel hidden" name="panel-ajustes-cuaderno">
                    <ui:Label class="panel-title" text="Ajustes del Cuaderno" />
                    <ui:VisualElement name="settingsContainer" />
                </ui:VisualElement>

                <ui:VisualElement class="preview-panel hidden" name="panel-cerrar-cuaderno">
                    <ui:Label class="panel-title" text="Cerrar Cuaderno" />
                    <ui:Label class="text-body-lg" text="¿Deseas salir del recuerdo? El progreso se guardará." />
                    <ui:VisualElement class="echo-modal__actions" style="margin-top: 24px;">
                        <ui:Button class="echo-button echo-button--primary" name="btn-confirm-exit" text="Sí, cerrar" />
                        <ui:Button class="echo-button echo-button--secondary" name="btn-cancel-exit" text="Volver" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</UXML>