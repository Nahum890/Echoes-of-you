/* ============================================================
   SettingsUI — STITCH CALIBRACIÓN
   Basado en: stitch_echoes_of_you_ui_system/settings_calibraciòn/code.html
   ============================================================ */

@import "EchoesDesignTokens.uss";

/* ===== ROOT ===== */
.settings-stitch-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #131410;
    overflow: hidden;
    flex-direction: column;
}

.settings-bg-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #131410;
    opacity: 0.85;
}

/* ===== MAIN INTERFACE ===== */
.settings-main {
    position: absolute;
    left: 64px;
    top: 64px;
    right: 64px;
    bottom: 64px;
    flex-direction: row;
    background-color: rgba(19, 20, 16, 0.65);
    border-width: 1px;
    border-color: rgba(149, 144, 135, 0.5);
    overflow: hidden;
}

/* ============================================================
   LEFT SIDEBAR (1/3)
   ============================================================ */

.settings-sidebar {
    width: 33%;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgba(149, 144, 135, 0.5);
    padding: 64px 32px 64px 32px;
    flex-direction: column;
}

.settings-sidebar-header {
    margin-bottom: 48px;
}

.settings-logo-title {
    font-size: 42px;
    color: #fffeff;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

.settings-logo-subtitle {
    font-size: 14px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-top: 4px;
}

.settings-sidebar-divider {
    height: 1px;
    background-color: rgba(149, 144, 135, 0.5);
    margin-top: 24px;
}

/* ===== TABS ===== */
.settings-tabs {
    flex-grow: 1;
    flex-direction: column;
    gap: 8px;
}

.settings-tab {
    background-color: transparent;
    border-width: 0px;
    padding: 12px 16px;
    font-size: 16px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    -unity-text-align: middle-left;
    color: #959087;
    letter-spacing: 2.4px;
    border-left-width: 4px;
    border-left-color: transparent;
    transition-property: color, border-left-color, translate;
    transition-duration: 200ms;
    transition-timing-function: linear;
    opacity: 0.8;
}

.settings-tab:hover {
    opacity: 1;
    color: #e4e2dc;
    translate: 2px 0px;
}

.settings-tab--active {
    opacity: 1;
    color: #e8e1d4;
    border-left-width: 4px;
    border-left-color: #e8e1d4;
}

/* ===== SIDEBAR FOOTER ===== */
.settings-sidebar-footer {
    margin-top: auto;
    padding-top: 24px;
    border-top-width: 1px;
    border-top-color: rgba(149, 144, 135, 0.5);
}

.settings-close-btn {
    background-color: transparent;
    border-width: 0px;
    padding: 8px 0px;
    font-size: 16px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #959087;
    -unity-text-align: middle-left;
    transition: color 200ms;
}

.settings-close-btn:hover {
    color: #ffb4ab;
}

/* ============================================================
   RIGHT CONTENT (2/3)
   ============================================================ */

.settings-right {
    width: 67%;
    padding: 64px 48px 48px 48px;
    flex-direction: column;
    overflow: hidden;
}

/* ===== PANEL ===== */
.settings-panel {
    flex-grow: 1;
    flex-direction: column;
    gap: 20px;
    overflow-y: auto;
}

.settings-panel.hidden {
    display: none;
}

/* ===== PANEL HEADER ===== */
.settings-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom-width: 1px;
    border-bottom-color: rgba(149, 144, 135, 0.5);
    padding-bottom: 12px;
    margin-bottom: 8px;
}

.settings-panel-header-title {
    font-size: 32px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
}

.settings-panel-header-rec {
    font-size: 18px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
}

/* ===== SETTING ITEM ===== */
.settings-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(149, 144, 135, 0.15);
}

.settings-item--slider {
    flex-direction: column;
    align-items: flex-start;
}

.settings-item-info {
    flex-direction: column;
}

.settings-item-label {
    font-size: 20px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
}

.settings-item-hint {
    font-size: 14px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-top: 2px;
}

.settings-item-control {
    margin-left: 16px;
}

/* ===== DROPDWON ===== */
.settings-dropdown {
    min-width: 180px;
    font-size: 16px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #e8e1d4;
    background-color: #1f201c;
    border-width: 1px;
    border-color: #959087;
    padding: 8px 16px;
}

/* ===== TOGGLE ===== */
.settings-toggle {
    margin-left: 16px;
}

/* ===== SLIDER ===== */
.settings-slider {
    width: 100%;
    margin-top: 12px;
}

.settings-slider-value {
    font-size: 16px;
    color: #E8B262;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-top: 4px;
    text-align: right;
}

/* ===== DELETE BUTTON ===== */
.settings-delete-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #B23A3A;
    padding: 8px 16px;
    font-size: 14px;
    color: #ffb4ab;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    transition: all 150ms linear;
}

.settings-delete-btn:hover {
    background-color: rgba(178, 176, 58, 0.15);
    border-color: #ffb4ab;
}

/* ===== ACTION BAR ===== */
.settings-actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: auto;
    padding-top: 24px;
    border-top-width: 1px;
    border-top-color: #e8e1d4;
    gap: 16px;
}

.settings-action-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #e8e1d4;
    padding: 14px 32px;
    font-size: 16px;
    color: #e8e1d4;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition: all 150ms linear;
}

.settings-action-btn:hover {
    background-color: rgba(232, 225, 212, 0.1);
}

.settings-action-btn--primary {
    color: #E8B262;
    border-color: #E8B262;
}

.settings-action-btn--primary:hover {
    background-color: rgba(232, 178, 98, 0.1);
}