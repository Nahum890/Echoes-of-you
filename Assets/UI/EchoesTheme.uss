/* ============================================================
   ECHOES OF YOU 2.0 — DESIGN SYSTEM: NOSTALGIA DEGRADADA
   Estilo de Escuela Liminal y Memoria Analógica (PS1/PS2/CRT)
   ============================================================ */
/* Variables :root removed to bypass Unity variable resolver crashes */

/* ============================================================
   BASE LAYOUTS & CONTAINERS
   ============================================================ */

.root-fullscreen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.root-fullscreen-opaque {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: #0A0A0D;
}

.hidden {
    display: none;
}

.disabled {
    opacity: 0.3;
}

/* ============================================================
   CRT & VHS EFFECT OVERLAYS
   ============================================================ */

.crt-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    opacity: 0.06;
}

/* Efecto de Viñeta CRT */
.crt-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    border-left-width: 12px;
    border-right-width: 12px;
    border-top-width: 12px;
    border-bottom-width: 12px;
    border-color: #0A0A0D;
}

/* ============================================================
   TYPOGRAPHY CLASSES
   ============================================================ */

.font-mono {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
}

.font-mono-bold {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
}

.font-serif {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
}

.font-serif-bold {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
}

/* Headings */
.text-headline-xl {
    font-size: 36px;
    letter-spacing: 1px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    color: #FFBF00;
    -unity-text-align: middle-left;
}

.text-headline-md {
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    color: #D9E4C0;
}

/* Body & Labels */
.text-body-lg {
    font-size: 18px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    color: #E8ECF2;
    white-space: normal;
    line-height: 26px;
}

.text-body-sm {
    font-size: 14px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #C8D0DC;
    white-space: normal;
}

.text-label-caps {
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    -unity-text-transform: uppercase;
    color: #C9D4B0;
}

/* ============================================================
   SCHOOL FILE FOLDER LAYOUT (MAIN MENU) — REDISEÑO AAA
   ============================================================ */

.main-menu-folder {
    /* Ocupa toda la pantalla con un fondo sólido oscuro para
       que sea legible contra cualquier fondo de escena 3D */
    background-color: #06080C;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(255, 191, 0, 0.3);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
}

.side-nav {
    width: 420px;
    background-color: #030406;
    border-right-width: 1px;
    border-right-color: rgba(255, 191, 0, 0.2);
    padding: 48px 32px;
    justify-content: space-between;
    flex-shrink: 0;
}

.folder-tabs-group {
    flex-direction: column;
}

/* Estilo fallback del nav-item (cuando nav-item-v2 no está activo) */
.nav-item {
    padding: 16px 20px;
    color: rgba(220, 225, 235, 0.85);
    background-color: transparent;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: transparent;
    -unity-text-align: middle-left;
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    -unity-text-transform: uppercase;
    margin-bottom: 4px;
    transition-property: color, background-color, border-left-color;
    transition-duration: 0.15s;
}

.nav-item:hover {
    color: #C9D4B0;
    background-color: rgba(201, 212, 176, 0.06);
    border-left-color: rgba(201, 212, 176, 0.6);
}

.nav-item--active {
    color: #FFBF00;
    background-color: rgba(255, 191, 0, 0.08);
    border-left-color: #FFBF00;
    border-left-width: 3px;
}

/* Área de contenido de la derecha */
#right-content-container {
    position: absolute;
    left: 420px;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #090B0F;
    border-left-width: 1px;
    border-left-color: rgba(201, 212, 176, 0.08);
}

/* Selector combinado por si el C# lo usa */
.main-content {
    position: absolute;
    left: 420px;
    top: 0;
    right: 0;
    bottom: 0;
}

.preview-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 56px 48px;
    display: none;
    flex-direction: column;
}

.preview-panel--visible {
    display: flex;
}

/* ============================================================
   WIDGETS & MARCADORES / RECUENTO — REDISEÑO
   ============================================================ */

.accent-line {
    height: 1px;
    width: 100%;
    background-color: rgba(255, 191, 0, 0.4);
    margin-bottom: 28px;
    margin-top: 8px;
}

.terminal-log-box {
    min-height: 100px;
    padding: 12px 16px;
    background-color: #04060A;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
    border-radius: 2px;
}

.terminal-log-line {
    font-size: 13px;
    color: #DCE4D0;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-bottom: 5px;
    white-space: normal;
}

.telemetry-row {
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: wrap;
}

.telemetry-chip {
    min-width: 22%;
    padding: 12px 10px;
    background-color: #0C1018;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.15);
    align-items: center;
    margin-bottom: 8px;
    margin-right: 8px;
}

.telemetry-chip-label {
    font-size: 11px;
    color: #8C96A5;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    -unity-text-transform: uppercase;
    letter-spacing: 1px;
}

.telemetry-chip-value {
    font-size: 22px;
    color: #FFBF00;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-top: 4px;
}

/* ============================================================
   LEVEL SELECT CARDS (VHS TAPE METAPHOR) — REDISEÑO
   ============================================================ */

.level-card {
    background-color: #0A0E14;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
    padding: 14px 16px;
    margin-bottom: 8px;
    flex-direction: row;
    justify-content: space-between;
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.level-card:hover {
    border-color: rgba(201, 212, 176, 0.6);
    background-color: rgba(201, 212, 176, 0.05);
}

.level-card--active {
    border-color: #FFBF00;
    background-color: rgba(255, 191, 0, 0.08);
}

.level-button--locked {
    opacity: 0.3;
    border-color: rgba(201, 212, 176, 0.05);
}

.level-button--completed {
    border-color: rgba(255, 191, 0, 0.5);
    background-color: rgba(255, 191, 0, 0.06);
}

.preset-button--active {
    border-color: #FFBF00;
    background-color: rgba(255, 191, 0, 0.16);
    color: #FFBF00;
}

/* Escala de UI / texto de menú (aplicada sobre el root) */
.scale-large {
    scale: 1.12 1.12;
}

.scale-xl {
    scale: 1.25 1.25;
}

/* Polaroid image container */
.polaroid-frame {
    background-color: #E6E8EA;
    padding: 8px;
    border-width: 1px;
    border-color: #C0C4C8;
    width: 180px;
    height: 220px;
    align-items: center;
    justify-content: space-between;
}

.polaroid-photo {
    width: 164px;
    height: 164px;
    background-color: #0A0A0D;
}

.polaroid-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    color: #20242A;
    font-size: 11px;
    -unity-text-align: middle-center;
}

/* ============================================================
   SETTINGS CONTROLS (OSD MONITOR STYLE)
   ============================================================ */

.settings-group-title {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 18px;
    color: #FFBF00;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 191, 0, 0.3);
    padding-bottom: 6px;
    margin-bottom: 18px;
    -unity-text-transform: uppercase;
    letter-spacing: 2px;
}

/* Unity slider overrides */
.unity-slider {
    margin-bottom: 16px;
}

.unity-slider .unity-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #FFFFFF;
    font-size: 16px;
    width: 200px;
}

.unity-slider .unity-base-slider__tracker {
    background-color: rgba(4, 6, 12, 0.9);
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
    height: 8px;
}

.unity-slider .unity-base-slider__dragger {
    background-color: #C9D4B0;
    width: 14px;
    height: 14px;
    border-radius: 0px;
}

/* Buttons in panels (settings, stability map, etc.) */
.btn-classic {
    padding: 10px 18px;
    background-color: #080A10;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.4);
    color: #C9D4B0;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 15px;
    -unity-text-transform: uppercase;
    letter-spacing: 1px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.1s;
}

.btn-classic:hover {
    background-color: rgba(201, 212, 176, 0.12);
    color: #E0E8D0;
    border-color: rgba(201, 212, 176, 0.8);
}

.btn-classic-accent {
    border-color: rgba(255, 191, 0, 0.7);
    color: #FFBF00;
}

.btn-classic-accent:hover {
    background-color: rgba(255, 191, 0, 0.15);
    color: #F5C87A;
    border-color: #FFBF00;
}

/* Dropdown override */
.unity-dropdown-field .unity-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #FFFFFF;
    font-size: 15px;
    width: 220px;
}

.unity-dropdown-field .unity-base-popup-field__input {
    background-color: #06080C;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.3);
    color: #FFFFFF;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    font-size: 15px;
    padding: 6px;
}

/* Toggle override */
.unity-toggle .unity-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #FFFFFF;
    font-size: 15px;
    width: 220px;
}

.unity-toggle .unity-toggle__checkmark {
    background-color: #0A0A0D;
    border-width: 1px;
    border-color: #2B4A4A;
    width: 16px;
    height: 16px;
    border-radius: 0px;
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-image: none;
    background-color: #FFBF00;
}

/* ============================================================
   GAME OVER SCREEN (CRT STATIC STATE)
   ============================================================ */

.gameover-overlay {
    background-color: #0A0A0D;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.gameover-title {
    font-size: 32px;
    color: #B23A3A;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 2px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.gameover-subtitle {
    font-size: 14px;
    color: #8C96A5;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    max-width: 450px;
    -unity-text-align: middle-center;
    line-height: 20px;
    margin-bottom: 48px;
}

/* ============================================================
   GAMEPLAY HUD (CASSETTE RECORDER / ANALOG TAPE)
   ============================================================ */

/* Recording bar (top-left) */
.hud-record-panel {
    position: absolute;
    left: 32px;
    top: 32px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 13, 0.92);
    border-width: 1px;
    border-color: #2B4A4A;
    padding: 8px 16px;
}

.hud-record-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #B23A3A;
    margin-right: 12px;
}

.hud-echo-icon {
    width: 10px;
    height: 10px;
    background-color: #C9D4B0;
    margin-right: 12px;
}

.hud-record-bar-bg {
    width: 140px;
    height: 6px;
    background-color: #1A222C;
    border-width: 1px;
    border-color: #2B4A4A;
}

.hud-record-bar-fill {
    height: 100%;
    background-color: #C9D4B0;
    width: 0%;
}

.hud-echo-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 11px;
    color: #FFBF00;
    margin-left: 12px;
}

.hud-echo-slots-container {
    flex-direction: row;
    margin-left: 12px;
}

.hud-echo-slot {
    width: 6px;
    height: 6px;
    border-width: 1px;
    border-color: #2B4A4A;
    margin-right: 4px;
}

.hud-echo-slot--filled {
    background-color: #FFBF00;
}

/* HUD Bars (top-right) */
.hud-container {
    position: absolute;
    right: 32px;
    top: 32px;
    flex-direction: column;
}

.hud-bar-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.hud-bar-bg {
    width: 120px;
    height: 6px;
    background-color: #1A222C;
    border-width: 1px;
    border-color: #2B4A4A;
    margin-right: 12px;
}

.hud-bar-fill {
    height: 100%;
}

.hud-bar-fill--stability {
    background-color: #C9D4B0;
}

.hud-bar-fill--recall {
    background-color: #FFBF00;
}

.hud-bar-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 9px;
    color: #6C788A;
    width: 60px;
    -unity-text-align: middle-left;
}

/* Center HUD & Prompt Area */
.hud-objective-area {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 96px;
    align-items: center;
}

.hud-objective-text {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    font-size: 17px;
    color: #E2E6EC;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.hud-toast-area {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 120px;
    align-items: center;
    background-color: rgba(10, 10, 13, 0.92);
    border-width: 1px;
    border-color: #2B4A4A;
    padding: 8px 16px;
}

.hud-toast-text {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    font-size: 12px;
    color: #DCE4D0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud-echo-state-area {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 80px;
    align-items: center;
}

.hud-echo-state-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 12px;
    color: #F5C87A;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* Bottom Footer (Tape Status) */
.footer-status {
    position: absolute;
    right: 32px;
    bottom: 32px;
    flex-direction: row;
}

.footer-item {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
    opacity: 0.45;
}

.footer-item--active {
    opacity: 1;
}

.footer-item--inactive {
    opacity: 0.35;
}

.footer-icon {
    font-size: 12px;
    color: #D9E4D0;
    margin-right: 6px;
}

.footer-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    font-size: 11px;
    color: #8C96A5;
}

/* ============================================================
   DIALOGUE OVERLAY (NOTEBOOK PAPER METAPHOR)
   ============================================================ */

.dialogue-overlay {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 40px;
    background-color: #F4F2EE;
    border-width: 1px;
    border-color: #C0BAB4;
    padding: 20px 24px;
    min-height: 80px;
    flex-direction: row;
}

.dialogue-text {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    font-size: 14px;
    color: #2D2A26;
    white-space: normal;
    line-height: 18px;
    flex-grow: 1;
}

.dialogue-next-prompt {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 9px;
    color: #A0968E;
    -unity-text-align: bottom-right;
    width: 48px;
}

/* ============================================================
   CHALKBOARD DICTIONARY / TUTORIAL
   ============================================================ */

.chalkboard-box {
    background-color: rgba(58, 74, 56, 0.95); /* Sage Green opacity */
    border-width: 3px;
    border-color: #503E2D; /* Wooden Chalkboard Frame */
    padding: 24px;
    width: 380px;
    height: 280px;
    position: absolute;
    left: 40px;
    bottom: 40px;
}

.chalkboard-title {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    font-size: 16px;
    color: #DCE6D9;
    border-bottom-width: 1px;
    border-bottom-color: rgba(220, 230, 217, 0.3);
    padding-bottom: 6px;
    margin-bottom: 12px;
}

.chalkboard-text {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    font-size: 12px;
    color: #C2D0BE;
    white-space: normal;
    line-height: 16px;
}

/* ============================================================
   PAUSE MENU STYLES — REDISEÑO AAA
   ============================================================ */

.pause-notebook {
    width: 460px;
    background-color: #05070A;
    border-width: 1px;
    border-color: rgba(255, 191, 0, 0.35);
    border-left-width: 4px;
    border-left-color: #FFBF00;
    padding: 48px 36px;
    position: absolute;
    left: 80px;
    top: 0;
    bottom: 0;
    justify-content: space-between;
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.85);
}

.pause-title {
    font-size: 32px;
    color: #FFBF00;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.pause-btn {
    padding: 14px 20px;
    background-color: transparent;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: transparent;
    color: #FFFFFF;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 16px;
    -unity-text-align: middle-left;
    -unity-text-transform: uppercase;
    margin-bottom: 8px;
    transition-property: color, background-color, border-left-color;
    transition-duration: 0.12s;
}

.pause-btn:hover {
    color: #C9D4B0;
    background-color: rgba(201, 212, 176, 0.08);
    border-left-color: rgba(201, 212, 176, 0.6);
}

/* Pause settings specific panel overlay */
#pause-settings-panel {
    position: absolute;
    left: 580px; /* Al lado del notebook */
    top: 48px;
    right: 48px;
    bottom: 48px;
    background-color: #080A0E;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
    padding: 48px;
    flex-direction: column;
}

/* ============================================================
   UNITY DROPDOWN POPUP & SLIDER TRACKER SOLID OVERRIDES
   ============================================================ */

.unity-base-slider__tracker {
    background-color: #04060C !important;
    border-color: rgba(201, 212, 176, 0.4) !important;
}

.unity-base-dropdown__container {
    background-color: #080A0E !important;
    border-width: 1px !important;
    border-color: #FFBF00 !important;
}

.unity-base-dropdown__item {
    background-color: transparent !important;
}

.unity-base-dropdown__item .unity-label {
    color: #FFFFFF !important;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf') !important;
    font-size: 14px !important;
}

.unity-base-dropdown__item:hover {
    background-color: rgba(255, 191, 0, 0.12) !important;
}

.unity-base-dropdown__item:hover .unity-label {
    color: #FFBF00 !important;
}


