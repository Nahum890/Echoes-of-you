/* ============================================================
   ECHOES OF YOU 2.0 â€” DESIGN SYSTEM: NOSTALGIA DEGRADADA
   Estilo de Escuela Liminal y Memoria AnalÃ³gica (PS1/PS2/CRT)
   ============================================================ */
/* Variables :root removed to bypass Unity variable resolver crashes */

/* ============================================================
   BASE LAYOUTS & CONTAINERS
   ============================================================ */

.root-fullscreen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.root-fullscreen-opaque {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: #0A0A0D;
}

.hidden {
    display: none;
}

.disabled {
    opacity: 0.3;
}

/* ============================================================
   CRT & VHS EFFECT OVERLAYS
   ============================================================ */

.crt-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    opacity: 0.12;
}

/* Efecto de ViÃ±eta CRT */
.crt-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    border-left-width: 12px;
    border-right-width: 12px;
    border-top-width: 12px;
    border-bottom-width: 12px;
    border-color: #0A0A0D;
}

/* ============================================================
   TYPOGRAPHY CLASSES
   ============================================================ */

.font-mono {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
}

.font-mono-bold {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
}

.font-serif {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
}

.font-serif-bold {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
}

/* Headings */
.text-headline-xl {
    font-size: 38px;
    letter-spacing: 2px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    color: #E8B262;
    -unity-text-align: middle-center;
}

.text-headline-md {
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    color: #C9D4B0;
}

/* Body & Labels */
.text-body-lg {
    font-size: 16px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    color: #E2E4E8;
    white-space: normal;
    line-height: 22px;
}

.text-body-sm {
    font-size: 12px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #9AA0AA;
    white-space: normal;
}

.text-label-caps {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    -unity-text-transform: uppercase;
    color: #C9D4B0;
}

/* ============================================================
   SCHOOL FILE FOLDER LAYOUT (MAIN MENU)
   ============================================================ */

.main-menu-folder {
    background-color: #2B4A4A;
    border-width: 2px;
    border-color: #1C2430;
    position: absolute;
    left: 48px;
    top: 48px;
    right: 48px;
    bottom: 48px;
    flex-direction: row;
}

.side-nav {
    width: 280px;
    background-color: rgba(10, 10, 13, 0.95);
    border-right-width: 2px;
    border-right-color: #1C2430;
    padding: 32px 16px;
    justify-content: space-between;
}

.folder-tabs-group {
    flex-direction: column;
}

.nav-item {
    padding: 12px 16px;
    color: #8C96A5;
    background-color: transparent;
    border-width: 0;
    border-left-width: 0;
    -unity-text-align: middle-left;
    font-size: 11px;
    letter-spacing: 1.5px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    -unity-text-transform: uppercase;
    margin-bottom: 8px;
    transition-property: color, background-color;
    transition-duration: 0.15s;
}

.nav-item:hover {
    color: #0A0A0D;
    background-color: #C9D4B0;
}

.nav-item--active {
    color: #0A0A0D;
    background-color: #E8B262;
}

/* right content */
.main-content, #right-content-container {
    position: absolute;
    left: 280px;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #1C2430;
}

.preview-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 48px;
    display: none;
}

.preview-panel--visible {
    display: flex;
}

/* ============================================================
   WIDGETS & TELEMETRY
   ============================================================ */

.accent-line {
    height: 1px;
    width: 100%;
    background-color: #C9D4B0;
    margin-bottom: 24px;
}

.terminal-log-box {
    height: 120px;
    padding: 8px;
    background-color: #0A0A0D;
    border-width: 1px;
    border-color: #2B4A4A;
}

.terminal-log-line {
    font-size: 10px;
    color: #C9D4B0;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-bottom: 4px;
}

.telemetry-row {
    flex-direction: row;
    justify-content: space-between;
}

.telemetry-chip {
    width: 22%;
    padding: 8px;
    background-color: #0A0A0D;
    border-width: 1px;
    border-color: #2B4A4A;
    align-items: center;
}

.telemetry-chip-label {
    font-size: 9px;
    color: #6C788A;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    -unity-text-transform: uppercase;
}

.telemetry-chip-value {
    font-size: 18px;
    color: #E8B262;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-top: 4px;
}

/* ============================================================
   LEVEL SELECT PREVIEW CARDS (VHS TAPE METAPHOR)
   ============================================================ */

.level-card {
    background-color: #0A0A0D;
    border-width: 1px;
    border-color: #2B4A4A;
    padding: 12px;
    margin-bottom: 12px;
    flex-direction: row;
    justify-content: space-between;
}

.level-card:hover {
    border-color: #C9D4B0;
}

.level-card--active {
    border-color: #E8B262;
    background-color: rgba(28, 36, 48, 0.8);
}

/* Polaroid image container */
.polaroid-frame {
    background-color: #E6E8EA;
    padding: 8px;
    border-width: 1px;
    border-color: #C0C4C8;
    width: 180px;
    height: 220px;
    align-items: center;
    justify-content: space-between;
}

.polaroid-photo {
    width: 164px;
    height: 164px;
    background-color: #0A0A0D;
}

.polaroid-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    color: #20242A;
    font-size: 11px;
    -unity-text-align: middle-center;
}

/* ============================================================
   SETTINGS CONTROLS (OSD MONITOR STYLE)
   ============================================================ */

.settings-group-title {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 13px;
    color: #E8B262;
    border-bottom-width: 1px;
    border-bottom-color: #2B4A4A;
    padding-bottom: 4px;
    margin-bottom: 16px;
    -unity-text-transform: uppercase;
}

/* Unity slider overrides */
.unity-slider {
    margin-bottom: 16px;
}

.unity-slider .unity-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #E2E4E8;
    font-size: 11px;
    width: 160px;
}

.unity-slider .unity-base-slider__tracker {
    background-color: #0A0A0D;
    border-width: 1px;
    border-color: #2B4A4A;
    height: 8px;
}

.unity-slider .unity-base-slider__dragger {
    background-color: #C9D4B0;
    width: 14px;
    height: 14px;
    border-radius: 0px;
}

/* Buttons in settings */
.btn-classic {
    padding: 8px 16px;
    background-color: #0A0A0D;
    border-width: 1px;
    border-color: #2B4A4A;
    color: #C9D4B0;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 11px;
    -unity-text-transform: uppercase;
    transition-property: background-color, border-color, color;
    transition-duration: 0.1s;
}

.btn-classic:hover {
    background-color: #C9D4B0;
    color: #0A0A0D;
    border-color: #C9D4B0;
}

.btn-classic-accent {
    border-color: #E8B262;
    color: #E8B262;
}

.btn-classic-accent:hover {
    background-color: #E8B262;
    color: #0A0A0D;
    border-color: #E8B262;
}

/* Dropdown override */
.unity-dropdown-field .unity-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #E2E4E8;
    font-size: 11px;
    width: 160px;
}

.unity-dropdown-field .unity-base-popup-field__input {
    background-color: #0A0A0D;
    border-width: 1px;
    border-color: #2B4A4A;
    color: #C9D4B0;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    font-size: 11px;
    padding: 4px;
}

/* Toggle override */
.unity-toggle .unity-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    color: #E2E4E8;
    font-size: 11px;
    width: 160px;
}

.unity-toggle .unity-toggle__checkmark {
    background-color: #0A0A0D;
    border-width: 1px;
    border-color: #2B4A4A;
    width: 16px;
    height: 16px;
    border-radius: 0px;
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-image: none;
    background-color: #C9D4B0;
}

/* ============================================================
   PAUSE MENU (NOTEBOOK LEAF METAPHOR)
   ============================================================ */

.pause-notebook {
    background-color: #EAE8E6;
    border-width: 2px;
    border-color: #A6A09A;
    position: absolute;
    width: 480px;
    top: 64px;
    bottom: 64px;
    left: 50%;
    margin-left: -240px;
    padding: 48px;
    justify-content: space-between;
}

.pause-title {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    font-size: 24px;
    color: #383430;
    border-bottom-width: 1px;
    border-bottom-color: #C0BAB4;
    padding-bottom: 8px;
    -unity-text-align: middle-center;
}

.pause-btn {
    background-color: transparent;
    border-width: 0;
    color: #5A544E;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    font-size: 16px;
    -unity-text-align: middle-left;
    padding: 10px 0px;
    transition-property: color;
    transition-duration: 0.15s;
}

.pause-btn:hover {
    color: #B23A3A;
}

/* ============================================================
   GAME OVER SCREEN (CRT STATIC STATE)
   ============================================================ */

.gameover-overlay {
    background-color: #0A0A0D;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.gameover-title {
    font-size: 32px;
    color: #B23A3A;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 2px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.gameover-subtitle {
    font-size: 14px;
    color: #8C96A5;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    max-width: 450px;
    -unity-text-align: middle-center;
    line-height: 20px;
    margin-bottom: 48px;
}

/* ============================================================
   GAMEPLAY HUD (CASSETTE RECORDER / ANALOG TAPE)
   ============================================================ */

/* Recording bar (top-left) */
.hud-record-panel {
    position: absolute;
    left: 32px;
    top: 32px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 13, 0.95);
    border-width: 1px;
    border-color: #2B4A4A;
    padding: 8px 16px;
}

.hud-record-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #B23A3A;
    margin-right: 12px;
}

.hud-echo-icon {
    width: 10px;
    height: 10px;
    background-color: #C9D4B0;
    margin-right: 12px;
}

.hud-record-bar-bg {
    width: 140px;
    height: 6px;
    background-color: #1A222C;
    border-width: 1px;
    border-color: #2B4A4A;
}

.hud-record-bar-fill {
    height: 100%;
    background-color: #C9D4B0;
    width: 0%;
}

.hud-echo-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 11px;
    color: #E8B262;
    margin-left: 12px;
}

.hud-echo-slots-container {
    flex-direction: row;
    margin-left: 12px;
}

.hud-echo-slot {
    width: 6px;
    height: 6px;
    border-width: 1px;
    border-color: #2B4A4A;
    margin-right: 4px;
}

.hud-echo-slot--filled {
    background-color: #E8B262;
}

/* HUD Bars (top-right) */
.hud-container {
    position: absolute;
    right: 32px;
    top: 32px;
    flex-direction: column;
}

.hud-bar-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.hud-bar-bg {
    width: 120px;
    height: 6px;
    background-color: #1A222C;
    border-width: 1px;
    border-color: #2B4A4A;
    margin-right: 12px;
}

.hud-bar-fill {
    height: 100%;
}

.hud-bar-fill--stability {
    background-color: #C9D4B0;
}

.hud-bar-fill--recall {
    background-color: #E8B262;
}

.hud-bar-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 9px;
    color: #6C788A;
    width: 60px;
    -unity-text-align: middle-left;
}

/* Center HUD & Prompt Area */
.hud-objective-area {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 96px;
    align-items: center;
}

.hud-objective-text {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    font-size: 15px;
    color: #C2C6CC;
    -unity-text-align: middle-center;
}

.hud-toast-area {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 120px;
    align-items: center;
    background-color: rgba(10, 10, 13, 0.95);
    border-width: 1px;
    border-color: #2B4A4A;
    padding: 8px 16px;
}

.hud-toast-text {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    font-size: 11px;
    color: #C9D4B0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud-echo-state-area {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 80px;
    align-items: center;
}

.hud-echo-state-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 10px;
    color: #E8B262;
}

/* Bottom Footer (Tape Status) */
.footer-status {
    position: absolute;
    right: 32px;
    bottom: 32px;
    flex-direction: row;
}

.footer-item {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
    opacity: 0.2;
}

.footer-item--active {
    opacity: 1;
}

.footer-icon {
    font-size: 12px;
    color: #C9D4B0;
    margin-right: 6px;
}

.footer-label {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    font-size: 10px;
    color: #6C788A;
}

/* ============================================================
   DIALOGUE OVERLAY (NOTEBOOK PAPER METAPHOR)
   ============================================================ */

.dialogue-overlay {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 40px;
    background-color: #F4F2EE;
    border-width: 1px;
    border-color: #C0BAB4;
    padding: 20px 24px;
    min-height: 80px;
    flex-direction: row;
}

.dialogue-text {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    font-size: 14px;
    color: #2D2A26;
    white-space: normal;
    line-height: 18px;
    flex-grow: 1;
}

.dialogue-next-prompt {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    font-size: 9px;
    color: #A0968E;
    -unity-text-align: bottom-right;
    width: 48px;
}

/* ============================================================
   CHALKBOARD DICTIONARY / TUTORIAL
   ============================================================ */

.chalkboard-box {
    background-color: rgba(58, 74, 56, 0.95); /* Sage Green opacity */
    border-width: 3px;
    border-color: #503E2D; /* Wooden Chalkboard Frame */
    padding: 24px;
    width: 380px;
    height: 280px;
    position: absolute;
    left: 40px;
    bottom: 40px;
}

.chalkboard-title {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    font-size: 16px;
    color: #DCE6D9;
    border-bottom-width: 1px;
    border-bottom-color: rgba(220, 230, 217, 0.3);
    padding-bottom: 6px;
    margin-bottom: 12px;
}

.chalkboard-text {
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    font-size: 12px;
    color: #C2D0BE;
    white-space: normal;
    line-height: 16px;
}

