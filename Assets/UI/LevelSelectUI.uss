/* ============================================================
   LevelSelectUI — STITCH ÍNDICE DE RECUERDOS
   Basado en el mockup HTML de "Índice de Recuerdos"
   ============================================================ */

@import "EchoesDesignTokens.uss";

/* ===== ROOT ===== */
.level-select-stitch-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #131410;
    overflow: hidden;
}

.lvl-bg-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #131410;
    opacity: 0.90;
}

.lvl-scanline-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.08;
    background-color: transparent;
}

/* ===== MAIN LAYOUT ===== */
.lvl-main {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
}

/* ============================================================
   LEFT SIDEBAR (320px)
   ============================================================ */

.lvl-sidebar {
    width: 320px;
    flex-shrink: 0;
    background-color: rgba(19, 20, 16, 0.92);
    border-right-width: 1px;
    border-right-color: rgba(74, 70, 63, 0.4);
    padding-top: 64px;
    padding-bottom: 48px;
    padding-left: 48px;
    padding-right: 32px;
    flex-direction: column;
    justify-content: space-between;
}

.lvl-sidebar-header {
    margin-bottom: 32px;
}

.lvl-logo-title {
    font-size: 28px;
    color: #fffeff;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    letter-spacing: -0.5px;
}

.lvl-logo-subtitle {
    font-size: 13px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    letter-spacing: 1.5px;
    margin-top: 4px;
}

/* ===== NAV LINKS ===== */

.lvl-nav-list {
    flex-grow: 1;
    flex-direction: column;
    gap: 8px;
    margin-top: 16px;
}

.lvl-nav-item-wrapper {
    position: relative;
    border-left-width: 2px;
    border-left-color: transparent;
    transition-property: background-color, border-left-color;
    transition-duration: 200ms;
}

.lvl-nav-item-wrapper--active {
    border-left-color: #fffeff;
    background-color: rgba(255, 254, 255, 0.08);
}

.lvl-nav-item {
    font-size: 15px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 3px;
    padding: 12px 16px;
    transition-property: color, translate;
    transition-duration: 200ms;
}

.lvl-nav-item-wrapper:hover .lvl-nav-item {
    color: #63d4fa;
    translate: 4px 0px;
}

.lvl-nav-item--active {
    color: #fffeff;
}

/* ===== EXIT BTN ===== */
.lvl-exit-btn {
    background-color: transparent;
    border-width: 0px;
    padding: 16px 0;
    font-size: 15px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 2.5px;
    -unity-text-align: middle-left;
    border-top-width: 1px;
    border-top-color: rgba(149, 144, 135, 0.2);
    transition-property: color;
    transition-duration: 200ms;
}

.lvl-exit-btn:hover {
    color: #ffb4ab;
}

/* ============================================================
   RIGHT CONTENT CANVAS
   ============================================================ */

.lvl-content {
    flex-grow: 1;
    padding-top: 56px;
    padding-bottom: 48px;
    padding-left: 64px;
    padding-right: 64px;
    flex-direction: column;
    overflow: hidden;
}

.lvl-content-header {
    margin-bottom: 32px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(149, 144, 135, 0.25);
    padding-bottom: 16px;
}

.lvl-header-tag {
    font-size: 14px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.lvl-header-title {
    font-size: 56px;
    color: #fffeff;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    letter-spacing: -1.5px;
}

/* ===== CHAPTER LIST SCROLLVIEW ===== */

.lvl-chapter-list {
    flex-grow: 1;
    padding-right: 16px;
}

/* ===== CHAPTER ENTRY (Card) ===== */
.lvl-chapter {
    flex-direction: column;
    border-bottom-width: 1px;
    border-bottom-color: rgba(149, 144, 135, 0.35);
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    margin-left: -24px;
    border-left-width: 2px;
    border-left-color: transparent;
    transition-property: background-color, border-left-color;
    transition-duration: 250ms;
}

.lvl-chapter:hover {
    background-color: rgba(57, 57, 53, 0.25);
    border-left-color: #959087;
}

/* Active (expanded) chapter */
.lvl-chapter--active {
    background-color: rgba(68, 76, 89, 0.08);
    border-left-color: #fffeff;
}

.lvl-chapter--active:hover {
    border-left-color: #fffeff;
}

/* Locked chapter */
.lvl-chapter--locked {
    opacity: 0.45;
}

/* ===== CHAPTER MAIN ROW ===== */
.lvl-chapter-main {
    flex-direction: row;
    align-items: flex-start;
    gap: 24px;
}

/* ===== THUMBNAIL ===== */
.lvl-chapter-thumb {
    width: 96px;
    height: 68px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(149, 144, 135, 0.3);
    overflow: hidden;
    position: relative;
    background-color: #1b1c18;
}

.lvl-chapter-thumb--active {
    width: 128px;
    height: 96px;
    border-color: #63d4fa;
}

.lvl-chapter-thumb--locked {
    border-color: rgba(147, 0, 10, 0.4);
    background-color: #1a1515;
}

.lvl-chapter-thumb-placeholder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #242521;
}

.lvl-chapter-thumb-scanline {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(99, 212, 250, 0.06);
}

.lvl-chapter-thumb-err {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: #ffb4ab;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
}

/* ===== CHAPTER METADATA ===== */
.lvl-chapter-meta {
    flex-grow: 1;
    flex-direction: column;
}

.lvl-chapter-meta-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
}

.lvl-chapter-rec {
    font-size: 14px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 1.5px;
}

.lvl-chapter-rec--locked {
    color: rgba(255, 180, 171, 0.85);
}

.lvl-meta-dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: #4a463f;
}

.lvl-meta-dot--locked {
    background-color: rgba(147, 0, 10, 0.6);
}

.lvl-chapter-location {
    font-size: 14px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 1.2px;
}

.lvl-chapter-location--locked {
    color: rgba(255, 180, 171, 0.85);
}

.lvl-chapter-progress {
    font-size: 14px;
    color: #63d4fa;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-left: auto;
    letter-spacing: 1px;
}

.lvl-chapter-progress--dim {
    color: #959087;
}

.lvl-chapter-progress--locked {
    color: rgba(255, 180, 171, 0.85);
}

/* Title container with echo effect */
.lvl-title-container {
    position: relative;
    margin-bottom: 4px;
}

.lvl-chapter-title-echo {
    position: absolute;
    left: 6px;
    top: 4px;
    font-size: 40px;
    color: #63d4fa;
    opacity: 0.30;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    pointer-events: none;
}

.lvl-chapter-title {
    font-size: 40px;
    color: #fffeff;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    letter-spacing: -0.5px;
}

/* Collapsed Title Button */
.lvl-chapter-btn-title {
    background-color: transparent;
    border-width: 0px;
    padding: 0;
    margin: 0;
    font-size: 32px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    -unity-text-align: middle-left;
    transition-property: color, translate;
    transition-duration: 200ms;
}

.lvl-chapter-btn-title:hover {
    color: #fffeff;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    translate: 4px 0;
}

.lvl-chapter-btn-title--locked {
    color: rgba(228, 226, 220, 0.45);
    text-decoration: line-through;
}

/* ===== EXPANDED CONTENT ===== */
.lvl-chapter-expanded {
    margin-top: 14px;
    padding-left: 16px;
    border-left-width: 1px;
    border-left-color: rgba(149, 144, 135, 0.3);
}

.lvl-chapter-desc {
    font-size: 15px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    line-height: 22px;
    margin-bottom: 20px;
    white-space: normal;
}

.lvl-chapter-enter-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #959087;
    padding: 14px 28px;
    font-size: 14px;
    color: #fffeff;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    align-self: flex-start;
    transition-property: border-color, background-color, color, translate;
    transition-duration: 200ms;
}

.lvl-chapter-enter-btn:hover {
    border-color: #63d4fa;
    background-color: rgba(68, 76, 89, 0.35);
    color: #fffeff;
    translate: 2px 0px;
}

/* ===== BOTTOM PADDING ===== */
.lvl-bottom-padding {
    height: 64px;
}