/* ============================================================
   MainMenuUI — Estilos canónicos Fase 2
   Contraste ≥ 4.5:1. 0 opacidades bajas. Fondos sólidos.
   ============================================================ */

@import "EchoesDesignTokens.uss";
@import "Components/EchoButton.uss";
@import "Components/EchoPanel.uss";
@import "Components/EchoCard.uss";
@import "Components/EchoTabs.uss";
@import "Components/EchoModal.uss";
@import "Components/EchoToast.uss";
@import "Components/EchoLoading.uss";

/* ===== CRITICAL HARDCODED STYLES (bypass @import/var issues) ===== */
.root-fullscreen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
    background-color: transparent;
}

.void-intro {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: transparent; opacity: 0; display: none;
    padding: 0;
    transition: opacity 0.6s ease-out;
}

.void-intro__text {
    font-size: 30px;
    color: #F4F2EE;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.main-menu-folder {
    background-color: transparent;
    border-width: 0;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: row;
}

.menu-background {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url('../Images/menu_background.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.4;
    transition: opacity 0.3s, background-image 0.5s ease-in-out;
    pointer-events: none;
    z-index: -1;
}

.menu-background--hover-continuar {
    background-image: url('../Images/menu_background.png');
    opacity: 0.5;
}

.menu-background--hover-capitulos {
    background-image: url('../Images/void_fog_bg.png');
    opacity: 0.45;
}

.menu-background--hover-configurar {
    background-image: url('../Images/fragmenting_silhouette.png');
    opacity: 0.4;
}

.menu-background--hover-creditos {
    background-image: url('../Images/disconnect_bg.png');
    opacity: 0.35;
}

.menu-background--hover-cerrar {
    background-image: url('../Images/menu_background.png');
    opacity: 0.6;
}

.side-nav {
    width: 420px;
    height: 100%;
    background-color: rgba(19, 20, 16, 0.88);
    border-right-width: 2px;
    border-right-color: #4a463f;
    padding: 28px 24px;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
}
.side-nav__header { margin-bottom: 32px; flex-shrink: 0; }
.side-nav__hero { flex-shrink: 0; }
.folder-tabs-group { flex-direction: column; flex-grow: 1; }
.side-nav__footer { flex-shrink: 0; }

.menu-logo {
    width: 360px;
    height: 180px;
    background-image: url('project://database/Assets/UI/logo.png');
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
    margin-bottom: 28px;
    margin-top: 8px;
    opacity: 1;
}

.logo {
    width: 360px;
    height: 180px;
    background-image: url('project://database/Assets/UI/logo.png');
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
    margin-bottom: 28px;
    margin-top: 8px;
    opacity: 1;
}

.logo:hover {
    opacity: 1;
}

.side-nav__title {
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface);
    -unity-text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 4px;
    opacity: 1;
}
.side-nav__subtitle {
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface-variant);
    -unity-text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 1;
}

.side-nav__hero {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 212, 176, 0.2);
}

.hero-title {
    font-size: 24px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    letter-spacing: 1px;
    white-space: normal;
    opacity: 1;
}

.folder-tabs-group { flex-direction: column; }

.nav-item-v2 {
    justify-content: flex-start;
    margin-bottom: 10px;
    padding: 20px 24px;
    color: #e4e2dc;
    background-color: #1b1c18;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 5px;
    border-left-color: #E8B262;
    -unity-text-align: middle-left;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    transition-property: color, background-color, border-left-color, border-color, scale;
    transition-duration: 150ms;
    transition-timing-function: linear;
}

.nav-item-v2:hover {
    color: #fffeff;
    background-color: #2a2a26;
    border-left-color: #fffeff;
    border-color: #E8B262;
    scale: 1.02 1.02;
}

.nav-item-v2:active {
    background-color: #353530;
    scale: 0.98 0.98;
}

.side-nav__footer {
    margin-top: 24px;
    padding-top: 20px;
    border-top-width: 2px;
    border-top-color: #4a463f;
}

.side-nav__footer Label {
    font-size: 16px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-bottom: 6px;
    opacity: 1;
}

.right-content-container {
    position: absolute;
    left: 420px; top: 0; right: 0; bottom: 0;
    background-color: rgba(19, 20, 16, 0.82);
    border-left-width: 2px;
    border-left-color: #4a463f;
    overflow: hidden;
}

.preview-panel {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    padding: 56px 48px;
    display: none;
    flex-direction: column;
}

.preview-panel--visible { display: flex; }

.panel-title {
    font-size: var(--size-display-md);
    color: var(--color-stich-amber);
    margin-bottom: 32px;
    letter-spacing: 1px;
    opacity: 1;
}

.terminal-log-box {
    min-height: 100px;
    padding: 16px 20px;
    background-color: #0e0f0b;
    border-width: 1px;
    border-color: #4a463f;
    border-radius: 0;
}

.terminal-log-line {
    font-size: 18px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-bottom: 6px;
    white-space: normal;
    opacity: 1;
}

.accent-line {
    height: 2px;
    width: 100%;
    background-color: #E8B262;
    margin-bottom: 28px;
    margin-top: 8px;
}

.text-body-lg {
    font-size: 20px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    white-space: normal;
    opacity: 1;
}

.telemetry-row {
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: wrap;
}

.telemetry-chip {
    min-width: 22%;
    padding: 14px 12px;
    background-color: #1f201c;
    border-width: 1px;
    border-color: #4a463f;
    align-items: center;
    margin-bottom: 10px;
    margin-right: 10px;
}

.telemetry-chip-label {
    font-size: 14px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    letter-spacing: 1px;
    opacity: 1;
}

.telemetry-chip-value {
    font-size: 22px;
    color: #E8B262;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-top: 6px;
    opacity: 1;
}

.text-label-caps {
    font-size: 14px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    letter-spacing: 2px;
}
