/* ============================================================
   MainMenuUI — STITCH AESTHETIC (Archivo de Memoria)
   Alto contraste, alta opacidad, perfectamente legible
   ============================================================ */

@import "EchoesDesignTokens.uss";
@import "Components/EchoButton.uss";
@import "Components/EchoPanel.uss";
@import "Components/EchoCard.uss";
@import "Components/EchoTabs.uss";

/* ============================================================
   ROOT — Pantalla completa, fondo oscuro sólido
   ============================================================ */

.menu-stitch-root {
    background-color: transparent;
    overflow: hidden;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

/* ===== IMAGEN DE FONDO (transparente para ver el mundo 3D) ===== */
.menu-bg-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: none;
    opacity: 0;
}

/* ===== OVERLAY OSCURO (sutil, no bloquea el 3D) ===== */
.menu-bg-gradient {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
}

/* ===== SCANLINES (muy sutil) ===== */
.menu-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.03;
    background-color: transparent;
}

/* ===== NOISE (muy sutil) ===== */
.menu-noise {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.01;
    background-color: transparent;
}

/* ============================================================
   MAIN CONTENT — contenedor principal (fila: sidebar + panels)
   ============================================================ */

.main-menu-content {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: row;
}

/* FORCE-VISIBLE: override the generic .hidden rule that MainMenuController
   applies to main-content at startup. Without this the entire menu is display:none. */
.main-menu-content.hidden {
    display: flex !important;
}

/* ============================================================
   LEFT SIDEBAR — 420px, fondo oscuro sólido con alta opacidad
   ============================================================ */

.menu-sidebar {
    width: 480px;
    flex-shrink: 0;
    background-color: transparent;
    border-right-width: 1px;
    border-right-color: rgba(74, 70, 63, 0.3);
    padding-top: 48px;
    padding-bottom: 48px;
    padding-left: 32px;
    padding-right: 32px;
    flex-direction: column;
}

/* ===== LOGO ===== */
.menu-logo-area {
    margin-bottom: 40px;
    background-color: transparent;
}

.menu-logo-image {
    width: 320px;
    height: 120px;
    background-image: url('project://database/Assets/UI/logo.png');
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 8px;
}

.menu-logo-subtitle {
    font-size: 16px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    -unity-text-align: middle-left;
    letter-spacing: 2px;
    margin-top: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #4a463f;
    padding-bottom: 8px;
}

/* ============================================================
    NAVEGACIÓN — Stitch echo-hover style
    ============================================================ */

.menu-nav-list {
    flex-grow: 1;
    flex-direction: column;
}

/* Solo ajustar tipografía en botones que tengan AMBAS clases (.nav-item-v2 + .menu-nav-btn).
   Esto preserva TODOS los estilos canónicos de .nav-item-v2 (padding, background, border, hover, ghost, etc.) */
.nav-item-v2.menu-nav-btn {
    font-size: 22px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    white-space: normal;
}

/* Continue button — lit state (already handled by .nav-item--active in EchoesHoverEffects) */
.menu-nav-btn--continue {
    color: #fffeff;
}

/* Exit button — red tinted */
.menu-nav-btn--exit {
    color: #ffb4ab;
}

.menu-nav-btn--exit:hover {
    color: #ffdad6;
}

/* ===== GHOST LAYER ===== */
.menu-nav-ghost {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.menu-nav-ghost-text {
    font-size: 22px;
    -unity-text-align: middle-left;
    color: rgba(99, 212, 250, 0);
    padding-left: 0px;
}

/* ===== PROGRESS UNDER CONTINUAR ===== */
.menu-ctn-progress {
    margin-top: 4px;
    margin-bottom: 20px;
    padding-left: 12px;
    border-left-width: 1px;
    border-left-color: rgba(74, 70, 63, 0.3);
    background-color: transparent;
}

.menu-ctn-progress-label {
    font-size: 14px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
}

.menu-ctn-progress-value {
    font-size: 18px;
    color: #e8e1d4;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-top: 4px;
}

.menu-ctn-progress-integrity {
    font-size: 13px;
    color: #B23A3A;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-top: 6px;
}

/* ============================================================
    SIDEBAR FOOTER
    ============================================================ */

.menu-sidebar-footer {
    margin-top: auto;
    padding-top: 24px;
    border-top-width: 1px;
    border-top-color: rgba(74, 70, 63, 0.3);
    background-color: transparent;
}

.menu-footer-text {
    font-size: 12px;
    color: #6e6b65;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    letter-spacing: 1px;
    margin-bottom: 4px;
}

/* ============================================================
   PANELS CONTAINER (right side)
   ============================================================ */

.menu-panels-container {
    flex-grow: 1;
    padding-top: 64px;
    padding-bottom: 48px;
    padding-left: 24px;
    padding-right: 48px;
    overflow: hidden;
    background-color: transparent;
}

/* ===== PANEL INDIVIDUAL ===== */
/* Base: oculto por defecto */
.menu-panels-container > .menu-panel {
    position: absolute;
    left: 504px;
    top: 64px;
    right: 48px;
    bottom: 48px;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-left-width: 4px;
    border-left-color: transparent;
    padding: 48px;
    flex-direction: column;
    opacity: 0;
    display: none !important;
}

/* Visible cuando tiene preview-panel--visible */
.menu-panels-container > .menu-panel.preview-panel--visible {
    opacity: 1;
    display: flex;
    background-color: rgba(10, 10, 13, 0.7);
    border-color: rgba(232, 178, 98, 0.3);
    border-left-color: #E8B262;
}

.menu-panels-container > .menu-panel--centered {
    justify-content: center;
    align-items: center;
}

.menu-panels-container > .menu-panel .menu-panel-title {
    font-size: 32px;
    color: #E8B262;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    -unity-text-align: middle-left;
    margin-bottom: 4px;
}

.menu-panels-container > .menu-panel .menu-panel-subtitle {
    font-size: 14px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.menu-panels-container > .menu-panel .menu-panel-separator {
    height: 2px;
    width: 240px;
    background-color: #E8B262;
    opacity: 0.6;
    margin-bottom: 24px;
}

/* ===== SECTION LABEL ===== */
.menu-section-label {
    font-size: 14px;
    color: #E8B262;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 2px;
    margin-bottom: 12px;
}

/* ===== TERMINAL LOG ===== */
.menu-terminal-box {
    background-color: rgba(10, 11, 8, 0.5);
    border-width: 1px;
    border-color: rgba(232, 178, 98, 0.2);
    padding: 16px;
    margin-bottom: 24px;
}

.menu-terminal-line {
    font-size: 15px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-bottom: 6px;
}

/* ===== CHIPS (stats) ===== */
.menu-chips-row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px;
}

.menu-chip {
    min-width: 90px;
    padding: 12px 16px;
    background-color: rgba(14, 15, 11, 0.4);
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
    align-items: center;
}

.menu-chip-label {
    font-size: 12px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    letter-spacing: 1px;
}

.menu-chip-value {
    font-size: 18px;
    color: #C9D4B0;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-top: 4px;
}

/* ===== POLAROID ===== */
.menu-polaroid {
    width: 100%;
    padding: 8px;
    background-color: rgba(232, 225, 212, 0.3);
    align-items: center;
}

.menu-polaroid-photo {
    width: 90%;
    height: 120px;
    background-color: rgba(53, 53, 48, 0.4);
    border-width: 1px;
    border-color: rgba(149, 144, 135, 0.3);
    margin-bottom: 8px;
}

.menu-polaroid-caption {
    font-size: 14px;
    color: #353530;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    -unity-text-align: middle-center;
}

/* ===== MEMORY METER ===== */
.menu-memory-meter {
    margin-top: 16px;
    width: 100%;
    padding: 12px;
    background-color: rgba(8, 10, 16, 0.4);
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
}

.menu-meter-title {
    font-size: 12px;
    color: #959087;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.menu-meter-value {
    font-size: 18px;
    color: #C9D4B0;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
}

.menu-meter-bar-bg {
    width: 120px;
    height: 6px;
    background-color: rgba(28, 36, 48, 0.3);
    border-width: 1px;
    border-color: rgba(43, 74, 74, 0.3);
}

.menu-meter-bar-fill {
    height: 100%;
    background-color: #C9D4B0;
    width: 0%;
}

/* ============================================================
   LEVEL SELECT buttons
   ============================================================ */

.menu-level-btn {
    background-color: transparent;
    border-width: 0px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(74, 70, 63, 0.5);
    padding: 14px 12px;
    font-size: 15px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    -unity-text-align: middle-left;
    transition-property: color, translate, background-color;
    transition-duration: 150ms;
    transition-timing-function: linear;
}

.menu-level-btn:hover {
    background-color: rgba(57, 57, 53, 0.3);
    color: #E8B262;
    translate: 4px 0px;
}

/* ===== STATS BOX ===== */
.menu-stats-box {
    padding: 20px;
    background-color: #06080E;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.3);
    margin-bottom: 16px;
}

.menu-stats-box-title {
    font-size: 12px;
    color: #E8B262;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    letter-spacing: 3px;
    margin-bottom: 16px;
}

.menu-stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 10px;
}

.menu-stat-label {
    font-size: 14px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
}

.menu-stat-value {
    font-size: 14px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
}

.menu-stat-value--danger {
    color: #B23A3A;
}

.menu-stat-separator {
    height: 1px;
    background-color: rgba(201, 212, 176, 0.2);
    margin-bottom: 10px;
}

/* ============================================================
   ACTION BUTTONS
   ============================================================ */

.menu-action-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #959087;
    padding: 12px 24px;
    font-size: 16px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    color: #e4e2dc;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    transition-property: color, border-color, background-color;
    transition-duration: 150ms;
    transition-timing-function: linear;
    margin-bottom: 8px;
}

.menu-action-btn:hover {
    border-color: #fffeff;
    color: #fffeff;
    background-color: rgba(57, 57, 53, 0.4);
}

.menu-action-btn--primary {
    border-color: #E8B262;
    color: #E8B262;
}

.menu-action-btn--primary:hover {
    background-color: rgba(232, 178, 98, 0.2);
    color: #fffeff;
}

.menu-action-btn--danger {
    border-color: #B23A3A;
    color: #ffb4ab;
}

.menu-action-btn--danger:hover {
    background-color: rgba(178, 58, 58, 0.3);
    border-color: #ffb4ab;
    color: #fffeff;
}

/* ============================================================
   SETTINGS PANEL ELEMENTS
   ============================================================ */

.menu-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.menu-slider-value {
    font-size: 14px;
    color: #E8B262;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    width: 48px;
    -unity-text-align: middle-center;
    margin-left: 12px;
}

.menu-light-presets {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.menu-light-btn {
    width: 45%;
    background-color: transparent;
    border-width: 1px;
    border-color: #4a463f;
    padding: 10px;
    font-size: 13px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.menu-light-btn:hover {
    border-color: #fffeff;
    color: #fffeff;
    background-color: rgba(57, 57, 53, 0.3);
}

.menu-settings-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 16px;
}

/* ============================================================
   RESET PROGRESS OVERLAY
   ============================================================ */

.menu-reset-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 10, 13, 0.92);
    justify-content: center;
    align-items: center;
}

.menu-reset-dialog {
    background-color: #1b1c18;
    border-width: 2px;
    border-color: #B23A3A;
    padding: 32px;
    width: 400px;
}

.menu-reset-dialog-title {
    font-size: 24px;
    color: #B23A3A;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-bottom: 12px;
}

.menu-reset-dialog-text {
    font-size: 16px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Garamond.ttf');
    margin-bottom: 24px;
}