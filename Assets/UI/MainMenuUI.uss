/* ============================================================
   MainMenuUI — Estilos canónicos Fase 2
   Contraste ≥ 4.5:1. 0 opacidades bajas. Fondos sólidos.
   ============================================================ */

@import "EchoesDesignTokens.uss";
@import "Components/EchoButton.uss";
@import "Components/EchoPanel.uss";
@import "Components/EchoCard.uss";
@import "Components/EchoTabs.uss";
@import "Components/EchoModal.uss";
@import "Components/EchoToast.uss";
@import "Components/EchoLoading.uss";

/* ===== CRITICAL HARDCODED STYLES (bypass @import/var issues) ===== */
.root-fullscreen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
    background-color: transparent;
}

.void-intro {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--color-void-black);
    padding: 0;
    transition: opacity 0.6s ease-out;
}

.void-intro__text {
    font-size: 30px;
    color: #F4F2EE;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.main-menu-folder {
    background-color: rgba(6, 8, 12, 0.5);
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(255, 191, 0, 0.3);
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: row;
}

.menu-background {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url('../Images/menu_background.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.4;
    transition: opacity 0.3s, background-image 0.5s ease-in-out;
    pointer-events: none;
    z-index: -1;
}

.menu-background--hover-continuar {
    background-image: url('../Images/menu_background.png');
    opacity: 0.5;
}

.menu-background--hover-capitulos {
    background-image: url('../Images/void_fog_bg.png');
    opacity: 0.45;
}

.menu-background--hover-configurar {
    background-image: url('../Images/fragmenting_silhouette.png');
    opacity: 0.4;
}

.menu-background--hover-creditos {
    background-image: url('../Images/disconnect_bg.png');
    opacity: 0.35;
}

.menu-background--hover-cerrar {
    background-image: url('../Images/menu_background.png');
    opacity: 0.6;
}

.side-nav {
    width: 420px;
    height: 100%;
    background-color: var(--color-glass-bg);
    border-right-width: 1px;
    border-right-color: var(--color-glass-border);
    padding: 48px 32px;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
}
.side-nav__header { margin-bottom: 48px; flex-shrink: 0; }
.side-nav__hero { flex-shrink: 0; }
.folder-tabs-group { flex-direction: column; flex-grow: 1; }
.side-nav__footer { flex-shrink: 0; }

.menu-logo {
    width: 280px;
    height: 140px;
    background-image: url('project://database/Assets/UI/logo.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    align-self: center;
    margin-bottom: 24px;
    opacity: 1;
}

.logo {
    width: 280px;
    height: 140px;
    background-image: url('project://database/Assets/UI/logo.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    align-self: center;
    margin-bottom: 24px;
    opacity: 1;
}

.logo:hover {
    opacity: 1;
}

.side-nav__title {
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface);
    -unity-text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 4px;
    opacity: 1;
}
.side-nav__subtitle {
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface-variant);
    -unity-text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 1;
}

.side-nav__hero {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 212, 176, 0.2);
}

.hero-title {
    font-size: var(--size-interface-md);
    color: var(--color-stich-on-surface);
    letter-spacing: 1px;
    white-space: normal;
    line-height: var(--size-interface-lg);
    opacity: 1;
}

.folder-tabs-group { flex-direction: column; }

.nav-item-v2 {
    justify-content: flex-start;
    margin-bottom: 4px;
    padding: 16px 20px;
    color: var(--color-stich-on-surface);
    background-color: transparent;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: transparent;
    -unity-text-align: middle-left;
    font-size: var(--size-interface-sm);
    letter-spacing: 1px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    -unity-text-transform: uppercase;
    transition-property: color, background-color, border-left-color;
    transition-duration: var(--duration-hover);
    transition-timing-function: linear;
    opacity: 1;
}

.nav-item-v2:hover {
    color: var(--color-stich-pure-white);
    background-color: var(--color-amber-tint-12);
    border-left-color: var(--color-stich-amber);
}

.side-nav__footer {
    margin-top: 48px;
    padding-top: 32px;
    border-top-width: 1px;
    border-top-color: var(--color-glass-border);
}

.side-nav__footer Label {
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface-variant);
    margin-bottom: 4px;
    opacity: 1;
}

.right-content-container {
    position: absolute;
    left: 420px; top: 0; right: 0; bottom: 0;
    background-color: var(--color-stich-surface);
    border-left-width: 1px;
    border-left-color: var(--color-glass-border);
    overflow-y: auto;
}

.preview-panel {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    padding: 56px 48px;
    display: none;
    flex-direction: column;
}

.preview-panel--visible { display: flex; }

.panel-title {
    font-size: var(--size-display-md);
    color: var(--color-stich-amber);
    margin-bottom: 32px;
    letter-spacing: 1px;
    opacity: 1;
}

.terminal-log-box {
    min-height: 100px;
    padding: 12px 16px;
    background-color: var(--color-stich-surface-container-lowest);
    border-width: 1px;
    border-color: var(--color-glass-border);
    border-radius: 0;
}

.terminal-log-line {
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface);
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-bottom: 5px;
    white-space: normal;
    opacity: 1;
}

.accent-line {
    height: 1px;
    width: 100%;
    background-color: var(--color-stich-amber);
    margin-bottom: 28px;
    margin-top: 8px;
}

.text-body-lg {
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface);
    white-space: normal;
    line-height: var(--size-interface-lg);
    opacity: 1;
}

.telemetry-row {
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: wrap;
}

.telemetry-chip {
    min-width: 22%;
    padding: 12px 10px;
    background-color: var(--color-stich-surface-container-high);
    border-width: 1px;
    border-color: var(--color-glass-border);
    align-items: center;
    margin-bottom: 8px;
    margin-right: 8px;
}

.telemetry-chip-label {
    font-size: var(--size-label-caps);
    color: var(--color-stich-on-surface-variant);
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    -unity-text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 1;
}

.telemetry-chip-value {
    font-size: var(--size-interface-md);
    color: var(--color-stich-amber);
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-top: 4px;
    opacity: 1;
}

.text-label-caps {
    font-size: 13px;
    color: #C9D4B0;
    letter-spacing: 2px;
    -unity-text-transform: uppercase;
}
