/* ============================================================
   MainMenuUI — Estilos canónicos Fase 2
   Contraste ≥ 4.5:1. 0 opacidades bajas. Fondos sólidos.
   ============================================================ */

@import "EchoesDesignTokens.uss";
@import "Components/EchoButton.uss";
@import "Components/EchoPanel.uss";
@import "Components/EchoCard.uss";
@import "Components/EchoTabs.uss";
@import "Components/EchoModal.uss";
@import "Components/EchoToast.uss";
@import "Components/EchoLoading.uss";

/* ===== CRITICAL HARDCODED STYLES (bypass @import/var issues) ===== */
.root-fullscreen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
    background-color: #0A0A0D;
}

.void-intro {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: #0A0A0D;
}

.void-intro__text {
    font-size: 30px;
    color: #F4F2EE;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.main-menu-folder {
    background-color: #06080C;
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(255, 191, 0, 0.3);
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: row;
}

.side-nav {
    width: 420px;
    background-color: #030406;
    border-right-width: 1px;
    border-right-color: rgba(255, 191, 0, 0.2);
    padding: 48px 32px;
    justify-content: space-between;
    flex-shrink: 0;
}

.side-nav__header { margin-bottom: 48px; }
.side-nav__title {
    font-size: 17px;
    color: #C9D4B0;
    -unity-text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 4px;
}
.side-nav__subtitle {
    font-size: 17px;
    color: #5A4A2E;
    -unity-text-transform: uppercase;
    letter-spacing: 1px;
}

.side-nav__hero {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 212, 176, 0.2);
}

.hero-title {
    font-size: 42px;
    color: #C9D4B0;
    letter-spacing: 1px;
    white-space: normal;
    line-height: 52px;
}

.folder-tabs-group { flex-direction: column; }

.nav-item-v2 {
    justify-content: flex-start;
    margin-bottom: 4px;
    padding: 16px 20px;
    color: #C9D4B0;
    background-color: transparent;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: transparent;
    -unity-text-align: middle-left;
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    -unity-text-transform: uppercase;
    transition-property: color, background-color, border-left-color;
    transition-duration: 0.15s;
}

.nav-item-v2:hover {
    color: #C9D4B0;
    background-color: rgba(201, 212, 176, 0.06);
    border-left-color: rgba(201, 212, 176, 0.6);
}

.side-nav__footer {
    margin-top: 48px;
    padding-top: 32px;
    border-top-width: 1px;
    border-top-color: rgba(201, 212, 176, 0.2);
}

.side-nav__footer Label {
    font-size: 17px;
    color: #5A4A2E;
    margin-bottom: 4px;
}

.right-content-container {
    position: absolute;
    left: 420px; top: 0; right: 0; bottom: 0;
    background-color: #090B0F;
    border-left-width: 1px;
    border-left-color: rgba(201, 212, 176, 0.08);
    overflow-y: auto;
}

.preview-panel {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    padding: 56px 48px;
    display: none;
    flex-direction: column;
}

.preview-panel--visible { display: flex; }

.panel-title {
    font-size: 42px;
    color: #FFBF00;
    margin-bottom: 32px;
    letter-spacing: 1px;
}

.terminal-log-box {
    min-height: 100px;
    padding: 12px 16px;
    background-color: #04060A;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
    border-radius: 2px;
}

.terminal-log-line {
    font-size: 13px;
    color: #DCE4D0;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-bottom: 5px;
    white-space: normal;
}

.accent-line {
    height: 1px;
    width: 100%;
    background-color: rgba(255, 191, 0, 0.4);
    margin-bottom: 28px;
    margin-top: 8px;
}

.text-body-lg {
    font-size: 18px;
    color: #E2E6EC;
    white-space: normal;
    line-height: 26px;
}

.telemetry-row {
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: wrap;
}

.telemetry-chip {
    min-width: 22%;
    padding: 12px 10px;
    background-color: #0C1018;
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.15);
    align-items: center;
    margin-bottom: 8px;
    margin-right: 8px;
}

.telemetry-chip-label {
    font-size: 11px;
    color: #8C96A5;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    -unity-text-transform: uppercase;
    letter-spacing: 1px;
}

.telemetry-chip-value {
    font-size: 22px;
    color: #FFBF00;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    margin-top: 4px;
}

.text-label-caps {
    font-size: 13px;
    color: #C9D4B0;
    letter-spacing: 2px;
    -unity-text-transform: uppercase;
}
