<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements">
    <!-- GameHUDUI — Fase 4: Mínimo esencial.
         Opacidad base 0.0. Solo visible al grabar/reproducir.
         Elementos:
         - REC● + barra 12s + slots (solo grabando)
         - ECO▶ + slots (solo reproduciendo)
         - Objetivo contextual (top-center)
         - Toast (bottom-center, 1 a la vez)
         - Key prompt (centro, solo cerca interactuable)
         - Chalkboard (tutorial 1 acción)
         - Footer: REC● / ECO▶ estados -->

    <ui:VisualElement class="root-fullscreen" name="hud-root" picking-mode="Ignore">

        <!-- RECORD PANEL (top-left) - solo grabando -->
        <ui:VisualElement class="hud-record-panel hidden" name="hud-record-panel">
            <ui:VisualElement class="hud-record-dot" name="hud-record-dot" />
            <ui:VisualElement class="hud-record-bar-bg" name="hud-record-bar-bg">
                <ui:VisualElement class="hud-record-bar-fill" name="hud-record-bar-fill" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-echo-slots" name="hud-echo-slots" />
        </ui:VisualElement>

        <!-- HUD BARS (top-right) - solo en puzzle -->
        <ui:VisualElement class="hud-container hidden" name="hud-container">
            <ui:VisualElement class="hud-bar-container">
                <ui:Label class="hud-bar-label" text="ESTABILIDAD" />
                <ui:VisualElement class="hud-bar-bg">
                    <ui:VisualElement class="hud-bar-fill hud-bar-fill--stability" name="hud-stability-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-bar-container">
                <ui:Label class="hud-bar-label" text="RECUERDO" />
                <ui:VisualElement class="hud-bar-bg">
                    <ui:VisualElement class="hud-bar-fill hud-bar-fill--recall" name="hud-recall-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- OBJECTIVE (top-center) -->
        <ui:Label class="hud-objective-text hidden" name="hud-objective-text" text="" />

        <!-- TOAST (bottom-center) -->
        <ui:Label class="hud-toast-text hidden" name="hud-toast-text" text="" />

        <!-- ECHO STATE (above toast) -->
        <ui:Label class="hud-echo-state-label hidden" name="hud-echo-state-label" text="" />

        <!-- KEY PROMPT (center) - solo cerca interactuable -->
        <ui:Label class="key-prompt-label hidden" name="key-prompt-label" text="" />

        <!-- CHALKBOARD TUTORIAL (bottom-left) -->
        <ui:VisualElement class="chalkboard-box hidden" name="chalkboard-box">
            <ui:Label class="chalkboard-title" name="chalkboard-title" text="" />
            <ui:Label class="chalkboard-text" name="chalkboard-text" text="" />
        </ui:VisualElement>

        <!-- FOOTER STATUS (bottom-right) -->
        <ui:VisualElement class="footer-status" name="footer-status">
            <ui:VisualElement class="footer-item footer-item--inactive" name="hud-recording-status">
                <ui:Label class="footer-icon" text="●" />
                <ui:Label class="footer-label" text="REC" />
            </ui:VisualElement>
            <ui:VisualElement class="footer-item footer-item--inactive" name="hud-playback-status">
                <ui:Label class="footer-icon" text="▶" />
                <ui:Label class="footer-label" text="ECO" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</UXML>