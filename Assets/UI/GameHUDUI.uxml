<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/GameHUDUI.uss" />

    <ui:VisualElement name="hud-root" class="school-hud" picking-mode="Ignore">
        <ui:VisualElement class="hud-location" picking-mode="Ignore">
            <ui:Label name="hud-location" class="hud-room" picking-mode="Ignore" />
            <ui:VisualElement name="hud-objective" class="hud-objective hidden" picking-mode="Ignore">
                <ui:Label name="hud-objective-text" class="hud-copy" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="hud-record-frame" class="hud-record-frame hidden" picking-mode="Ignore">
            <ui:VisualElement class="hud-corner hud-corner-tl" picking-mode="Ignore" />
            <ui:VisualElement class="hud-corner hud-corner-tr" picking-mode="Ignore" />
            <ui:VisualElement class="hud-corner hud-corner-bl" picking-mode="Ignore" />
            <ui:VisualElement class="hud-corner hud-corner-br" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="hud-record-panel" class="hud-recorder hidden" picking-mode="Ignore">
            <ui:VisualElement class="hud-recorder-header" picking-mode="Ignore">
                <ui:Label name="hud-record-mode" class="hud-tape-label" text="CINTA DE ECO" picking-mode="Ignore" />
                <ui:VisualElement name="hud-record-progress" class="hidden" picking-mode="Ignore">
                    <ui:Label name="hud-record-time" class="hud-tape-time" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="hud-echo-count" class="hud-count" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="hud-tape-artwork" class="hud-tape-artwork" picking-mode="Ignore" />
            <ui:VisualElement name="hud-echo-slots" class="hud-echo-slots" picking-mode="Ignore" />
            <ui:Label name="hud-echo-state-label" class="hud-hint hidden" picking-mode="Ignore" />
            <ui:Label name="hud-record-help" class="hud-hint" text="Mantén R · Grabar" picking-mode="Ignore" />
            <ui:Label name="hud-resonance-state" class="hud-hint hidden" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="hud-center-dot" picking-mode="Ignore" />
        <ui:VisualElement class="hud-context" picking-mode="Ignore">
            <ui:VisualElement name="hud-interaction" class="hud-interaction hidden" picking-mode="Ignore">
                <ui:Label name="hud-interaction-key" class="hud-key" picking-mode="Ignore" />
                <ui:Label name="hud-interaction-action" class="hud-copy" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="key-prompt-label" class="hud-note hud-copy hidden" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="hud-bottom" picking-mode="Ignore">
            <ui:Label name="hud-toast-text" class="hud-note hud-copy hidden" picking-mode="Ignore" />
            <ui:VisualElement name="chalkboard-box" class="hud-notice hud-chalkboard hidden" picking-mode="Ignore">
                <ui:Label name="chalkboard-title" class="hud-kicker" picking-mode="Ignore" />
                <ui:Label name="chalkboard-text" class="hud-copy" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
