                        <ui:VisualElement class="lvl-chapter-main">
                            <ui:VisualElement class="lvl-chapter-thumb lvl-chapter-thumb--locked">
                                <ui:VisualElement class="lvl-chapter-thumb-placeholder" />
                                <ui:Label text="ERR" class="lvl-chapter-thumb-err" />
                            </ui:VisualElement>
                            <ui:VisualElement class="lvl-chapter-meta">
                                <ui:VisualElement class="lvl-chapter-meta-row">
                                    <ui:Label text="REC: VII" class="lvl-chapter-rec lvl-chapter-rec--locked" />
