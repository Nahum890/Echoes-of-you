<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />
    <Style src="project://database/Assets/UI/SettingsUI.uss" />

    <ui:VisualElement name="settingsRoot" class="settings-stitch-root">

        <!-- Background overlay -->
        <ui:VisualElement class="settings-bg-overlay" />

        <!-- Main calibration interface -->
        <ui:VisualElement class="settings-main">

            <!-- LEFT SIDEBAR -->
            <ui:VisualElement class="settings-sidebar">

                <ui:VisualElement class="settings-sidebar-header">
                    <ui:VisualElement class="settings-title-container">
                        <ui:Label name="lblSettingsTitle" text="CALIBRACIÓN" class="settings-logo-title" />
                        <ui:Label text="CALIBRACIÓN" class="settings-logo-shadow" />
                    </ui:VisualElement>
                    <ui:Label name="lblSettingsSubtitle" text="SISTEMA_V.1.04 // ESTADO: INESTABLE" class="settings-logo-subtitle" />
                    <ui:VisualElement class="settings-sidebar-divider" />
                </ui:VisualElement>

                <ui:VisualElement class="echo-tabs settings-tabs" name="settingsTabs">
                    <ui:Button name="tabVideo" text="VÍDEO" class="settings-tab settings-tab--active" />
                    <ui:Button name="tabAudio" text="AUDIO" class="settings-tab" />
                    <ui:Button name="tabControles" text="CONTROLES" class="settings-tab" />
                    <ui:Button name="tabAccesibilidad" text="ACCESIBILIDAD" class="settings-tab" />
                    <ui:Button name="tabGameplay" text="GAMEPLAY" class="settings-tab" />
                </ui:VisualElement>

                <ui:VisualElement class="settings-sidebar-footer">
                    <ui:Button name="btnSettingsBack" text="CERRAR TERMINAL" class="settings-close-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ===== RIGHT CONTENT AREA ===== -->
            <ui:VisualElement class="settings-right">

                <!-- VIDEO PANEL -->
                <ui:VisualElement name="panelVideo" class="settings-panel">
                    <ui:VisualElement class="settings-panel-header">
                        <ui:Label text="PARÁMETROS VISUALES" class="settings-panel-header-title" />
                        <ui:Label text="REC" class="settings-panel-header-rec" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Resolución" class="settings-item-label" />
                            <ui:Label text="Dimensiones de proyección temporal." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-item-control">
                            <ui:DropdownField name="ResolutionDropdown" label="" class="settings-dropdown" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Brillo" class="settings-item-label" />
                            <ui:Label text="Nivel de exposición en la memoria." class="settings-item-hint" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Escala UI" class="settings-item-label" />
                            <ui:Label text="Tamaño de proyección de interfaz." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:DropdownField name="ScaleDropdown" label="Escala" class="settings-dropdown" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Pantalla Completa" class="settings-item-label" />
                            <ui:Label text="Modo de proyección exclusivo." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:Toggle name="FullscreenToggle" label="" class="settings-toggle" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="VSync" class="settings-item-label" />
                            <ui:Label text="Sincronización vertical del visor." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:Toggle name="VsyncToggle" label="" class="settings-toggle" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- AUDIO PANEL -->
                <ui:VisualElement name="panelAudio" class="settings-panel hidden">
                    <ui:VisualElement class="settings-panel-header">
                        <ui:Label text="PARÁMETROS ACÚSTICOS" class="settings-panel-header-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Volumen General" class="settings-item-label" />
                            <ui:Label text="Amplitud base de la señal." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="sldMaster" label="" low-value="0" high-value="1" value="0.84" class="settings-slider" />
                            <ui:Label name="lblMasterVal" text="84%" class="settings-slider-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Música" class="settings-item-label" />
                            <ui:Label text="Frecuencia de fondo ambiental." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="sldMusic" label="" low-value="0" high-value="1" value="0.6" class="settings-slider" />
                            <ui:Label name="lblMusicVal" text="60%" class="settings-slider-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="SFX" class="settings-item-label" />
                            <ui:Label text="Efectos de campo y ambientales." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="sldSfx" label="" low-value="0" high-value="1" value="0.72" class="settings-slider" />
                            <ui:Label name="lblSfxVal" text="72%" class="settings-slider-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Voz del Eco" class="settings-item-label" />
                            <ui:Label text="Resonancia de la memoria residual." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="sldEchoVoice" label="" low-value="0" high-value="1" value="0.7" class="settings-slider" />
                            <ui:Label name="lblEchoVoiceVal" text="70%" class="settings-slider-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- CONTROLES PANEL -->
                <ui:VisualElement name="panelControles" class="settings-panel hidden">
                    <ui:VisualElement class="settings-panel-header">
                        <ui:Label text="PARÁMETROS DE CONTROL" class="settings-panel-header-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Sensibilidad Cámara" class="settings-item-label" />
                            <ui:Label text="Velocidad de respuesta del visor." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="SensitivitySlider" label="" low-value="0.2" high-value="3" value="1" class="settings-slider" />
                            <ui:Label name="lblCamSensVal" text="1.0" class="settings-slider-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement style="display: none;">
                        <ui:Button name="btnSensLow" />
                        <ui:Button name="btnSensMed" />
                        <ui:Button name="btnSensHigh" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Teclas" class="settings-item-label" />
                            <ui:Label text="Próximamente: editor de bindings." class="settings-item-hint" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ACCESIBILIDAD PANEL -->
                <ui:VisualElement name="panelAccesibilidad" class="settings-panel hidden">
                    <ui:VisualElement class="settings-panel-header">
                        <ui:Label text="ACCESIBILIDAD" class="settings-panel-header-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Tamaño de Texto" class="settings-item-label" />
                            <ui:Label text="Escala tipográfica global." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:DropdownField name="TextSizeDropdown" label="" class="settings-dropdown" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Alto Contraste" class="settings-item-label" />
                            <ui:Label text="Ratio ≥ 7:1 en todos los elementos." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:Toggle name="HighContrastToggle" label="" class="settings-toggle" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Subtítulos" class="settings-item-label" />
                            <ui:Label text="Transcripción de diálogos y ecos." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:Toggle name="SubtitlesToggle" label="" class="settings-toggle" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Tamaño Subtítulos" class="settings-item-label" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="SubtitleSizeSlider" label="" low-value="0.8" high-value="1.5" value="1" class="settings-slider" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Fondo Subtítulos" class="settings-item-label" />
                        </ui:VisualElement>
                        <ui:Toggle name="SubtitleBgToggle" label="" class="settings-toggle" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Reducir Flashes" class="settings-item-label" />
                            <ui:Label text="Menos de 3 flashes/segundo." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:Toggle name="ReduceFlashesToggle" label="" class="settings-toggle" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Reducir Movimiento" class="settings-item-label" />
                            <ui:Label text="Bloquea animaciones de bucle." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:Toggle name="ReduceMotionToggle" label="" class="settings-toggle" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- GAMEPLAY PANEL -->
                <ui:VisualElement name="panelGameplay" class="settings-panel hidden">
                    <ui:VisualElement class="settings-panel-header">
                        <ui:Label text="PARÁMETROS DE JUEGO" class="settings-panel-header-title" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Tiempo Extra Eco" class="settings-item-label" />
                            <ui:Label text="Asistencia: +X% a maxRecordSeconds." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="ExtraRecordTimeSlider" label="" low-value="0" high-value="50" value="0" class="settings-slider" />
                            <ui:Label name="lblExtraRecordTimeVal" text="0%" class="settings-slider-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Niebla" class="settings-item-label" />
                            <ui:Label text="Densidad de articulación atmosférica." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="sldFog" label="" low-value="0" high-value="0.02" value="0.008" class="settings-slider" />
                            <ui:Label name="lblFogVal" text="0.035" class="settings-slider-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item settings-item--slider">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Opacidad Eco" class="settings-item-label" />
                            <ui:Label text="Transparencia de la proyección de memoria." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement style="align-items: flex-end;">
                            <ui:Slider name="sldEcho" label="" low-value="0" high-value="1" value="0.6" class="settings-slider" />
                            <ui:Label name="lblEchoVal" text="60%" class="settings-slider-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-item">
                        <ui:VisualElement class="settings-item-info">
                            <ui:Label text="Borrar Progreso" class="settings-item-label" />
                            <ui:Label text="ADVERTENCIA: Irreversible." class="settings-item-hint" />
                        </ui:VisualElement>
                        <ui:Button name="btnDeleteProgress" text="Borrar Todo" class="settings-delete-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Action bar -->
                <ui:VisualElement class="settings-actions">
                    <ui:Button name="btnRestoreDefaults" text="Restaurar Defecto" class="settings-action-btn" />
                    <ui:Button name="btnSettingsApply" text="APLICAR CAMBIOS" class="settings-action-btn settings-action-btn--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</UXML>