<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/LoadingScreenUI.uss" />
    <ui:VisualElement name="loading-root" class="loading-root">
        <ui:VisualElement class="loading-card" picking-mode="Ignore">
            <ui:VisualElement class="loading-fixtures" picking-mode="Ignore">
                <ui:VisualElement name="loading-fixture-0" class="loading-fixture loading-fixture--near" picking-mode="Ignore" />
                <ui:VisualElement name="loading-fixture-1" class="loading-fixture loading-fixture--middle" picking-mode="Ignore" />
                <ui:VisualElement name="loading-fixture-2" class="loading-fixture loading-fixture--far" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="loading-chapter-title" class="loading-title" picking-mode="Ignore" />
            <ui:Label name="loading-quote" class="loading-quote" picking-mode="Ignore" />
            <ui:VisualElement class="loading-hint" picking-mode="Ignore">
                <ui:Label name="loading-hint-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="loading-progress" picking-mode="Ignore">
                <ui:VisualElement name="loading-bar-fill" class="loading-bar-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="loading-pct" class="loading-status" text="Cargando · 0%" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
