<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />
    
    <ui:VisualElement name="gameover-root" class="root-fullscreen hidden">
        <ui:VisualElement class="gameover-overlay crt-vignette crt-scanlines">
            
            <!-- Static simulation lines -->
            <ui:VisualElement style="position: absolute; left: 0; top: 30%; right: 0; height: 1px; background-color: rgba(178, 58, 58, 0.25);" />
            <ui:VisualElement style="position: absolute; left: 0; top: 60%; right: 0; height: 2px; background-color: rgba(201, 212, 176, 0.15);" />

            <ui:VisualElement style="align-items: center; justify-content: center; flex-direction: column;">
                <!-- Error marker -->
                <ui:Label text="[!] FRECUENCIA PERDIDA" class="font-mono-bold text-label-caps" style="color: #B23A3A; margin-bottom: 24px; font-size: 10px;" />

                <!-- Main title -->
                <ui:Label name="gameover-title" text="MEMORIA FRAGMENTADA" class="gameover-title" />
                
                <!-- Main description -->
                <ui:Label name="gameover-subtitle" text="La sincronizaciÃ³n con el eco ha fallado." class="gameover-subtitle" />
                
                <!-- Poetic quote -->
                <ui:Label name="gameover-poem" text="El silencio entre los ecos es infinito." class="font-serif-bold" style="font-size: 13px; color: #E8B262; -unity-font-style: italic; margin-bottom: 64px; opacity: 0.7; -unity-text-align: middle-center; max-width: 400px; line-height: 18px;" />
            </ui:VisualElement>
            
            <!-- Action buttons -->
            <ui:VisualElement style="flex-direction: row; justify-content: center; align-items: center;">
                <ui:Button name="btn-retry" text="â†» Reintentar SintonÃ­a" class="btn-classic btn-classic-accent" style="margin-right: 16px; padding: 12px 24px;" />
                <ui:Button name="btn-go-hub" text="Volver al Expediente" class="btn-classic" style="margin-right: 16px; padding: 12px 24px;" />
                <ui:Button name="btn-exit" text="âœ• Cerrar" class="btn-classic" style="padding: 12px 24px; color: #8C96A5;" />
            </ui:VisualElement>

            <!-- Hidden dummy button to avoid null references in script -->
            <ui:Button name="btn-go-menu" class="hidden" style="display: none;" />

            <!-- Corner Telemetry HUD decoration -->
            <ui:VisualElement style="position: absolute; bottom: 32px; left: 32px;">
                <ui:Label text="ERROR_CODE: 0x9811" class="font-mono" style="font-size: 8px; color: #5A6472;" />
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

