.loading-root {
    background-color: #111814;
    justify-content: center;
    align-items: center;
}

.loading-card {
    width: 86%;
    max-width: 870px;
    padding: 38px 48px;
    background-color: #202b24;
    border-width: 1px;
    border-color: #5d6250;
    border-left-width: 4px;
    border-left-color: #cfb685;
    align-items: stretch;
}

.loading-fixtures {
    align-items: center;
    align-self: center;
    margin-bottom: 30px;
}

.loading-fixture {
    background-color: #f2dbaf;
    border-width: 2px;
    border-color: #ab9467;
    margin-bottom: 6px;
}

.loading-fixture--near { width: 112px; height: 12px; }
.loading-fixture--middle { width: 78px; height: 9px; }
.loading-fixture--far { width: 48px; height: 7px; }

.loading-title, .loading-quote, .loading-hint .unity-label, .loading-status {
    white-space: normal;
    -unity-text-align: middle-center;
}

.loading-title { font-size: 37px; color: #f5e6c5; -unity-font-style: bold; }
.loading-quote { font-size: 22px; color: #e2d9c3; margin: 10px 0 0; }
.loading-hint { margin-top: 12px; }
.loading-hint .unity-label { font-size: 18px; color: #c7c7af; }
.loading-progress { margin-top: 28px; height: 6px; background-color: #50594a; }
.loading-bar-fill { width: 0%; height: 100%; background-color: #dcbd86; }
.loading-status { font-size: 18px; color: #e9d5a8; margin-top: 10px; }
