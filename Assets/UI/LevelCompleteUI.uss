/* ============================================================
   LevelCompleteUI — level completion screen (Stich aesthetic)
   Shows "MEMORIA ANCLADA", stats (ecos, quiebres, tiempo),
   and action buttons (Continuar / Reiniciar / Cuaderno).
   Fade in via .complete-hidden removal.
   ============================================================ */

@import "EchoesDesignTokens.uss";

.level-complete-root {
    background-color: var(--color-glass-bg-strong);
    border-width: 1px;
    border-color: var(--color-glass-border);
    border-radius: 4px;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: var(--duration-slow);
    transition-timing-function: linear;
    opacity: 1;
}

.complete-hidden {
    display: none;
}

.complete-vignette {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
    pointer-events: none;
}

.complete-content {
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl);
    max-width: 800px;
}

.complete-title {
    -unity-font: var(--font-display-bold);
    font-size: var(--size-display-md);
    color: var(--color-stich-amber);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-md);
    opacity: 1;
}

.complete-separator {
    height: 1px;
    width: 320px;
    background-color: var(--color-stich-outline-variant);
    margin-bottom: var(--space-xl);
}

.complete-stats {
    flex-direction: row;
    justify-content: center;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
}

.complete-stat-label {
    -unity-font: var(--font-interface-bold);
    font-size: var(--size-label-caps);
    color: var(--color-stich-on-surface-variant);
    letter-spacing: 0.1em;
    -unity-text-transform: uppercase;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-sm);
    opacity: 1;
}

.complete-stat-value {
    -unity-font: var(--font-interface-bold);
    font-size: var(--size-interface-lg);
    color: var(--color-stich-on-surface);
    -unity-text-align: middle-center;
    opacity: 1;
}

.complete-buttons {
    flex-direction: row;
    justify-content: center;
    gap: var(--space-md);
}

.complete-btn {
    -unity-font: var(--font-interface);
    font-size: var(--size-interface-sm);
    color: var(--color-stich-on-surface);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--color-stich-outline);
    padding: var(--space-md) var(--space-xl);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    opacity: 1;
    transition-property: color, border-color, background-color;
    transition-duration: var(--duration-hover);
    transition-timing-function: linear;
    border-radius: 0;
}

.complete-btn:hover {
    color: var(--color-stich-pure-white);
    background-color: var(--color-stich-surface-container-low);
    border-color: var(--color-stich-on-surface);
}

.complete-btn--primary {
    color: var(--color-stich-amber);
    border-color: var(--color-stich-amber);
}

.complete-btn--primary:hover {
    background-color: var(--color-amber-tint-12);
    color: var(--color-stich-amber);
    border-color: var(--color-stich-amber);
}
