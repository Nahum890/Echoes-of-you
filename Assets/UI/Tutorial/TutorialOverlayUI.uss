.tutorial-overlay-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: #030508;
    z-index: 500;
}

.tutorial-hidden {
    display: none !important;
}

.tutorial-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
}

.tutorial-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #030508;
    border-width: 0;
    border-radius: 0;
    padding-top: 10px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

.tutorial-close-btn {
    position: absolute;
    top: 14px;
    right: 18px;
    z-index: 20;
    background-color: rgba(18, 24, 34, 0.85);
    border-width: 1px;
    border-color: rgba(99, 212, 250, 0.5);
    border-radius: 6px;
    color: #a2ecfc;
    font-size: 14px;
    padding: 6px 16px;
    -unity-font-style: bold;
    cursor: pointer;
    transition-property: background-color, border-color, color;
    transition-duration: 150ms;
}

.tutorial-close-btn:hover {
    background-color: rgba(99, 212, 250, 0.25);
    border-color: #63d4fa;
    color: #ffffff;
}

.tutorial-image {
    width: 100%;
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 8px;
    margin-bottom: 10px;
}

.tutorial-footer {
    width: 100%;
    height: 52px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(10, 15, 22, 0.95);
    border-width: 1px;
    border-color: rgba(99, 212, 250, 0.25);
    border-radius: 8px;
    padding-left: 24px;
    padding-right: 16px;
}

.tutorial-prompt-text {
    font-size: 16px;
    color: #e2f7fd;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tutorial-continue-btn {
    background-color: #164e63;
    border-width: 1px;
    border-color: #63d4fa;
    border-radius: 6px;
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 8px 24px;
    cursor: pointer;
    transition-property: background-color, border-color, scale;
    transition-duration: 150ms;
}

.tutorial-continue-btn:hover {
    background-color: #0891b2;
    border-color: #a5f3fc;
    scale: 1.03 1.03;
}