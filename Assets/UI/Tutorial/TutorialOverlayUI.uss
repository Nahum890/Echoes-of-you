.tutorial-overlay-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: #202b24;
}

.tutorial-hidden {
    display: none !important;
}

.tutorial-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
}

.tutorial-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #202b24;
    border-width: 0;
    border-radius: 0;
    padding-top: 10px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
}

.tutorial-close-btn {
    position: absolute;
    top: 14px;
    right: 18px;
    background-color: rgba(18, 24, 34, 0.85);
    border-width: 1px;
    border-color: rgba(99, 212, 250, 0.5);
    border-radius: 6px;
    color: #efd099;
    font-size: 14px;
    padding: 6px 16px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 150ms;
}

.tutorial-close-btn:hover {
    background-color: rgba(99, 212, 250, 0.25);
    border-color: #ebcb90;
    color: #ffffff;
}

.tutorial-steps {
    flex-grow: 1;
    flex-shrink: 1;
    width: 85%;
    max-width: 720px;
    justify-content: center;
}

.tutorial-title {
    font-size: 34px;
    color: #efd099;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.tutorial-step {
    font-size: 22px;
    white-space: normal;
    color: #f5edd8;
    margin-bottom: 10px;
}

.tutorial-footer {
    width: 100%;
    min-height: 52px;
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(10, 15, 22, 0.95);
    border-width: 1px;
    border-color: rgba(99, 212, 250, 0.25);
    border-radius: 8px;
    padding-left: 24px;
    padding-right: 16px;
}

.tutorial-prompt-text {
    font-size: 16px;
    color: #f5edd8;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tutorial-continue-btn {
    background-color: #354438;
    border-width: 1px;
    border-color: #ebcb90;
    border-radius: 6px;
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 8px 24px;
    transition-property: background-color, border-color, scale;
    transition-duration: 150ms;
}

.tutorial-continue-btn:hover {
    background-color: #52634c;
    border-color: #f6e6b8;
    scale: 1.03 1.03;
}
.tutorial-title, .tutorial-prompt-text, .tutorial-continue-btn { white-space: normal; }
.tutorial-prompt-text { flex-shrink: 1; }
