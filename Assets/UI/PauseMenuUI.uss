/* ============================================================
   PauseMenuUI — Notebook Stich, más opaco, fondos sólidos
   ============================================================ */

@import "EchoesDesignTokens.uss";

/* ===== ROOT — opaco para bloquear vista del juego ===== */
.root-fullscreen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
    background-color: rgba(6, 8, 12, 0.85);
}

/* ===== NOTEBOOK ===== */
.pause-notebook {
    width: 460px;
    background-color: #131410;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #E8B262;
    padding: 32px 28px;
    position: absolute;
    left: 80px;
    top: 0; bottom: 0;
    justify-content: space-between;
}

/* HEADER */
.pause-notebook__header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom-width: 2px;
    border-bottom-color: #4a463f;
}

.pause-title {
    font-size: 36px;
    color: #E8B262;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/GaramondBold.ttf');
    letter-spacing: 2px;
    margin-bottom: 4px;
    opacity: 1;
}

.pause-subtitle {
    font-size: 14px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    letter-spacing: 2px;
    opacity: 1;
}

/* STATS */
.pause-stats {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom-width: 1px;
    border-bottom-color: #4a463f;
}

.pause-stat {
    font-size: 18px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    margin-bottom: 10px;
    opacity: 1;
}

/* ACTIONS */
.pause-actions {
    flex-direction: column;
    margin-top: 16px;
}

.pause-btn {
    margin-bottom: 10px;
    justify-content: flex-start;
    padding: 16px 20px;
    font-size: 18px;
    color: #e4e2dc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/CourierBold.ttf');
    background-color: #1b1c18;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #E8B262;
    border-radius: 0;
    letter-spacing: 1px;
    transition-property: color, background-color, border-color, scale;
    transition-duration: 150ms;
    transition-timing-function: linear;
    opacity: 1;
}

.pause-btn:hover {
    color: #fffeff;
    background-color: #2a2a26;
    border-color: #E8B262;
    scale: 1.02 1.02;
}

.pause-btn:active {
    color: #E8B262;
    border-color: #E8B262;
    scale: 0.98 0.98;
}

/* FOOTER */
.pause-footer {
    margin-top: 24px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: #4a463f;
    font-size: 14px;
    color: #ccc6bc;
    -unity-font-definition: url('project://database/Assets/UI/Fonts/Courier.ttf');
    opacity: 1;
}

/* SETTINGS PANEL (overlay) */
.pause-settings-panel {
    position: absolute;
    left: 600px;
    top: 32px;
    right: 32px;
    bottom: 32px;
    background-color: #131410;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #E8B262;
    padding: 32px;
    flex-direction: column;
}
