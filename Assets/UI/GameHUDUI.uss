.school-hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: #f6efdb;
}


.hud-location {
    position: absolute;
    left: 40px;
    top: 32px;
    width: 42%;
    max-width: 560px;
    align-items: flex-start;
}
.hud-room, .hud-copy, .hud-hint, .hud-kicker {
    white-space: normal;
    margin: 0;
    padding: 0;
}
.hud-room {
    font-size: 23px;
    -unity-font-style: bold;
    background-color: #2c362d;
    border-width: 2px;
    border-color: #d1bd92;
    padding: 5px 14px;
    color: #fff0cd;
}
.hud-objective { margin-top: 7px; background-color: rgba(12,17,16,0.82); padding: 5px 12px; }
.hud-copy { font-size: 20px; color: #fbefda; }
.hud-kicker { font-size: 16px; color: #ebcb90; -unity-font-style: bold; }
.hud-hint { font-size: 16px; color: #ded3b3; margin-top: 2px; }
.hud-recorder {
    position: absolute;
    right: 36px;
    bottom: 35px;
    width: 395px;
    max-width: 40%;
    padding: 11px 16px;
    background-color: #222720;
    border-width: 2px;
    border-color: #837355;
    border-radius: 8px;
}
.hud-recorder-header { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; }
.hud-tape-label, .hud-tape-time, .hud-count { font-size: 19px; margin: 0; color: #f1dbab; }
.hud-tape-label { -unity-font-style: bold; letter-spacing: 2px; }
.hud-tape-time { -unity-font-style: bold; color: #a3e7d3; }
.hud-tape-artwork { height: 68px; background-color: #171e19; margin-top: 5px; }
.hud-echo-slots { flex-direction: row; margin-top: 4px; }
.hud-splice, .hud-splice-filled {
    width: 23px;
    height: 5px;
    margin-right: 4px;
    background-color: #555b4b;
}
.hud-splice-filled { background-color: #9de4ce; }
.hud-recorder--recording { border-color: #a3e7d3; }
.hud-recorder--recording .hud-tape-label { color: #f5a683; }
.hud-recorder--recording.hud-recorder--low .hud-tape-time { color: #f5a683; }

.hud-record-frame {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 12%;
    bottom: 24px;
}
.hud-corner {
    position: absolute;
    width: 39px;
    height: 39px;
    border-color: rgba(156, 227, 211, 0.85);
}
.hud-record-frame--low .hud-corner { border-color: rgba(245, 166, 131, 0.9); }
.hud-corner-tl { top: 0; left: 0; border-top-width: 3px; border-left-width: 3px; }
.hud-corner-tr { top: 0; right: 0; border-top-width: 3px; border-right-width: 3px; }
.hud-corner-bl { bottom: 0; left: 0; border-bottom-width: 3px; border-left-width: 3px; }
.hud-corner-br { bottom: 0; right: 0; border-bottom-width: 3px; border-right-width: 3px; }

.hud-interaction, .hud-note, .hud-chalkboard {
    background-color: rgba(12,17,16,0.9);
    padding: 7px 12px;
}
.hud-chalkboard { border-bottom-width: 2px; border-bottom-color: #b89f6a; }
.hud-center-dot {
    position: absolute;
    top: 50%; left: 50%;
    translate: -50% -50%;
    width: 4px; height: 4px;
    background-color: #ede2c6;
    border-radius: 2px;
}

.hud-context {
    position: absolute;
    top: 55%; left: 22%; right: 22%;
    align-items: center;
}

.hud-interaction {
    flex-direction: row;
    align-items: center;
    max-width: 100%;
}
.hud-interaction .hud-copy { flex-shrink: 1; }
.hud-interaction--primary { border-bottom-width: 2px; border-bottom-color: #edbc85; }
.hud-key {
    flex-shrink: 0;
    background-color: #e3c594;
    color: #262820;
    font-size: 20px;
    -unity-font-style: bold;
    margin: 0 12px 0 0;
    padding: 2px 8px;
}

.hud-note { max-width: 100%; margin-top: 8px; -unity-text-align: middle-center; }
.hud-bottom {
    position: absolute;
    left: 32px; right: 32px; bottom: 28px;
    align-items: center;
}
.hud-bottom .hud-note { max-width: 62%; }
.hud-chalkboard { width: 46%; max-width: 560px; align-self: flex-start; margin-top: 8px; }
.hud-high-contrast .hud-objective,
.hud-high-contrast .hud-interaction,
.hud-high-contrast .hud-note,
.high-contrast .hud-objective, .high-contrast .hud-interaction, .high-contrast .hud-note { background-color: #111713; border-color: #eddfb6; }
.scale-large .hud-copy, .scale-large .hud-hint { font-size: 23px; }
.scale-xl .hud-copy, .scale-xl .hud-hint { font-size: 26px; }
.scale-xl .hud-room { font-size: 29px; }
.school-hud .hidden { display: none; }
