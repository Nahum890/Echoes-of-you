/* ============================================================
   GameHUDUI — Fase 4: Mínimo esencial.
   Opacidad base 0.0 (RULE-UI-004). Fade 0.0→0.85 en 0.10s SOLO grabando.
   Colores canon: #FFBF00 (amber), #4FC3E8 (cyan), #B23A3A (red).
   ============================================================ */

@import "EchoesDesignTokens.uss";

/* ===== ROOT ===== */
.root-fullscreen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 100ms;
    transition-timing-function: ease-out;
}

/* HUD visible when recording/playing */
.root-fullscreen.hud-visible {
    opacity: 0.85;
}

/* ===== RECORD PANEL (top-left) ===== */
.hud-record-panel {
    position: absolute;
    left: 32px; top: 32px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 10, 13, 0.92);
    border-width: 1px;
    border-color: var(--color-institutional-teal);
    padding: 8px 16px;
    gap: 12px;
}

.hud-record-dot {
    width: 10px; height: 10px;
    border-radius: 5px;
    background-color: var(--color-wrongness-red);
}

.hud-record-bar-bg {
    width: 140px; height: 6px;
    background-color: var(--color-corridor-navy);
    border-width: 1px;
    border-color: var(--color-institutional-teal);
}

.hud-record-bar-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-fluorescent-sick);
    transition-property: width;
    transition-duration: 100ms;
}

.hud-echo-slots {
    flex-direction: row;
    gap: 4px;
}

.hud-echo-slot {
    width: 6px; height: 6px;
    border-width: 1px;
    border-color: var(--color-institutional-teal);
}

.hud-echo-slot--filled {
    background-color: var(--color-memory-amber);
}

/* ===== HUD BARS (top-right) ===== */
.hud-container {
    position: absolute;
    right: 32px; top: 32px;
    flex-direction: column;
    gap: 8px;
}

.hud-bar-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
}

.hud-bar-label {
    font-size: 9px;
    color: var(--color-faded-mustard);
    width: 60px;
    -unity-text-align: middle-left;
}

.hud-bar-bg {
    width: 120px; height: 6px;
    background-color: var(--color-corridor-navy);
    border-width: 1px;
    border-color: var(--color-institutional-teal);
}

.hud-bar-fill {
    height: 100%;
}

.hud-bar-fill--stability {
    background-color: var(--color-fluorescent-sick);
}

.hud-bar-fill--recall {
    background-color: var(--color-memory-amber);
}

/* ===== OBJECTIVE (top-center) ===== */
.hud-objective-text {
    position: absolute;
    left: 10%; right: 10%; top: 96px;
    font-size: 17px;
    color: var(--color-paper);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

/* ===== TOAST (bottom-center) ===== */
.hud-toast-text {
    position: absolute;
    left: 20%; right: 20%; bottom: 120px;
    font-size: 12px;
    color: var(--color-paper);
    -unity-text-align: middle-center;
    white-space: normal;
    background-color: rgba(10, 10, 13, 0.92);
    border-width: 1px;
    border-color: var(--color-institutional-teal);
    padding: 8px 16px;
}

/* ===== ECHO STATE (above toast) ===== */
.hud-echo-state-label {
    position: absolute;
    left: 20%; right: 20%; bottom: 80px;
    font-size: 12px;
    color: var(--color-echo-cyan);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* ===== KEY PROMPT (center) ===== */
.key-prompt-label {
    position: absolute;
    left: 50%; top: 50%;
    translate: -50% -50%;
    font-size: 24px;
    color: var(--color-memory-amber);
    -unity-text-align: middle-center;
    background-color: rgba(10, 10, 13, 0.92);
    border-width: 2px;
    border-color: var(--color-memory-amber);
    padding: var(--space-md) var(--space-xl);
}

/* ===== CHALKBOARD TUTORIAL (bottom-left) ===== */
.chalkboard-box {
    position: absolute;
    left: 40px; bottom: 40px;
    width: 380px; height: 280px;
    background-color: rgba(58, 74, 56, 0.95);
    border-width: 3px;
    border-color: var(--color-faded-mustard);
    padding: var(--space-lg);
    flex-direction: column;
}

.chalkboard-title {
    font-size: 16px;
    color: var(--color-fluorescent-sick);
    border-bottom-width: 1px;
    border-bottom-color: rgba(220, 230, 217, 0.3);
    padding-bottom: 6px;
    margin-bottom: var(--space-sm);
}

.chalkboard-text {
    font-size: 12px;
    color: var(--color-paper);
    white-space: normal;
    line-height: 16px;
}

/* ===== FOOTER STATUS (bottom-right) ===== */
.footer-status {
    position: absolute;
    right: 32px; bottom: 32px;
    flex-direction: row;
    gap: 16px;
}

.footer-item {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    opacity: 0.35;
}

.footer-item--active {
    opacity: 1;
}

.footer-icon {
    font-size: 12px;
    color: var(--color-fluorescent-sick);
}

.footer-label {
    font-size: 11px;
    color: var(--color-faded-mustard);
}

/* ===== HIDDEN UTILITY ===== */
.hidden { display: none; }
