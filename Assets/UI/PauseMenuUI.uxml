<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements">
    <!-- PauseMenuUI — Notebook 460px, stats + nav 4 botones.
         Escape → Reanudar (focus por defecto).
         Contraste ≥ 4.5:1. Fondos sólidos, sin opacidades bajas. -->

    <ui:VisualElement class="root-fullscreen hidden" name="pause-root">
        <ui:VisualElement class="pause-notebook" name="pause-nav">
            <ui:VisualElement class="pause-notebook__header">
                <ui:Label class="pause-title" text="Capítulo Pausado" />
                <ui:Label class="pause-subtitle" text="recorrido en curso" />
            </ui:VisualElement>

            <ui:VisualElement class="pause-stats" name="pauseStats">
                <ui:Label class="pause-stat" name="lbl-pause-fragment" text="Capítulo: --" />
                <ui:Label class="pause-stat" name="lbl-pause-time" text="Tiempo: 00:00:00" />
                <ui:Label class="pause-stat" name="lbl-pause-echoes" text="Ecos grabados: 0" />
                <ui:Label class="pause-stat" name="lbl-pause-deaths" text="Quiebres (aula): 0 · sesión 0" />
                <ui:Label class="pause-stat" name="lbl-pause-total" text="Cuaderno de Aiden: 0/15 · 0 ecos · 00:00:00" />
            </ui:VisualElement>

            <ui:VisualElement class="pause-actions">
                <ui:Button class="echo-button echo-button--primary pause-btn" name="btn-resume" text="I. Reanudar Capítulo" />
                <ui:Button class="echo-button echo-button--destructive pause-btn" name="btn-reiniciar" text="II. Reiniciar Capítulo" />
                <ui:Button class="echo-button echo-button--primary pause-btn" name="btn-settings" text="III. Ajustes del Cuaderno" />
                <ui:Button class="echo-button echo-button--secondary pause-btn" name="btn-hub" text="IV. Volver al Cuaderno" />
            </ui:VisualElement>

            <ui:Label class="pause-footer" name="lbl-pause-location" text="Aula XXX — Capítulo Y de Aiden" />
        </ui:VisualElement>

        <!-- Settings panel (overlay, hidden by default) -->
        <ui:VisualElement class="pause-settings-panel hidden" name="pause-settings-panel" />
    </ui:VisualElement>
</UXML>