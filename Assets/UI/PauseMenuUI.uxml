<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/EchoesDesignTokens.uss" />
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />
    <Style src="project://database/Assets/UI/PauseMenuUI.uss" />

    <ui:VisualElement class="root-fullscreen hidden" name="pause-root">

        <!-- Background Dim & Scanline Overlay -->
        <ui:VisualElement class="pause-backdrop" picking-mode="Ignore" />
        <ui:VisualElement class="pause-scanline" picking-mode="Ignore" />

        <!-- Left Panel Container (33% Width) -->
        <ui:VisualElement class="pause-left-panel" name="pause-nav">
            
            <!-- Echo Silhouette Ghost Shadow -->
            <ui:VisualElement class="echo-silhouette" picking-mode="Ignore" />

            <!-- Top Section: Emblem & Chapter Info -->
            <ui:VisualElement class="pause-header-block">
                
                <!-- Emblem: Broken O -->
                <ui:VisualElement class="pause-emblem-container" picking-mode="Ignore">
                    <ui:Label class="pause-emblem-text" text="O" />
                    <ui:VisualElement class="pause-emblem-slash" />
                </ui:VisualElement>

                <!-- Chapter Info -->
                <ui:VisualElement class="pause-chapter-info">
                    <ui:Label class="pause-main-title" text="CAPÍTULO PAUSADO" />
                    <ui:Label class="pause-chapter-subtitle" name="lbl-pause-chapter" text="Chapter I: Primer Eco" />
                    <ui:VisualElement class="pause-location-container">
                        <ui:Label class="pause-location-text" name="lbl-pause-location" text="Checkpoint: Pasillo Principal" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Middle Section: Main Menu Buttons -->
            <ui:VisualElement class="pause-options-list">
                
                <!-- 1. Reanudar -->
                <ui:Button class="pause-option-btn pause-option-btn--focused" name="btn-resume" text="REANUDAR" />

                <!-- 2. Reiniciar -->
                <ui:Button class="pause-option-btn" name="btn-reiniciar" text="REINICIAR CAPÍTULO" />

                <!-- 3. Ajustes -->
                <ui:Button class="pause-option-btn" name="btn-settings" text="AJUSTES" />

                <!-- 4. Controles -->
                <ui:Button class="pause-option-btn" name="btn-controles" text="CONTROLES" />

                <!-- 5. Expediente -->
                <ui:Button class="pause-option-btn" name="btn-expediente" text="EXPEDIENTE" />

            </ui:VisualElement>

            <!-- Bottom Section: Volver al menú principal -->
            <ui:VisualElement class="pause-footer-block">
                <ui:Button class="pause-option-btn pause-option-btn--logout" name="btn-hub" text="VOLVER AL MENÚ PRINCIPAL" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Right Side: Residual Archival Stamp -->
        <ui:VisualElement class="pause-right-view" picking-mode="Ignore">
            <ui:Label class="pause-rec-text" text="REC_0392 // A. PIERCE // ERROR_MEMORY_CORRUPTED" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Sub-Panel: Controles (Overlay) -->
        <ui:VisualElement class="pause-subpanel hidden" name="pause-controls-panel">
            <ui:VisualElement class="pause-subpanel-card">
                <ui:VisualElement class="pause-subpanel-header">
                    <ui:Label class="pause-subpanel-tag" text="GUÍA DE REGISTRO // ENTRADA DE COMANDOS" />
                    <ui:Label class="pause-subpanel-title" text="CONTROLES DEL SISTEMA" />
                </ui:VisualElement>

                <ui:VisualElement class="controls-grid">
                    <ui:VisualElement class="control-entry">
                        <ui:VisualElement class="control-keys-box">
                            <ui:Label class="control-key" text="W" />
                            <ui:Label class="control-key" text="A" />
                            <ui:Label class="control-key" text="S" />
                            <ui:Label class="control-key" text="D" />
                        </ui:VisualElement>
                        <ui:Label class="control-desc" text="Moverse por el entorno tridimensional" />
                    </ui:VisualElement>

                    <ui:VisualElement class="control-entry">
                        <ui:VisualElement class="control-keys-box">
                            <ui:Label class="control-key control-key--wide" text="ESPACIO" />
                        </ui:VisualElement>
                        <ui:Label class="control-desc" text="Saltar / Impulsarse sobre plataformas" />
                    </ui:VisualElement>

                    <ui:VisualElement class="control-entry">
                        <ui:VisualElement class="control-keys-box">
                            <ui:Label class="control-key control-key--accent" text="R" />
                        </ui:VisualElement>
                        <ui:Label class="control-desc" text="Mantener: Grabar Eco Temporal (hasta 12s de acciones)" />
                    </ui:VisualElement>

                    <ui:VisualElement class="control-entry">
                        <ui:VisualElement class="control-keys-box">
                            <ui:Label class="control-key" text="F" />
                        </ui:VisualElement>
                        <ui:Label class="control-desc" text="Limpiar / Descartar todos los ecos activos de la sala" />
                    </ui:VisualElement>

                    <ui:VisualElement class="control-entry">
                        <ui:VisualElement class="control-keys-box">
                            <ui:Label class="control-key" text="E" />
                            <ui:Label class="control-key control-key--mouse" text="CLIC" />
                        </ui:VisualElement>
                        <ui:Label class="control-desc" text="Interactuar / Inspeccionar objetos y avanzar diálogos" />
                    </ui:VisualElement>

                    <ui:VisualElement class="control-entry">
                        <ui:VisualElement class="control-keys-box">
                            <ui:Label class="control-key control-key--wide" text="ESCAPE" />
                        </ui:VisualElement>
                        <ui:Label class="control-desc" text="Abrir / Cerrar Menú de Pausa" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button class="pause-subpanel-back-btn" name="btn-close-controls" text="← VOLVER AL MENÚ DE PAUSA" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Sub-Panel: Expediente (Overlay) -->
        <ui:VisualElement class="pause-subpanel hidden" name="pause-expediente-panel">
            <ui:VisualElement class="pause-subpanel-card">
                <ui:VisualElement class="pause-subpanel-header">
                    <ui:Label class="pause-subpanel-tag" text="ARCHIVO DE MEMORIAS // EXPEDIENTE AIDEN" />
                    <ui:Label class="pause-subpanel-title" text="EXPEDIENTE Y FRAGMENTOS" />
                </ui:VisualElement>

                <!-- Psychological Stage Card -->
                <ui:VisualElement class="expediente-stage-box">
                    <ui:Label class="expediente-stage-tag" text="ESTADO PSICOLÓGICO ACTUAL" />
                    <ui:Label class="expediente-stage-name" name="lbl-expediente-stage" text="ETAPA: CONVICCIÓN" />
                    <ui:Label class="expediente-stage-desc" name="lbl-expediente-stage-desc" text="Aiden se resiste a aceptar la alteración de los recuerdos. La memoria aún es una barrera." />
                </ui:VisualElement>

                <!-- Session Stats Grid -->
                <ui:VisualElement class="expediente-stats-grid">
                    <ui:VisualElement class="expediente-stat-item">
                        <ui:Label class="expediente-stat-label" text="TIEMPO TRANSCURRIDO" />
                        <ui:Label class="expediente-stat-value" name="lbl-expediente-time" text="00:00:00" />
                    </ui:VisualElement>

                    <ui:VisualElement class="expediente-stat-item">
                        <ui:Label class="expediente-stat-label" text="ECOS GENERADOS" />
                        <ui:Label class="expediente-stat-value" name="lbl-expediente-echoes" text="0" />
                    </ui:VisualElement>

                    <ui:VisualElement class="expediente-stat-item">
                        <ui:Label class="expediente-stat-label" text="QUIEBRES EN SALA" />
                        <ui:Label class="expediente-stat-value" name="lbl-expediente-deaths" text="0" />
                    </ui:VisualElement>

                    <ui:VisualElement class="expediente-stat-item">
                        <ui:Label class="expediente-stat-label" text="FRAGMENTOS RECUPERADOS" />
                        <ui:Label class="expediente-stat-value" name="lbl-expediente-total" text="0 / 15 ECOS" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button class="pause-subpanel-back-btn" name="btn-close-expediente" text="← VOLVER AL MENÚ DE PAUSA" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Sub-Panel: Ajustes (Host container for SettingsController) -->
        <ui:VisualElement class="pause-settings-panel hidden" name="pause-settings-panel" />

    </ui:VisualElement>
</UXML>
