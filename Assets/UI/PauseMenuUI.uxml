<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />

    <ui:VisualElement name="pause-root" class="root-fullscreen crt-vignette crt-scanlines hidden" style="background-color: rgba(10, 10, 13, 0.65);">
        
        <!-- ==========================================
             MAIN PAUSE BUTTONS (NOTEBOOK LEAF)
             ========================================== -->
        <ui:VisualElement name="pause-nav" class="pause-notebook">
            <ui:VisualElement>
                <ui:Label text="Recuerdo Pausado" class="font-serif-bold pause-title" />
                <ui:Label text="sintonizaciÃ³n inestable en curso" class="font-mono text-body-sm" style="color: #8C847E; -unity-text-align: middle-center; margin-top: 4px; -unity-text-transform: uppercase; font-size: 10px;" />
            </ui:VisualElement>

            <!-- Navigation options -->
            <ui:VisualElement style="flex-direction: column; margin-top: 32px; flex-grow: 1;">
                <ui:Button name="btn-resume" text="> Reanudar Recuerdo" class="pause-btn" />
                <ui:Button name="btn-recalibrate" text="> Reiniciar Recuerdo (Bucle)" class="pause-btn" />
                <ui:Button name="btn-settings" text="> Ajustar Receptor" class="pause-btn" />
                <ui:Button name="btn-hub" text="> Volver al Expediente (Salir)" class="pause-btn" style="color: #B23A3A; margin-top: 32px;" />
            </ui:VisualElement>

            <!-- Back & Void buttons for C# script compatibility (hidden) -->
            <ui:VisualElement style="display: none; height: 0px; width: 0px;">
                <ui:Button name="btn-mainmenu" />
                <ui:Button name="btn-void" />
            </ui:VisualElement>

            <!-- Page footer info -->
            <ui:VisualElement style="border-top-width: 1px; border-top-color: #C0BAB4; padding-top: 12px; align-items: center;">
                <ui:Label text="Aula 104 - Memoria Aiden" class="font-serif" style="font-size: 11px; color: #8A8076; -unity-font-style: italic;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==========================================
             PAUSE SETTINGS PANEL (OSD MONITOR PANEL)
             ========================================== -->
        <ui:VisualElement name="pause-settings-panel" class="hidden" style="position: absolute; left: 48px; top: 48px; right: 48px; bottom: 48px; background-color: #1C2430; border-width: 2px; border-color: #2B4A4A; padding: 48px;">
            <ui:Label text="Ajustes del Receptor" class="font-serif-bold text-headline-xl" style="-unity-text-align: middle-left; margin-bottom: 4px;" />
            <ui:Label text="calibracion de frecuencia en tiempo real" class="font-mono text-label-caps" style="color: #6C788A; margin-bottom: 20px;" />
            <ui:VisualElement class="accent-line" />

            <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                <!-- Left: Audio & Graphics sliders -->
                <ui:ScrollView style="width: 50%; max-height: 380px; padding-right: 24px;">
                    <ui:Label text="AUDIO DE SINTONÃA" class="settings-group-title" />
                    <ui:Slider name="p-sld-master" label="Volumen General" low-value="0" high-value="1" />
                    <ui:Label name="p-lbl-master-val" text="100%" class="font-mono text-body-sm" style="display: none;" />
                    <ui:Slider name="p-sld-music" label="Canal MÃºsica" low-value="0" high-value="1" />
                    <ui:Label name="p-lbl-music-val" text="100%" class="font-mono text-body-sm" style="display: none;" />
                    <ui:Slider name="p-sld-sfx" label="Canal Efectos" low-value="0" high-value="1" />
                    <ui:Label name="p-lbl-sfx-val" text="100%" class="font-mono text-body-sm" style="display: none;" />
                    <ui:Slider name="p-sld-echo-voice" label="Filtro de Eco" low-value="0" high-value="1" />
                    <ui:Label name="p-lbl-echo-voice-val" text="100%" class="font-mono text-body-sm" style="display: none;" />

                    <ui:Label text="MONITOR DE VIDEO" class="settings-group-title" style="margin-top: 16px;" />
                    <ui:DropdownField name="p-ResolutionDropdown" label="ResoluciÃ³n" />
                    <ui:Toggle name="p-FullscreenToggle" label="Pantalla Completa" />
                    <ui:Toggle name="p-VsyncToggle" label="SincronizaciÃ³n Vertical" />
                    <ui:DropdownField name="p-ScaleDropdown" label="Escala Interfaz" style="display: none;" />
                </ui:ScrollView>

                <!-- Right: Controls, Presets & Actions -->
                <ui:VisualElement style="width: 45%; margin-left: 5%; justify-content: space-between; height: 380px;">
                    <ui:ScrollView style="width: 100%; max-height: 280px;">
                        <ui:Label text="CONTROLES DEL EXPEDIENTE" class="settings-group-title" />
                        <ui:Slider name="p-SensitivitySlider" label="Sensibilidad RatÃ³n" low-value="0.1" high-value="4" />
                        <ui:Label name="p-lbl-cam-sens-val" text="1.0" class="font-mono text-body-sm" style="display: none;" />

                        <ui:VisualElement style="display: none;">
                            <ui:Button name="p-btn-sens-low" />
                            <ui:Button name="p-btn-sens-med" />
                            <ui:Button name="p-btn-sens-high" />
                            <ui:Label name="p-lbl-sens-val" />
                        </ui:VisualElement>

                        <ui:Label text="ILUMINACIÃ“N INSTITUCIONAL" class="settings-group-title" style="margin-top: 16px;" />
                        <ui:VisualElement style="flex-direction: row; flex-wrap: wrap;">
                            <ui:Button name="p-btn-light-liminal" text="Liminal" class="btn-classic" style="margin-right: 8px; margin-bottom: 8px; width: 45%;" />
                            <ui:Button name="p-btn-light-bruma" text="Bruma" class="btn-classic" style="margin-right: 8px; margin-bottom: 8px; width: 45%;" />
                            <ui:Button name="p-btn-light-claridad" text="Claridad" class="btn-classic" style="margin-right: 8px; margin-bottom: 8px; width: 45%;" />
                            <ui:Button name="p-btn-light-penumbra" text="Penumbra" class="btn-classic" style="margin-right: 8px; margin-bottom: 8px; width: 45%;" />
                        </ui:VisualElement>

                        <!-- Developer variables dummy mapping to satisfy script links -->
                        <ui:VisualElement style="display: none;">
                            <ui:Slider name="p-sld-fog" /><ui:Label name="p-lbl-fog-val" />
                            <ui:Slider name="p-sld-echo" /><ui:Label name="p-lbl-echo-val" />
                            <ui:Slider name="p-sld-game-fog" /><ui:Label name="p-lbl-game-fog-val" />
                            <ui:Slider name="p-sld-game-sun" /><ui:Label name="p-lbl-game-sun-val" />
                            <ui:Slider name="p-sld-game-lights" /><ui:Label name="p-lbl-game-lights-val" />
                            <ui:Slider name="p-sld-game-ambient" /><ui:Label name="p-lbl-game-ambient-val" />
                        </ui:VisualElement>
                    </ui:ScrollView>

                    <!-- Actions -->
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                        <ui:Button name="p-btn-restore-defaults" text="Por Defecto" class="btn-classic" style="width: 30%;" />
                        <ui:Button name="p-btn-settings-back" text="Cancelar" class="btn-classic" style="width: 30%;" />
                        <ui:Button name="p-btn-settings-apply" text="Aplicar" class="btn-classic btn-classic-accent" style="width: 35%;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>

