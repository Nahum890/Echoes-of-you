<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GlassPanel.uss" />
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />
    <Style src="project://database/Assets/UI/CreditsUI.uss" />

    <ui:VisualElement name="root" class="root-fullscreen credits-root" style="width: 1920px; height: 1080px; position: absolute; left: 0; top: 0;">

        <!-- HEADER FIJO -->
        <ui:VisualElement class="credits-header">
            <ui:Label class="credits-header-title" text="CREDITOS" />
            <ui:Label class="credits-header-subtitle" text="Expediente de Ausencia — Registro de autores" />
        </ui:VisualElement>

        <!-- SCROLL AREA -->
        <ui:VisualElement class="credits-container" name="creditsContainer">
            <ui:ScrollView class="credits-scroll" name="creditsScroll">

                <!-- TITULO DE APERTURA -->
                <ui:VisualElement class="credits-section credits-section--title">
                    <ui:Label class="credits-title-main" text="ECHOES OF YOU" />
                    <ui:VisualElement class="credits-separator" />
                    <ui:Label class="credits-subtitle" text="Un eco que no se puede borrar" />
                </ui:VisualElement>

                <!-- DIRECCION Y DISENO -->
                <ui:VisualElement class="credits-section">
                    <ui:Label class="credits-heading" text="DIRECCIÓN Y DISEÑO" />
                    <ui:Label class="credits-name" text="Nahum Velazquez" />
                    <ui:Label class="credits-text" text="Concepto original, visión creativa y diseño general" />
                </ui:VisualElement>

                <!-- PROGRAMACION -->
                <ui:VisualElement class="credits-section">
                    <ui:Label class="credits-heading" text="PROGRAMACIÓN" />
                    <ui:Label class="credits-name" text="Nahum Velazquez" />
                    <ui:Label class="credits-text" text="Desarrollo del motor de juego, mecánicas de eco y grabación" />
                </ui:VisualElement>

                <!-- NARRATIVA Y ESCRITURA -->
                <ui:VisualElement class="credits-section credits-section--two-text">
                    <ui:Label class="credits-heading" text="NARRATIVA Y ESCRITURA" />
                    <ui:Label class="credits-name" text="Nahum Velazquez" />
                    <ui:Label class="credits-text" text="Historia sin palabras - el eco habla por sí solo" />
                    <ui:Label class="credits-text" text="Diseño de niveles y progresión narrativa" />
                </ui:VisualElement>

                <!-- ARTE -->
                <ui:VisualElement class="credits-section credits-section--two-text">
                    <ui:Label class="credits-heading" text="ARTE Y DIRECCIÓN VISUAL" />
                    <ui:Label class="credits-name" text="Melany Velazquez" />
                    <ui:Label class="credits-text" text="Todo el arte del juego - paleta, texturas, ambientes" />
                    <ui:Label class="credits-text" text="Estética Escuela Liminal / PS1-PS2 / CRT" />
                </ui:VisualElement>

                <!-- DISENO DE MECANICAS -->
                <ui:VisualElement class="credits-section">
                    <ui:Label class="credits-heading" text="DISEÑO DE MECÁNICAS" />
                    <ui:Label class="credits-name" text="Nahum Velazquez" />
                    <ui:Label class="credits-text" text="Mecánica de eco, grabación, colisiones y puzzles" />
                </ui:VisualElement>

                <!-- PRODUCCION Y COORDINACION -->
                <ui:VisualElement class="credits-section">
                    <ui:Label class="credits-heading" text="PRODUCCIÓN Y COORDINACIÓN" />
                    <ui:Label class="credits-name" text="Fania Romero" />
                    <ui:Label class="credits-text" text="Coordinación y asistencia de producción" />
                </ui:VisualElement>

                <!-- DISENO DE INTERFAZ -->
                <ui:VisualElement class="credits-section">
                    <ui:Label class="credits-heading" text="DISEÑO DE INTERFAZ" />
                    <ui:Label class="credits-name" text="Fabiana Torales" />
                    <ui:Label class="credits-text" text="Asistencia de usabilidad y documentación" />
                </ui:VisualElement>

                <!-- AGRADECIMIENTOS -->
                <ui:VisualElement class="credits-section credits-section--thanks">
                    <ui:Label class="credits-heading" text="AGRADECIMIENTOS" />
                    <ui:Label class="credits-name" text="Fuentes: Inter (Rasmus Andersson) - Garamond - Courier" />
                    <ui:Label class="credits-name" text="Motor: Unity 6000.4 - URP 17.4" />
                    <ui:Label class="credits-name" text="Sistema de diseño: Stitch" />
                </ui:VisualElement>

                <!-- CIERRE -->
                <ui:VisualElement class="credits-section credits-section--close">
                    <ui:Label class="credits-heading credits-heading--close" text="Cuaderno cerrado." />
                    <ui:VisualElement class="credits-separator" />
                    <ui:Label class="credits-subtitle" text="Gracias por jugar." />
                </ui:VisualElement>

                <!-- PADDING FINAL -->
                <ui:VisualElement class="credits-end-padding" />

            </ui:ScrollView>
        </ui:VisualElement>

        <!-- EPILOGO (final del bloque N01-N06) -->
        <ui:VisualElement name="epiloguePanel" class="epilogue-panel" style="display: none;">
            <ui:Label class="epilogue-tag" text="EPILOGO // RECUERDO RESTAURADO" />
            <ui:Label name="epilogue-voice" class="epilogue-voice" text="" />
            <ui:Label name="epilogue-narration" class="epilogue-narration" text="" />
            <ui:Button name="epilogue-continue" class="epilogue-continue" text="Continuar" />
        </ui:VisualElement>

        <!-- BOTON VOLVER AL MENU PRINCIPAL -->
        <ui:Button class="credit-back-btn" name="btnBack" text="Volver al Menu Principal" />

    </ui:VisualElement>
</ui:UXML>
