/* ============================================================
   PauseMenuUI — Echoes of You Modern Narrative Pause Menu
   ============================================================ */

/* Self-contained styling */

Label, Button {
    /* default font */
    color: #e4e2dc;
}

/* ===== ROOT ===== */
.root-fullscreen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.hidden {
    display: none !important;
}

/* ===== BACKDROP & SCANLINES ===== */
.pause-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(19, 20, 16, 0.45);
}

.pause-scanline {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.04);
    pointer-events: none;
}

/* ===== LEFT PANEL (33% WIDTH) ===== */
.pause-left-panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 33%;
    min-width: 540px;
    max-width: 640px;
    height: 100%;
    background-color: rgba(19, 20, 16, 0.85);
    border-right-width: 1px;
    border-right-color: #4a463f;
    padding-top: 56px;
    padding-bottom: 32px;
    padding-left: 48px;
    padding-right: 48px;
    flex-direction: column;
    justify-content: space-between;
}

/* ===== ECHO SILHOUETTE GHOST ===== */
.echo-silhouette {
    position: absolute;
    left: 4px;
    top: 2px;
    right: -4px;
    bottom: -2px;
    background-color: rgba(19, 20, 16, 0.35);
    border-right-width: 1px;
    border-right-color: #2a2a26;
    pointer-events: none;
}

/* ===== TOP SECTION: EMBLEM & HEADER ===== */
.pause-header-block {
    margin-bottom: 36px;
}

/* Broken O Emblem */
.pause-emblem-container {
    width: 48px;
    height: 52px;
    position: relative;
    margin-bottom: 24px;
    justify-content: center;
    align-items: center;
}

.pause-emblem-text {
    font-size: 48px;
    color: #fffeff;
    /* default font */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pause-emblem-slash {
    position: absolute;
    top: 45%;
    left: -4px;
    right: -4px;
    height: 2px;
    background-color: #131410;
    rotate: -15deg;
}

/* Chapter Info */
.pause-chapter-info {
    border-bottom-width: 1px;
    border-bottom-color: rgba(74, 70, 63, 0.5);
    padding-bottom: 16px;
}

.pause-main-title {
    font-size: 40px;
    color: #fffeff;
    letter-spacing: 1px;
    margin-bottom: 4px;
    /* default font */
    -unity-font-style: bold;
}

.pause-chapter-subtitle {
    font-size: 15px;
    color: #63d4fa;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
    /* default font */
    -unity-font-style: bold;
}

.pause-location-container {
    flex-direction: row;
    align-items: center;
}

.pause-location-icon {
    font-size: 16px;
    color: #959087;
    margin-right: 6px;
}

.pause-location-text {
    font-size: 15px;
    color: #959087;
}

/* ===== MIDDLE SECTION: BUTTONS LIST ===== */
.pause-options-list {
    flex-grow: 1;
    justify-content: flex-start;
}

.pause-option-btn {
    height: 52px;
    margin-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
    border-width: 1px;
    border-color: #959087;
    border-radius: 4px;
    background-color: rgba(19, 20, 16, 0.75);
    color: #e4e2dc;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition-property: background-color, border-color, color, translate;
    transition-duration: 150ms;
}

.pause-option-btn:hover {
    background-color: rgba(20, 28, 40, 0.85);
    border-color: #63d4fa;
    color: #ffffff;
    translate: 1px 1px;
}

.pause-option-btn--focused {
    border-color: #63d4fa !important;
    background-color: rgba(20, 28, 40, 0.85) !important;
    color: #ffffff !important;
}

.pause-option-btn--logout {
    border-color: #4a463f;
    color: #959087;
}

.pause-option-btn--logout:hover {
    border-color: #93000a;
    background-color: rgba(45, 15, 18, 0.8);
    color: #ffb4ab;
}

/* ===== FOOTER BLOCK ===== */
.pause-footer-block {
    padding-top: 16px;
}

/* ===== RIGHT SIDE ARCHIVAL STAMP ===== */
.pause-right-view {
    position: absolute;
    left: 33%;
    right: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
}

.pause-rec-text {
    position: absolute;
    right: 48px;
    bottom: 36px;
    font-size: 14px;
    color: #959087;
    opacity: 0.6;
    letter-spacing: 1px;
    -unity-font-style: italic;
}

/* ===== SUB-PANELS (CONTROLES, EXPEDIENTE, SETTINGS) ===== */
.pause-subpanel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 14, 0.88);
    justify-content: center;
    align-items: center;
    z-index: 100;
}

.pause-subpanel-card {
    width: 860px;
    max-width: 90%;
    background-color: #131410;
    border-width: 1px;
    border-color: #63d4fa;
    border-radius: 8px;
    padding: 32px 40px;
    flex-direction: column;
}

.pause-subpanel-header {
    border-bottom-width: 1px;
    border-bottom-color: rgba(99, 212, 250, 0.3);
    padding-bottom: 12px;
    margin-bottom: 24px;
}

.pause-subpanel-tag {
    font-size: 13px;
    color: #63d4fa;
    letter-spacing: 1.5px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.pause-subpanel-title {
    font-size: 28px;
    color: #ffffff;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Controls Grid */
.controls-grid {
    flex-direction: column;
    margin-bottom: 24px;
}

.control-entry {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 8px 12px;
    background-color: rgba(20, 24, 30, 0.6);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(74, 70, 63, 0.4);
}

.control-keys-box {
    flex-direction: row;
    width: 220px;
    align-items: center;
}

.control-key {
    background-color: #242933;
    border-width: 1px;
    border-color: #63d4fa;
    border-radius: 4px;
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 4px 10px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.control-key--wide {
    padding-left: 14px;
    padding-right: 14px;
}

.control-key--accent {
    background-color: #0e3746;
    border-color: #63d4fa;
    color: #63d4fa;
}

.control-key--mouse {
    background-color: #2d3340;
    border-color: #bfc7d7;
}

.control-desc {
    font-size: 15px;
    color: #e4e2dc;
    flex-grow: 1;
}

/* Expediente Card Styles */
.expediente-stage-box {
    background-color: rgba(20, 28, 40, 0.7);
    border-width: 1px;
    border-color: #63d4fa;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 20px;
}

.expediente-stage-tag {
    font-size: 12px;
    color: #63d4fa;
    letter-spacing: 1px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.expediente-stage-name {
    font-size: 20px;
    color: #ffffff;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.expediente-stage-desc {
    font-size: 14px;
    color: #bfc7d7;
    -unity-font-style: italic;
}

.expediente-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 24px;
}

.expediente-stat-item {
    width: 48%;
    background-color: rgba(20, 24, 30, 0.6);
    border-width: 1px;
    border-color: #4a463f;
    border-radius: 4px;
    padding: 12px 16px;
    margin-bottom: 12px;
}

.expediente-stat-label {
    font-size: 12px;
    color: #959087;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.expediente-stat-value {
    font-size: 20px;
    color: #63d4fa;
    -unity-font-style: bold;
}

/* Back Button */
.pause-subpanel-back-btn {
    height: 46px;
    background-color: #1a222d;
    border-width: 1px;
    border-color: #63d4fa;
    border-radius: 4px;
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    cursor: pointer;
    transition-property: background-color;
    transition-duration: 150ms;
}

.pause-subpanel-back-btn:hover {
    background-color: #0e3746;
}

/* ===== SETTINGS PANEL HOST ===== */
.pause-settings-panel {
    position: absolute;
    padding: 48px;
    flex-direction: column;
    overflow: hidden;
}
