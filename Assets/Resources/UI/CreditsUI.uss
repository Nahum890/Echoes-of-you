/* ============================================================
   CreditsUI â€” RediseÃ±o Stich (solid, crisp, legible)
   Fondo sÃ³lido, tipografÃ­a cargada, secciones con tarjetas
   ============================================================ */

@import "EchoesDesignTokens.uss";

/* ===== ROOT ===== */
.credits-root {
    background-color: var(--color-glass-bg-strong);
}

/* ===== HEADER FIJO ===== */
.credits-header {
    position: absolute;
    left: 0; top: 0; right: 0;
    height: 100px;
    background-color: #131410;
    border-bottom-width: 2px;
    border-bottom-color: #E8B262;
    flex-direction: row;
    align-items: center;
    padding: 0 48px;
}

.credits-header-title {
    font-size: 36px;
    color: #E8B262;
    /* default font */
    letter-spacing: 2px;
    opacity: 1;
}

.credits-header-subtitle {
    font-size: 16px;
    color: #ccc6bc;
    /* default font */
    letter-spacing: 1px;
    margin-left: 24px;
    opacity: 1;
}

/* ===== SCROLL AREA ===== */
.credits-container {
    position: absolute;
    left: 0; top: 100px; right: 0; bottom: 0;
    background-color: var(--color-glass-bg-strong);
}

.credits-scroll {
    position: absolute;
    left: 20%; right: 20%;
    top: 0; bottom: 0;
    padding: 48px 0;
    background-color: transparent;
}

/* ===== SECCIONES (tarjetas) ===== */
.credits-section {
    background-color: #131410;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #E8B262;
    padding: 28px 32px;
    margin-bottom: 20px;
    align-items: flex-start;
    min-height: 154px;
}

.credits-section--two-text {
    min-height: 186px;
}

.credits-section--thanks {
    min-height: 178px;
}

.credits-section--title {
    background-color: #1b1c18;
    border-left-color: #fffeff;
    border-left-width: 6px;
    padding: 40px 36px;
    margin-bottom: 32px;
    align-items: center;
    min-height: 226px;
}

.credits-section--close {
    background-color: #1b1c18;
    border-left-color: #E8B262;
    border-left-width: 6px;
    padding: 40px 36px;
    margin-bottom: 32px;
    align-items: center;
    min-height: 198px;
}

/* ===== TITULO PRINCIPAL ===== */
.credits-title-main {
    font-size: 52px;
    color: #E8B262;
    /* default font */
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 16px;
    opacity: 1;
    min-height: 62px;
}

.credits-subtitle {
    font-size: 22px;
    color: #e4e2dc;
    /* default font */
    -unity-text-align: middle-center;
    margin-top: 8px;
    letter-spacing: 1px;
    opacity: 1;
    min-height: 26px;
}

/* ===== SEPARADOR ===== */
.credits-separator {
    height: 2px;
    width: 240px;
    background-color: #E8B262;
    margin: 16px 0;
}

/* ===== HEADING DE SECCION ===== */
.credits-heading {
    font-size: 18px;
    color: #E8B262;
    /* default font */
    -unity-text-align: middle-left;
    letter-spacing: 3px;
    margin-bottom: 16px;
    opacity: 1;
    min-height: 22px;
}

.credits-heading--close {
    font-size: 32px;
    color: #E8B262;
    /* default font */
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    letter-spacing: 2px;
    min-height: 38px;
}

/* ===== NOMBRES ===== */
.credits-name {
    font-size: 18px;
    color: #e4e2dc;
    /* default font */
    -unity-text-align: middle-left;
    letter-spacing: 1px;
    margin-bottom: 6px;
    opacity: 1;
    min-height: 22px;
}

/* ===== TEXTO BODY ===== */
.credits-text {
    font-size: 16px;
    color: #ccc6bc;
    /* default font */
    -unity-text-align: middle-left;
    margin-bottom: 12px;
    letter-spacing: 1px;
    opacity: 1;
    min-height: 20px;
}

/* ===== BACK BUTTON â€” SOLID ===== */
.credit-back-btn {
    position: absolute;
    left: 50%;
    bottom: 32px;
    translate: -50% 0;
    min-width: 320px;
    font-size: 18px;
    color: #e4e2dc;
    /* default font */
    background-color: #1b1c18;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #E8B262;
    padding: 18px 36px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    opacity: 1;
    transition-property: color, border-color, background-color, scale;
    transition-duration: 150ms;
    transition-timing-function: linear;
    border-radius: 0;
}

.credit-back-btn:hover {
    color: #fffeff;
    background-color: #2a2a26;
    border-color: #E8B262;
    scale: 1.03 1.03;
}

.credit-back-btn:active {
    color: #E8B262;
    border-color: #E8B262;
    scale: 0.97 0.97;
}

/* ===== PADDING FINAL SCROLL ===== */
.credits-end-padding {
    height: 160px;
}

/* ===== EPILOGO (final del bloque) ===== */
.epilogue-panel {
    position: absolute;
    left: 0; top: 100px; right: 0; bottom: 0;
    background-color: var(--color-glass-bg-strong);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 15%;
}

.epilogue-tag {
    font-size: 16px;
    color: #E8B262;
    /* default font */
    letter-spacing: 4px;
    margin-bottom: 40px;
    -unity-text-align: middle-center;
    opacity: 1;
}

.epilogue-voice {
    font-size: 44px;
    color: #fffeff;
    /* default font */
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 28px;
    white-space: normal;
    opacity: 1;
}

.epilogue-narration {
    font-size: 22px;
    color: #ccc6bc;
    /* default font */
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 64px;
    white-space: normal;
    opacity: 1;
}

.epilogue-continue {
    min-width: 320px;
    font-size: 18px;
    color: #e4e2dc;
    /* default font */
    background-color: #1b1c18;
    border-width: 1px;
    border-color: #4a463f;
    border-left-width: 4px;
    border-left-color: #E8B262;
    padding: 18px 36px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    opacity: 1;
    transition-property: color, border-color, background-color, scale;
    transition-duration: 150ms;
    transition-timing-function: linear;
    border-radius: 0;
}

.epilogue-continue:hover {
    color: #fffeff;
    background-color: #2a2a26;
    border-color: #E8B262;
    scale: 1.03 1.03;
}

.epilogue-continue:active {
    color: #E8B262;
    border-color: #E8B262;
    scale: 0.97 0.97;
}
