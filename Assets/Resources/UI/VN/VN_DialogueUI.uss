/* ============================================================
   VN_DialogueUI — Visual Novel Dialogue Overlay (Narrative Aesthetic)
   ============================================================ */

.vn-dialogue-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: #020408;
    overflow: hidden;
}

.vn-hidden {
    display: none !important;
}

/* ===== BACKGROUND DIM LAYER ===== */
.vn-bg-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(2, 4, 8, 0.5);
}

/* ===== SCANLINES & NOISE OVERLAY ===== */
.vn-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
    opacity: 0.12;
}

.vn-noise-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.08);
    opacity: 0.04;
}

/* ===== CHARACTER CANVAS AREA ===== */
.vn-character-canvas {
    position: relative;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    margin: 24px 8% 8px;
}

.vn-portrait-container {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 46%;
    max-width: 580px;
    align-items: center;
}
.vn-portrait--left { left: 0; }
.vn-portrait--right { right: 0; }

/* ===== CHARACTER SPRITE WITH BORDER/GLOW ===== */
.vn-sprite {
    width: 100%;
    height: 100%;
    max-height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    background-position: bottom center;
    background-repeat: no-repeat;
    opacity: 1;
    border-width: 2px;
    border-color: rgba(99, 212, 250, 0.15);
    border-radius: 8px;
    transition-property: opacity, translate, border-color, border-width;
    transition-duration: 350ms;
}

.vn-sprite--aiden {
    opacity: 0.95;
    border-color: rgba(233, 226, 213, 0.15);
}

.vn-sprite--lyra {
    opacity: 0.90;
    border-color: rgba(99, 212, 250, 0.15);
}

.vn-sprite--dimmed {
    opacity: 0.35;
    border-color: rgba(149, 144, 135, 0.15);
    border-width: 1px;
}

.vn-sprite--active {
    opacity: 1;
    border-width: 2px;
}

/* Glow border for active speaking character */
.vn-sprite--active.vn-sprite--aiden,
.vn-sprite--aiden.vn-sprite--active {
    border-color: rgba(233, 226, 213, 0.75);
    border-width: 2px;
}

.vn-sprite--active.vn-sprite--lyra,
.vn-sprite--lyra.vn-sprite--active {
    border-color: rgba(99, 212, 250, 0.85);
    border-width: 2px;
}

/* ===== NARRATIVE UI SHELL (Bottom Dialogue Panel) ===== */
.vn-dialogue-shell {
    flex-shrink: 0;
    max-height: 48%;
    width: 100%;
}

.vn-name-plate {
    align-self: flex-start;
    margin-left: 8%;
    max-width: 84%;
    flex-shrink: 0;
    background-color: #29372e;
    border-width: 1px;
    border-color: #777963;
    padding: 5px 18px;
}

.vn-character-name {
    font-size: 28px;
    color: #fffeff;
    /* default font */
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.vn-character-name--aiden {
    color: #e9e2d5;
}

.vn-character-name--lyra {
    color: #ebcb90;
}

/* ===== DIALOGUE CONTAINER ===== */
.vn-dialogue-panel {
    position: relative;
    width: 100%;
    min-height: 0;
    flex-shrink: 1;
    background-color: #202b24;
    border-top-width: 1px;
    border-top-color: rgba(149, 144, 135, 0.4);
    padding-left: 8%;
    padding-right: 8%;
    padding-top: 20px;
    padding-bottom: 24px;
    flex-direction: column;
    justify-content: space-between;
}

.vn-panel-noise {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.05;
}

/* ===== DIALOGUE TEXT ===== */
.vn-text-row {
    width: 100%;
    flex-shrink: 1;
    min-height: 0;
}

.vn-dialogue-text {
    font-size: 28px;
    color: #fffeff;
    /* default font */
    white-space: normal;
    -unity-text-align: middle-left;
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.vn-typewriter-cursor {
    font-size: 28px;
    color: #ebcb90;
    /* default font */
    margin-left: 2px;
}

/* ===== CONTROLS ANCHOR ===== */
.vn-controls-anchor {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 10px;
}

.vn-control-btn {
    background-color: transparent;
    border-width: 0;
    padding: 4px 10px;
    font-size: 13px;
    color: #e0d6bd;
    /* default font */
    letter-spacing: 2px;
    transition-property: color, translate;
    transition-duration: 150ms;
}

.vn-control-btn:focus, .vn-control-btn:hover {
    color: #fffeff;
    translate: 0 -2px;
}

.vn-control-btn--skip:hover {
    color: #ebcb90;
}

.vn-advance-prompt {
    font-size: 13px;
    color: #ebcb90;
    /* default font */
    letter-spacing: 2px;
    margin-left: 12px;
}

.vn-character-name { white-space: normal; }

.school-noticeboard {
    align-items: center;
    justify-content: center;
}
.school-noticeboard .vn-character-canvas { display: none; }
.school-noticeboard .vn-dialogue-shell {
    width: 82%;
    max-width: 800px;
    max-height: 88%;
    background-color: #37534d;
    border-width: 6px;
    border-color: #746653;
    padding: 18px;
}
.school-noticeboard .vn-name-plate {
    margin-left: 0;
    max-width: 100%;
    border-width: 0;
    background-color: #293e39;
    padding: 5px 14px;
}
.school-noticeboard .vn-dialogue-panel {
    margin-top: 10px;
    background-color: #ded5ba;
    padding: 22px;
}
.school-noticeboard .vn-dialogue-text { color: #202b28; }
.school-noticeboard .vn-control-btn, .school-noticeboard .vn-advance-prompt { color: #384840; }
.school-noticeboard .vn-panel-noise { display: none; }

.vn-library-memory { background-color: transparent; }
.vn-library-memory .vn-bg-dim { background-color: rgba(4, 9, 12, 0.12); }
.vn-library-memory .vn-noise-overlay, .vn-library-memory .vn-scanlines { display: none; }
.vn-library-memory .vn-character-canvas { margin: 8px 2% 0; }
.vn-library-memory .vn-portrait-container { width: 43%; max-width: none; }
.vn-library-memory .vn-portrait-container .vn-sprite {
    border-width: 0;
    border-radius: 0;
    transition-property: opacity;
}
.vn-library-memory .vn-sprite--dimmed { opacity: 1; -unity-background-image-tint-color: #a7aab1; }
.vn-library-memory .vn-dialogue-shell { align-self: center; width: 88%; max-width: 1100px; }
.vn-library-memory .vn-dialogue-panel { background-color: rgba(21, 32, 33, 0.94); }
.vn-stage-memory .vn-character-canvas {
    position: absolute;
    left: 5%;
    right: 5%;
    bottom: 3%;
    height: 29%;
    margin: 0;
}
.vn-stage-memory .vn-portrait-container { width: 17%; max-width: none; }
.vn-stage-memory .vn-dialogue-shell {
    position: absolute;
    align-self: center;
    bottom: 3%;
    height: 29%;
    width: 57%;
    max-width: none;
}
.vn-stage-memory .vn-dialogue-panel { flex-grow: 1; padding: 8px 5%; }
.vn-stage-memory .vn-name-plate { margin-left: 0; }
.vn-stage-memory .vn-portrait-container .vn-sprite {
    background-size: auto 180%;
    background-position: center top;
    border-width: 2px;
    border-radius: 3px;
    border-color: rgba(203, 195, 174, 0.55);
    background-color: transparent;
}
.vn-stage-memory .vn-portrait-container .vn-sprite--active { border-color: #ddc897; }
