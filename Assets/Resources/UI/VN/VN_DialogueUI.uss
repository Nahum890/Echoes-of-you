/* ============================================================
   VN_DialogueUI — Visual Novel Dialogue Overlay (Narrative Aesthetic)
   ============================================================ */

.vn-dialogue-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    background-color: #020408;
    overflow: hidden;
}

.vn-hidden {
    display: none !important;
}

/* ===== BACKGROUND DIM LAYER ===== */
.vn-bg-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(2, 4, 8, 0.5);
}

/* ===== SCANLINES & NOISE OVERLAY ===== */
.vn-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
    opacity: 0.12;
}

.vn-noise-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.08);
    opacity: 0.04;
}

/* ===== CHARACTER CANVAS AREA ===== */
.vn-character-canvas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.vn-portrait-container {
    position: absolute;
    top: 20px;
    bottom: 220px;
    width: 46%;
    max-width: 580px;
    justify-content: flex-end;
    align-items: center;
    pointer-events: none;
}

.vn-portrait--left {
    left: 5%;
}

.vn-portrait--right {
    right: 5%;
}

/* ===== CHARACTER SPRITE WITH BORDER/GLOW ===== */
.vn-sprite {
    width: 100%;
    height: 100%;
    max-height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    background-position: bottom center;
    background-repeat: no-repeat;
    opacity: 1;
    border-width: 2px;
    border-color: rgba(99, 212, 250, 0.15);
    border-radius: 8px;
    transition-property: opacity, translate, border-color, border-width;
    transition-duration: 350ms;
}

.vn-sprite--aiden {
    opacity: 0.95;
    border-color: rgba(233, 226, 213, 0.15);
}

.vn-sprite--lyra {
    opacity: 0.90;
    border-color: rgba(99, 212, 250, 0.15);
}

.vn-sprite--dimmed {
    opacity: 0.35;
    border-color: rgba(149, 144, 135, 0.15);
    border-width: 1px;
}

.vn-sprite--active {
    opacity: 1;
    border-width: 2px;
}

/* Glow border for active speaking character */
.vn-sprite--active.vn-sprite--aiden,
.vn-sprite--aiden.vn-sprite--active {
    border-color: rgba(233, 226, 213, 0.75);
    border-width: 2px;
}

.vn-sprite--active.vn-sprite--lyra,
.vn-sprite--lyra.vn-sprite--active {
    border-color: rgba(99, 212, 250, 0.85);
    border-width: 2px;
}

/* ===== NARRATIVE UI SHELL (Bottom Dialogue Panel) ===== */
.vn-dialogue-shell {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: auto;
}

/* ===== FLOATING NAME PLATE ===== */
.vn-name-plate {
    position: absolute;
    top: -38px;
    left: 8%;
    background-color: rgba(19, 20, 16, 0.96);
    border-width: 1px;
    border-color: #959087;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 28px;
    padding-right: 28px;
    z-index: 30;
}

.vn-character-name {
    font-size: 28px;
    color: #fffeff;
    /* default font */
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.vn-character-name--aiden {
    color: #e9e2d5;
}

.vn-character-name--lyra {
    color: #63d4fa;
}

/* ===== DIALOGUE CONTAINER ===== */
.vn-dialogue-panel {
    position: relative;
    width: 100%;
    min-height: 220px;
    background-color: rgba(19, 20, 16, 0.92);
    border-top-width: 1px;
    border-top-color: rgba(149, 144, 135, 0.4);
    padding-left: 8%;
    padding-right: 8%;
    padding-top: 36px;
    padding-bottom: 24px;
    flex-direction: column;
    justify-content: space-between;
}

.vn-panel-noise {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.05;
}

/* ===== DIALOGUE TEXT ===== */
.vn-text-row {
    flex-direction: row;
    align-items: flex-start;
    width: 85%;
    min-height: 80px;
}

.vn-dialogue-text {
    font-size: 28px;
    color: #fffeff;
    /* default font */
    line-height: 42px;
    white-space: normal;
    -unity-text-align: middle-left;
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.vn-typewriter-cursor {
    font-size: 28px;
    color: #63d4fa;
    /* default font */
    margin-left: 2px;
}

/* ===== CONTROLS ANCHOR ===== */
.vn-controls-anchor {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
    margin-top: 10px;
}

.vn-control-btn {
    background-color: transparent;
    border-width: 0;
    padding: 4px 10px;
    font-size: 13px;
    color: #959087;
    /* default font */
    letter-spacing: 2px;
    transition-property: color, translate;
    transition-duration: 150ms;
}

.vn-control-btn:hover {
    color: #fffeff;
    translate: 0 -2px;
}

.vn-control-btn--skip:hover {
    color: #63d4fa;
}

.vn-advance-prompt {
    font-size: 13px;
    color: #63d4fa;
    /* default font */
    letter-spacing: 2px;
    margin-left: 12px;
}
