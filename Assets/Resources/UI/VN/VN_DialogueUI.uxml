<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/EchoesTheme.uss" />
    <Style src="project://database/Assets/UI/VN/VN_DialogueUI.uss" />

    <ui:VisualElement name="vn-dialogue-root" class="vn-dialogue-root vn-hidden">

        <!-- Dark Background Dim Layer -->
        <ui:VisualElement name="vn-bg-dim" class="vn-bg-dim" picking-mode="Ignore" />

        <!-- Atmospheric Overlays -->
        <ui:VisualElement name="vn-scanlines" class="vn-scanlines" picking-mode="Ignore" />
        <ui:VisualElement name="vn-noise-overlay" class="vn-noise-overlay" picking-mode="Ignore" />

        <!-- Character Canvas Area -->
        <ui:VisualElement name="vn-character-canvas" class="vn-character-canvas" picking-mode="Ignore">
            <!-- Left Portrait: Aiden -->
            <ui:VisualElement name="vn-portrait-left-container" class="vn-portrait-container vn-portrait--left" picking-mode="Ignore">
                <ui:VisualElement name="sprite-left" class="vn-sprite vn-sprite--aiden" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Right Portrait: Lyra -->
            <ui:VisualElement name="vn-portrait-right-container" class="vn-portrait-container vn-portrait--right" picking-mode="Ignore">
                <ui:VisualElement name="sprite-right" class="vn-sprite vn-sprite--lyra" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Center Portrait (fallback) -->
            <ui:VisualElement name="sprite-center" class="vn-sprite vn-sprite--center" style="display: none;" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Narrative UI Shell (Bottom Dialogue Panel) -->
        <ui:VisualElement name="vn-dialogue-shell" class="vn-dialogue-shell">

            <!-- Floating Name Plate Overlay -->
            <ui:VisualElement name="vn-name-plate" class="vn-name-plate">
                <ui:Label name="character-name" class="vn-character-name" text="Lyra" />
                <ui:Label name="line-counter" class="vn-line-counter" text="" style="display: none;" />
            </ui:VisualElement>

            <!-- Dialogue Container -->
            <ui:VisualElement name="dialogue-panel" class="vn-dialogue-panel">
                <!-- Inner noise texture -->
                <ui:VisualElement class="vn-panel-noise" picking-mode="Ignore" />

                <!-- Dialogue Text Row -->
                <ui:VisualElement class="vn-text-row">
                    <ui:Label name="dialogue-text" class="vn-dialogue-text" text="" />
                    <ui:Label name="typewriter-cursor" class="vn-typewriter-cursor" text="_" />
                </ui:VisualElement>

                <!-- Controls Anchor (Bottom Right) -->
                <ui:VisualElement class="vn-controls-anchor">
                    <ui:Button name="btn-backlog" text="LOG" class="vn-control-btn" />
                    <ui:Button name="btn-auto" text="AUTO" class="vn-control-btn" />
                    <ui:Button name="btn-skip" text="SKIP" class="vn-control-btn vn-control-btn--skip" />
                    <ui:Label name="advance-prompt" text="[E] CONTINUAR" class="vn-advance-prompt" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
