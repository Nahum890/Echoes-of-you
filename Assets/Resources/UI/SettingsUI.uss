/* ============================================================
   SettingsUI — STITCH CALIBRACIÓN
   Basado en: stitch_echoes_of_you_ui_system/settings_calibraciòn/code.html
   ============================================================ */

/* Self-contained styling */

Label, Button, DropdownField, Toggle {
    /* default font */
    color: #e4e2dc;
}

/* ===== ROOT ===== */
.settings-stitch-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #131410;
    overflow: hidden;
    flex-direction: column;
}

.settings-bg-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #131410;
    opacity: 0.85;
}

/* ===== MAIN INTERFACE ===== */
.settings-main {
    position: absolute;
    left: 64px;
    top: 64px;
    right: 64px;
    bottom: 64px;
    flex-direction: row;
    background-color: rgba(19, 20, 16, 0.65);
    border-width: 1px;
    border-color: rgba(149, 144, 135, 0.5);
    overflow: hidden;
}

/* ============================================================
   LEFT SIDEBAR (1/3)
   ============================================================ */

.settings-sidebar {
    width: 33%;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: rgba(149, 144, 135, 0.5);
    padding: 64px 32px 64px 32px;
    flex-direction: column;
}

.settings-sidebar-header {
    margin-bottom: 40px;
}

.settings-title-container {
    position: relative;
}

.settings-logo-title {
    font-size: 38px;
    color: #ffffff !important;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

.settings-logo-shadow {
    position: absolute;
    left: 2px;
    top: 2px;
    font-size: 38px;
    color: #63d4fa;
    opacity: 0.25;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

.settings-logo-subtitle {
    font-size: 13px;
    color: #959087 !important;
    margin-top: 6px;
    letter-spacing: 1px;
}

.settings-sidebar-divider {
    height: 1px;
    background-color: rgba(149, 144, 135, 0.4);
    margin-top: 20px;
}

/* ===== TABS ===== */
.settings-tabs {
    flex-grow: 1;
    flex-direction: column;
    gap: 8px;
}

.settings-tab {
    background-color: transparent;
    border-width: 0px;
    padding: 12px 16px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: #959087;
    letter-spacing: 2px;
    border-left-width: 4px;
    border-left-color: transparent;
    transition-property: color, border-left-color, translate;
    transition-duration: 200ms;
    transition-timing-function: linear;
    opacity: 0.8;
}

.settings-tab:hover {
    opacity: 1;
    color: #ffffff;
    translate: 2px 0px;
}

.settings-tab--active {
    opacity: 1;
    color: #ffffff !important;
    background-color: rgba(20, 28, 40, 0.75) !important;
    border-left-width: 4px !important;
    border-left-color: #63d4fa !important;
}

/* ===== SIDEBAR FOOTER ===== */
.settings-sidebar-footer {
    margin-top: auto;
    padding-top: 24px;
    border-top-width: 1px;
    border-top-color: rgba(149, 144, 135, 0.5);
}

.settings-close-btn {
    background-color: transparent;
    border-width: 0px;
    padding: 8px 0px;
    font-size: 15px;
    -unity-font-style: bold;
    color: #959087;
    -unity-text-align: middle-left;
    letter-spacing: 1px;
    cursor: pointer;
    transition: color 200ms;
}

.settings-close-btn:hover {
    color: #ffb4ab;
}

/* ============================================================
   RIGHT CONTENT (2/3)
   ============================================================ */

.settings-right {
    width: 67%;
    padding: 48px 48px 48px 48px;
    flex-direction: column;
    overflow: hidden;
}

/* ===== PANEL ===== */
.settings-panel {
    flex-grow: 1;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
}

.settings-panel.hidden {
    display: none;
}

/* ===== PANEL HEADER ===== */
.settings-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom-width: 1px;
    border-bottom-color: rgba(149, 144, 135, 0.5);
    padding-bottom: 12px;
    margin-bottom: 8px;
}

.settings-panel-header-title {
    font-size: 30px;
    color: #ffffff;
    -unity-font-style: bold;
}

.settings-panel-header-rec {
    font-size: 16px;
    color: #ffb4ab;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ===== SETTING ITEM ===== */
.settings-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(149, 144, 135, 0.15);
}

.settings-item--slider {
    flex-direction: column;
    align-items: flex-start;
}

.settings-item-info {
    flex-direction: column;
}

.settings-item-label {
    font-size: 18px;
    color: #e4e2dc;
    -unity-font-style: bold;
}

.settings-item-hint {
    font-size: 13px;
    color: #959087;
    margin-top: 2px;
}

.settings-item-control {
    margin-left: 16px;
}

/* ===== DROPDOWN ===== */
.settings-dropdown {
    min-width: 200px;
    font-size: 15px;
    color: #ffffff;
    background-color: #1f201c;
    border-width: 1px;
    border-color: #63d4fa;
    padding: 6px 14px;
}

/* ===== TOGGLE ===== */
.settings-toggle {
    margin-left: 16px;
}

/* ===== SLIDER ===== */
.settings-slider {
    width: 100%;
    margin-top: 8px;
}

.settings-slider-value {
    font-size: 15px;
    color: #63d4fa;
    -unity-font-style: bold;
    margin-top: 2px;
    text-align: right;
}

/* ===== DELETE BUTTON ===== */
.settings-delete-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #93000a;
    padding: 8px 16px;
    font-size: 14px;
    color: #ffb4ab;
    cursor: pointer;
    transition: all 150ms linear;
}

.settings-delete-btn:hover {
    background-color: rgba(147, 0, 10, 0.25);
    border-color: #ffb4ab;
}

/* ===== ACTION BAR ===== */
.settings-actions {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: auto;
    padding-top: 20px;
    border-top-width: 1px;
    border-top-color: rgba(149, 144, 135, 0.4);
    gap: 16px;
}

.settings-action-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #959087;
    border-radius: 4px;
    padding: 12px 28px;
    font-size: 15px;
    color: #e4e2dc;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    cursor: pointer;
    transition: all 150ms linear;
}

.settings-action-btn:hover {
    background-color: rgba(232, 225, 212, 0.1);
    color: #ffffff;
}

.settings-action-btn--primary {
    color: #63d4fa;
    border-color: #63d4fa;
    background-color: rgba(20, 28, 40, 0.7);
}

.settings-action-btn--primary:hover {
    background-color: rgba(99, 212, 250, 0.2);
    color: #ffffff;
}