/* ============================================================
   MainMenuUI — STITCH AESTHETIC (Archivo de Memoria)
   Alto contraste, alta opacidad, perfectamente legible
   ============================================================ */

@import "EchoesDesignTokens.uss";
@import "Components/EchoButton.uss";
@import "Components/EchoPanel.uss";
@import "Components/EchoCard.uss";
@import "Components/EchoTabs.uss";

/* ============================================================
   ROOT — Pantalla completa, fondo oscuro sólido
   ============================================================ */

.menu-stitch-root {
    background-color: transparent;
    overflow: hidden;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

/* ===== IMAGEN DE FONDO (transparente para ver el mundo 3D) ===== */
.menu-bg-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: none;
    opacity: 0;
}

/* ===== OVERLAY OSCURO (sutil, no bloquea el 3D) ===== */
.menu-bg-gradient {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
}

/* ===== SCANLINES (muy sutil) ===== */
.menu-scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.03;
    background-color: transparent;
}

/* ===== NOISE (muy sutil) ===== */
.menu-noise {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.01;
    background-color: transparent;
}

/* ============================================================
   MAIN CONTENT — contenedor principal (fila: sidebar + panels)
   ============================================================ */

.main-menu-content {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: row;
}

/* FORCE-VISIBLE: override the generic .hidden rule that MainMenuController
   applies to main-content at startup. Without this the entire menu is display:none. */
.main-menu-content.hidden {
    display: flex !important;
}

/* ============================================================
   LEFT SIDEBAR — 420px, fondo oscuro sólido con alta opacidad
   ============================================================ */

/* ============================================================
   LEFT SIDEBAR — Layout asimétrico alineado a la izquierda
   ============================================================ */

.menu-sidebar {
    width: 520px;
    flex-shrink: 0;
    background-color: transparent;
    border-right-width: 1px;
    border-right-color: rgba(74, 70, 63, 0.25);
    padding-top: 56px;
    padding-bottom: 48px;
    padding-left: 64px;
    padding-right: 32px;
    flex-direction: column;
    justify-content: space-between;
}

/* ===== LOGO AREA (Official Logo Image + Subtitle) ===== */
.menu-logo-area {
    margin-bottom: 24px;
    align-items: flex-start;
    background-color: transparent;
}

.menu-logo-image {
    width: 410px;
    height: 135px;
    background-image: url('project://database/Assets/UI/logo.png');
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 4px;
}

.menu-logo-subtitle {
    font-size: 13px;
    color: #959087;
    /* default font */
    letter-spacing: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(149, 144, 135, 0.35);
    padding-bottom: 4px;
    margin-top: 2px;
    align-self: flex-start;
}

/* ============================================================
    NAVEGACIÓN — Asymmetrical Left-Aligned with Guide Line
    ============================================================ */

.menu-nav-container {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    position: relative;
    margin-top: 12px;
    margin-bottom: 12px;
}

.menu-nav-guide-line {
    position: absolute;
    left: -16px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background-color: rgba(149, 144, 135, 0.25);
}

.nav-item-block {
    position: relative;
    margin-bottom: 12px;
}

.nav-item-block--exit {
    margin-top: 20px;
}

.menu-active-dot {
    position: absolute;
    left: -19px;
    top: 20px;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: #63d4fa;
}

.nav-btn-row {
    flex-direction: row;
    align-items: center;
    width: 380px;
    height: 48px;
}

.menu-nav-btn {
    background-color: transparent;
    border-width: 0;
    border-left-width: 0;
    padding: 0;
    margin: 0;
    height: 48px;
    width: 340px;
    font-size: 32px;
    color: #959087;
    /* default font */
    -unity-text-align: middle-left;
    letter-spacing: 0;
    scale: 1.0 1.0;
    translate: 0 0;
    overflow: visible;
    position: relative;
    justify-content: center;
    transition-property: color, translate;
    transition-duration: 150ms;
}

.menu-nav-btn > .unity-text-element {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    font-size: 32px;
}

.menu-nav-btn:hover,
.menu-nav-btn:focus {
    background-color: transparent;
    border-width: 0;
    border-left-width: 0;
    border-color: transparent;
    color: #fffeff;
    /* default font */
    translate: 4px 0;
    scale: 1.0 1.0;
}

.menu-nav-btn--continue {
    font-size: 36px;
    color: #fffeff;
    /* default font */
}

.menu-nav-btn--exit {
    color: rgba(255, 180, 171, 0.85);
}

.menu-nav-btn--exit:hover {
    color: #ffdad6;
}

/* Ghost layer styling inside button */
.menu-nav-btn > .nav-item-ghost {
    position: absolute;
    left: -3px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    -unity-text-align: middle-left;
    font-size: 32px;
    color: rgba(99, 212, 250, 0);
    /* default font */
    pointer-events: none;
    letter-spacing: 0;
    padding: 0;
    margin: 0;
    transition-property: color;
    transition-duration: 150ms;
}

.menu-nav-btn > .nav-item-ghost--visible {
    color: rgba(99, 212, 250, 0.45);
}

.menu-nav-btn--continue > .nav-item-ghost {
    font-size: 36px;
}

.menu-nav-btn--exit > .nav-item-ghost--visible {
    color: rgba(255, 180, 171, 0.35);
}

/* Focus pip inside button */
.menu-nav-btn > .nav-item-focus-pip {
    position: absolute;
    left: -14px;
    top: 0;
    bottom: 0;
    width: 10px;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgba(99, 212, 250, 0);
    pointer-events: none;
    transition-property: color;
    transition-duration: 150ms;
}

.menu-nav-btn > .nav-item-focus-pip--visible {
    color: #63d4fa;
}

.menu-nav-arrow {
    font-size: 22px;
    color: #63d4fa;
    opacity: 0;
    /* default font */
    margin-left: 12px;
    transition-property: opacity, translate;
    transition-duration: 250ms;
    translate: -8px 0;
}

.nav-btn-row:hover .menu-nav-arrow {
    opacity: 1;
    translate: 0 0;
}

/* ===== PROGRESS UNDER CONTINUAR ===== */
.menu-ctn-progress {
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 10px;
    border-left-width: 1px;
    border-left-color: rgba(149, 144, 135, 0.35);
    background-color: transparent;
}

.menu-ctn-progress-row {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.menu-save-icon {
    font-size: 10px;
    color: #959087;
}

.menu-ctn-progress-label {
    font-size: 13px;
    color: #959087;
    /* default font */
}

.menu-ctn-progress-value {
    font-size: 16px;
    color: #e8e1d4;
    /* default font */
    margin-top: 2px;
}

.menu-ctn-progress-integrity {
    font-size: 12px;
    color: #B23A3A;
    /* default font */
    margin-top: 2px;
}

/* ============================================================
    SIDEBAR FOOTER
    ============================================================ */

.menu-sidebar-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: auto;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: rgba(74, 70, 63, 0.3);
    background-color: transparent;
}

.menu-footer-ver {
    font-size: 13px;
    color: #959087;
    opacity: 0.65;
    /* default font */
}

.menu-footer-copy {
    font-size: 11px;
    color: #959087;
    opacity: 0.65;
    /* default font */
    -unity-text-align: middle-right;
    line-height: 14px;
}

/* ============================================================
   PANELS CONTAINER (right side)
   ============================================================ */

.menu-panels-container {
    position: relative;
    flex-grow: 1;
    height: 100%;
    padding-top: 48px;
    padding-bottom: 48px;
    padding-left: 32px;
    padding-right: 48px;
    overflow: hidden;
    background-color: transparent;
}

/* ===== PANEL INDIVIDUAL ===== */
/* Base: oculto por defecto */
.menu-panels-container > .menu-panel {
    position: absolute;
    left: 24px;
    top: 36px;
    right: 36px;
    bottom: 36px;
    background-color: rgba(19, 20, 16, 0.95);
    border-width: 1px;
    border-color: rgba(149, 144, 135, 0.3);
    border-left-width: 3px;
    border-left-color: #63d4fa;
    padding: 32px 36px;
    flex-direction: column;
    opacity: 0;
    display: none;
    pointer-events: none;
    transition-property: opacity;
    transition-duration: 200ms;
}

/* Visible cuando tiene preview-panel--visible */
.menu-panels-container > .menu-panel.preview-panel--visible {
    opacity: 1;
    display: flex;
    pointer-events: auto;
}

.menu-panels-container > .menu-panel--centered {
    justify-content: center;
    align-items: center;
}

.menu-panels-container > .menu-panel .menu-panel-title {
    font-size: 32px;
    color: #E8B262;
    /* default font */
    -unity-text-align: middle-left;
    margin-bottom: 4px;
}

.menu-panels-container > .menu-panel .menu-panel-subtitle {
    font-size: 14px;
    color: #ccc6bc;
    /* default font */
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.menu-panels-container > .menu-panel .menu-panel-separator {
    height: 2px;
    width: 240px;
    background-color: #E8B262;
    opacity: 0.6;
    margin-bottom: 24px;
}

/* ===== SECTION LABEL ===== */
.menu-section-label {
    font-size: 14px;
    color: #E8B262;
    /* default font */
    letter-spacing: 2px;
    margin-bottom: 12px;
}

/* ===== TERMINAL LOG ===== */
.menu-terminal-box {
    background-color: rgba(10, 11, 8, 0.5);
    border-width: 1px;
    border-color: rgba(232, 178, 98, 0.2);
    padding: 16px;
    margin-bottom: 24px;
}

.menu-terminal-line {
    font-size: 15px;
    color: #e4e2dc;
    /* default font */
    margin-bottom: 6px;
}

/* ===== CHIPS (stats) ===== */
.menu-chips-row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px;
}

.menu-chip {
    min-width: 90px;
    padding: 12px 16px;
    background-color: rgba(14, 15, 11, 0.4);
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
    align-items: center;
}

.menu-chip-label {
    font-size: 12px;
    color: #959087;
    /* default font */
    letter-spacing: 1px;
}

.menu-chip-value {
    font-size: 18px;
    color: #C9D4B0;
    /* default font */
    margin-top: 4px;
}

/* ===== POLAROID ===== */
.menu-polaroid {
    width: 100%;
    padding: 8px;
    background-color: rgba(232, 225, 212, 0.3);
    align-items: center;
}

.menu-polaroid-photo {
    width: 90%;
    height: 120px;
    background-color: rgba(53, 53, 48, 0.4);
    border-width: 1px;
    border-color: rgba(149, 144, 135, 0.3);
    margin-bottom: 8px;
}

.menu-polaroid-caption {
    font-size: 14px;
    color: #353530;
    /* default font */
    -unity-text-align: middle-center;
}

/* ===== MEMORY METER ===== */
.menu-memory-meter {
    margin-top: 16px;
    width: 100%;
    padding: 12px;
    background-color: rgba(8, 10, 16, 0.4);
    border-width: 1px;
    border-color: rgba(201, 212, 176, 0.2);
}

.menu-meter-title {
    font-size: 12px;
    color: #959087;
    /* default font */
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.menu-meter-value {
    font-size: 18px;
    color: #C9D4B0;
    /* default font */
}

.menu-meter-bar-bg {
    width: 120px;
    height: 6px;
    background-color: rgba(28, 36, 48, 0.3);
    border-width: 1px;
    border-color: rgba(43, 74, 74, 0.3);
}

.menu-meter-bar-fill {
    height: 100%;
    background-color: #C9D4B0;
    width: 0%;
}

/* ============================================================
   ÍNDICE DE RECUERDOS (Level Select Cards & Aesthetic)
   ============================================================ */

.menu-panel-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.menu-header-tag {
    font-size: 13px;
    color: #959087;
    /* default font */
    letter-spacing: 2px;
    margin-bottom: 2px;
}

.menu-panel-close-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(149, 144, 135, 0.4);
    padding: 6px 16px;
    font-size: 12px;
    color: #fffeff;
    /* default font */
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-property: border-color, background-color, color;
    transition-duration: 150ms;
}

.menu-panel-close-btn:hover {
    border-color: #ffb4ab;
    color: #ffb4ab;
    background-color: rgba(147, 0, 10, 0.2);
}

.lvl-chapter-list {
    flex-grow: 1;
    min-height: 0;
    padding-right: 12px;
}

.lvl-chapter {
    flex-direction: column;
    border-bottom-width: 1px;
    border-bottom-color: rgba(149, 144, 135, 0.25);
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    margin-bottom: 4px;
    border-left-width: 3px;
    border-left-color: transparent;
    transition-property: background-color, border-left-color;
    transition-duration: 150ms;
}

.lvl-chapter:hover {
    background-color: rgba(57, 57, 53, 0.35);
    border-left-color: #63d4fa;
}

.lvl-chapter--active {
    background-color: rgba(68, 76, 89, 0.22);
    border-left-color: #63d4fa;
}

.lvl-chapter--completed {
    border-left-color: #959087;
}

.lvl-chapter--locked {
    opacity: 0.45;
}

.lvl-chapter-main {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    width: 100%;
}

.lvl-chapter-thumb {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(149, 144, 135, 0.4);
    background-color: #1b1c18;
    justify-content: center;
    align-items: center;
}

.lvl-chapter-thumb--active {
    border-color: #63d4fa;
    background-color: rgba(99, 212, 250, 0.12);
}

.lvl-chapter-thumb--locked {
    border-color: rgba(147, 0, 10, 0.45);
    background-color: #181212;
}

.lvl-chapter-thumb-num {
    font-size: 18px;
    color: #fffeff;
    /* default font */
    -unity-text-align: middle-center;
}

.lvl-chapter-thumb-err {
    font-size: 13px;
    color: #ffb4ab;
    /* default font */
    -unity-text-align: middle-center;
}

.lvl-chapter-meta {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.lvl-chapter-meta-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.lvl-chapter-rec {
    font-size: 12px;
    color: #959087;
    /* default font */
    letter-spacing: 1.5px;
}

.lvl-chapter-rec--locked {
    color: rgba(255, 180, 171, 0.85);
}

.lvl-meta-bullet {
    font-size: 11px;
    color: #4a463f;
    margin-left: 8px;
    margin-right: 8px;
}

.lvl-meta-bullet--locked {
    color: rgba(147, 0, 10, 0.6);
    margin-left: 8px;
    margin-right: 8px;
}

.lvl-chapter-location {
    font-size: 12px;
    color: #959087;
    /* default font */
    letter-spacing: 1.2px;
}

.lvl-chapter-location--locked {
    color: rgba(255, 180, 171, 0.7);
}

.lvl-chapter-progress {
    font-size: 12px;
    color: #63d4fa;
    /* default font */
    margin-left: auto;
    letter-spacing: 1.5px;
    padding-right: 12px;
}

.lvl-chapter-progress--dim {
    color: #959087;
}

.lvl-chapter-progress--locked {
    color: rgba(255, 180, 171, 0.7);
}

.lvl-chapter-btn-title {
    background-color: transparent;
    border-width: 0px;
    padding: 0;
    margin: 0;
    font-size: 24px;
    color: #fffeff;
    /* default font */
    -unity-text-align: middle-left;
    transition-property: color, translate;
    transition-duration: 150ms;
}

.lvl-chapter-btn-title:hover {
    color: #63d4fa;
    translate: 4px 0;
}

.lvl-chapter-btn-title--locked {
    color: rgba(228, 226, 220, 0.35);
    text-decoration: line-through;
}

/* ===== TELEMETRY BAR ===== */
.lvl-telemetry-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: rgba(149, 144, 135, 0.25);
    padding-top: 12px;
    margin-top: 8px;
    flex-shrink: 0;
}

.lvl-telemetry-chip {
    font-size: 12px;
    color: #959087;
    /* default font */
    letter-spacing: 1px;
}

.lvl-reset-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(147, 0, 10, 0.4);
    padding: 4px 12px;
    font-size: 11px;
    color: #ffb4ab;
    /* default font */
    letter-spacing: 1px;
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}

.lvl-reset-btn:hover {
    background-color: rgba(147, 0, 10, 0.3);
    border-color: #ffb4ab;
}

/* ============================================================
   ACTION BUTTONS
   ============================================================ */

.menu-action-btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #959087;
    padding: 12px 24px;
    font-size: 16px;
    /* default font */
    color: #e4e2dc;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    transition-property: color, border-color, background-color;
    transition-duration: 150ms;
    transition-timing-function: linear;
    margin-bottom: 8px;
}

.menu-action-btn:hover {
    border-color: #fffeff;
    color: #fffeff;
    background-color: rgba(57, 57, 53, 0.4);
}

.menu-action-btn--primary {
    border-color: #E8B262;
    color: #E8B262;
}

.menu-action-btn--primary:hover {
    background-color: rgba(232, 178, 98, 0.2);
    color: #fffeff;
}

.menu-action-btn--danger {
    border-color: #B23A3A;
    color: #ffb4ab;
}

.menu-action-btn--danger:hover {
    background-color: rgba(178, 58, 58, 0.3);
    border-color: #ffb4ab;
    color: #fffeff;
}

/* ============================================================
   SETTINGS PANEL ELEMENTS
   ============================================================ */

.menu-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.menu-slider-value {
    font-size: 14px;
    color: #E8B262;
    /* default font */
    width: 48px;
    -unity-text-align: middle-center;
    margin-left: 12px;
}

.menu-light-presets {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.menu-light-btn {
    width: 45%;
    background-color: transparent;
    border-width: 1px;
    border-color: #4a463f;
    padding: 10px;
    font-size: 13px;
    color: #ccc6bc;
    /* default font */
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.menu-light-btn:hover {
    border-color: #fffeff;
    color: #fffeff;
    background-color: rgba(57, 57, 53, 0.3);
}

.menu-settings-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 16px;
}

/* ============================================================
   RESET PROGRESS OVERLAY
   ============================================================ */

.menu-reset-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 10, 13, 0.92);
    justify-content: center;
    align-items: center;
}

.menu-reset-dialog {
    background-color: #1b1c18;
    border-width: 2px;
    border-color: #B23A3A;
    padding: 32px;
    width: 400px;
}

.menu-reset-dialog-title {
    font-size: 24px;
    color: #B23A3A;
    /* default font */
    margin-bottom: 12px;
}

.menu-reset-dialog-text {
    font-size: 16px;
    color: #e4e2dc;
    /* default font */
    margin-bottom: 24px;
}